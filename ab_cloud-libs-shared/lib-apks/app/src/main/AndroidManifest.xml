<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately empty of components. Each flavour's library module contributes
     its own services/providers through the manifest merger; this wrapper only
     supplies the package identity the module is installed under. A library APK
     has no launcher icon by design - it is bound by the constellation apps, not
     opened by the user. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:label="Cloud Library"
        android:hasCode="true" />

</manifest>
