<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No permissions. This app opens no socket and binds no service: the
         env pushes envelopes IN through the provider below, and the provider
         checks the caller's uid itself. -->
    <queries>
        <package android:name="com.termux.nix" />
        <package android:name="cld.termux.nix" />
        <package android:name="com.termux" />
        <package android:name="cld.termux" />
    </queries>
    <application>
        <provider
            android:name="com.diegonmarcos.superapp.watchdog.BridgeProvider"
            android:authorities="com.diegonmarcos.watchdog.bridge"
            android:exported="true" />
    </application>
</manifest>
