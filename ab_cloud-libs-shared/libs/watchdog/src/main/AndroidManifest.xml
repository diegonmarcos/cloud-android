<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No permissions. This app opens no socket and binds no service: the
         env pushes envelopes IN with explicit broadcasts to the receiver
         below, which checks the sender's uid itself. -->
    <queries>
        <package android:name="com.termux.nix" />
        <package android:name="cld.termux.nix" />
        <package android:name="com.termux" />
        <package android:name="cld.termux" />
    </queries>
    <application>
        <receiver
            android:name="com.diegonmarcos.superapp.watchdog.BridgeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.diegonmarcos.watchdog.WANTS" />
                <action android:name="com.diegonmarcos.watchdog.PUSH" />
                <action android:name="com.diegonmarcos.watchdog.LOG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
