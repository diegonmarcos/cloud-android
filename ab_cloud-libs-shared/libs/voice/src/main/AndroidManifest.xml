<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Offline voice dictation records the mic and (once) downloads a model. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- An InputMethodService cannot request runtime permissions, so the
             VOICE key bounces through this transparent activity to obtain
             RECORD_AUDIO, then finishes. -->
        <activity
            android:name=".VoicePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
