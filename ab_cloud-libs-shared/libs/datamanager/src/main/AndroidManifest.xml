<?xml version="1.0" encoding="utf-8"?>
<!-- libs:datamanager — pure data providers, no components. Re-declares the
     usage-access permission the providers depend on so the module is
     self-contained; manifest-merged with the app's identical declaration. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

</manifest>
