<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Draw the edge handles over other apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Centauri star inner ring: kill background processes of non-foreground
         apps (CentaurusStar.recentsAction "close_all" / "kill_bg"). Normal-level
         permission, no runtime prompt — the module-local declaration was
         missing, so the manifest merger only had the app's own copy to lean on. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application>
        <!-- Hosts BOTH the edge-handle overlay AND the global-action dispatch.
             Being system-bound it needs no foreground service / notification.
             User enables it in Settings > Accessibility. -->
        <service
            android:name=".OneHandAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/onehand_accessibility" />
        </service>
    </application>
</manifest>
