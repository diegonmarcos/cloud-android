<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Declared HERE, not per app: every consumer of libs:analytics posts to
         analytics.diegonmarcos.com, so every one of them needs INTERNET or its
         events fail silently. Manifest merge gives it to all of them and a new
         consumer cannot forget. Same reasoning as libs:updater's permissions. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Runs before Application.onCreate(), so consumers get analytics with
             no per-app wiring. ${applicationId} keeps the authority unique —
             a shared authority is an install-time conflict between our apps. -->
        <provider
            android:name="com.diegonmarcos.superapp.analytics.AnalyticsInitProvider"
            android:authorities="${applicationId}.analyticsinit"
            android:exported="false"
            android:initOrder="100" />
    </application>
</manifest>
