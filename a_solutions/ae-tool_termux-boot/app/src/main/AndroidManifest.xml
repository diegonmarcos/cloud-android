<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NO android:sharedUserId. Termux:Boot declares sharedUserId="com.termux"
         so it runs as the SAME uid as the Termux app, which is how it reads the
         0700 boot-script directory and reaches TermuxService (exported=false).
         Android only grants a shared uid to apps signed with the SAME
         certificate, and Nix-on-Droid ships signed by F-Droid. We do not have
         that key, so this app can never join com.termux.nix's uid.
         Everything below is the consequence of that one fact. -->

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Declared by the host app as protectionLevel="dangerous" (NOT signature),
         which is the only reason a foreign-signed app can hold it at all. -->
    <uses-permission android:name="${NOD_PACKAGE_NAME}.permission.RUN_COMMAND" />

    <!-- Android 11+ package visibility: without this we cannot even see, let
         alone start, a service in another package. -->
    <queries>
        <package android:name="${NOD_PACKAGE_NAME}" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        tools:ignore="GoogleAppIndexingWarning">

        <activity
            android:name=".BootActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported=false is correct even though the system delivers
             BOOT_COMPLETED: that broadcast is exempt from the export rule. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
