{
  "name": "fs-redirect-native",
  "description": "Native libc inline hooks (Dobby/Frida-Gum). Rewrites /data/data/<pkg>/ paths to workspace-owned storage so guest-app databases live under the user's control.",
  "category": "eng",
  "type": "native",
  "pillar": "fs-redirector",
  "tech": {
    "language": "cpp",
    "hook_lib": "Dobby",
    "fallback_hook_lib": "Frida-Gum",
    "ndk": "r27",
    "abis": ["arm64-v8a", "x86_64"]
  },
  "depends_on": [],
  "build": {
    "gradle_task": ":native:externalNativeBuildRelease",
    "cmake": "CMakeLists.txt",
    "output": "build/intermediates/cxx/Release/**/lib/**/libfsredirect.so"
  },
  "deploy": { "device": null, "method": "artifact" },
  "hooks": [
    "open",  "openat", "openat2",
    "fopen", "fopen64",
    "stat",  "fstatat", "lstat",
    "access", "faccessat",
    "mkdir", "mkdirat",
    "unlink", "rename",
    "opendir", "readdir"
  ],
  "path_rewrite": {
    "match":  "/data/data/%pkg%",
    "target": "/sdcard/Workspace/data/%pkg%"
  },
  "references": [
    "https://github.com/jmpews/Dobby",
    "https://github.com/frida/frida-gum"
  ]
}
