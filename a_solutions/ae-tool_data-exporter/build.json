{
  "name": "data-exporter",
  "description": "Direct-export UI — single-click copy of guest-app /data/data/<pkg>/databases/*.db and files/*.json out of the workspace to /sdcard/Export/.",
  "category": "tool",
  "type": "library",
  "tech": {
    "language": "kotlin",
    "ui": "Compose bottom-sheet",
    "formats": ["sqlite", "sqlcipher", "json", "protobuf", "zip"]
  },
  "depends_on": ["fs-redirect-native"],
  "build": {
    "gradle_task": ":library:assembleRelease",
    "output": "build/outputs/aar/data-exporter-release.aar"
  },
  "deploy": { "device": null, "method": "artifact" }
}
