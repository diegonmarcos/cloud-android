<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CalDAV and ICS fetching happen here now, so INTERNET follows the
         engine rather than being required of every app that shows a calendar. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <!-- Guarded by the constellation's signature-level permission: only
             APKs signed with the Cloud key can bind it. -->
        <service
            android:name="com.diegonmarcos.superapp.cal.CalBackendService"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />
    </application>
</manifest>
