From 2d3260296df66f6eb37e852a1a4221314333d955 Mon Sep 17 00:00:00 2001
From: Diego <me@diegonmarcos.com>
Date: Sat, 4 Jul 2026 10:55:36 +0300
Subject: [PATCH] fix: write keystore to app/ dir (Gradle resolves storeFile
 relative to app/build.gradle)

---
 .github/workflows/android.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/android.yml b/.github/workflows/android.yml
index 106ee697a5..300895680d 100644
--- a/.github/workflows/android.yml
+++ b/.github/workflows/android.yml
@@ -34,7 +34,7 @@ jobs:
 
     - name: Decode secrets
       run: |
-        echo "${{ secrets.KEYSTORE }}" | base64 -d > Android.keystore
+        echo "${{ secrets.KEYSTORE }}" | base64 -d > app/Android.keystore
         echo "${{ secrets.KEYSTORE_PROPERTIES }}" > keystore.properties
         echo "${{ secrets.LOCAL_PROPERTIES }}" > local.properties
     - name: Grant execute permission for gradlew
