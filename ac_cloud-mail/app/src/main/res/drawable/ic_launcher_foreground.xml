<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground (108dp viewport; inner 72dp safe area). Unified
     Cloud icon family: bold white app glyph, dominant + centred, with the
     shared translucent "cloud" tick top-right. Same structure and same tick
     path as aa_cloud-superapp, so Cloud Mail sits in the family rather than
     carrying FairEmail's own mark.

     Glyph is the Material "mail" path already vendored in this app
     (drawable/baseline_mail_24.xml), scaled 24 -> 108 space: 2.6x, translated
     to clear the tick. Reused rather than hand-drawn so the outline is exact. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- Brand glyph: envelope (108-space) -->
    <group android:scaleX="2.6" android:scaleY="2.6"
        android:translateX="18.8" android:translateY="26.8">
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M20,4L4,4c-1.1,0 -2,0.9 -2,2v12c0,1.1 0.9,2 2,2h16c1.1,0 2,-0.9 2,-2L22,6c0,-1.1 -0.9,-2 -2,-2zM20,6l-8,4.99L4,6h16zM20,18L4,18L4,8l8,5 8,-5v10z" />
    </group>
    <!-- Shared cloud tick (family mark), top-right, slightly translucent -->
    <group android:scaleX="0.62" android:scaleY="0.62" android:translateX="68.6" android:translateY="20.6">
        <path android:fillColor="#F2FFFFFF" android:pathData="M19.35,10.04C18.67,6.59 15.64,4 12,4 9.11,4 6.6,5.64 5.35,8.04 2.34,8.36 0,10.91 0,14c0,3.31 2.69,6 6,6h13c2.76,0 5,-2.24 5,-5 0,-2.64 -2.05,-4.78 -4.65,-4.96z" />
