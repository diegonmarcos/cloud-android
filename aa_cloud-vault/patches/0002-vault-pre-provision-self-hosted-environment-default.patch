From 46b358b2b6fadae8703356f25c03b931c7c23817 Mon Sep 17 00:00:00 2001
From: cloud-comms-engine <engine@diegonmarcos.com>
Date: Tue, 11 Aug 2026 09:59:03 +0000
Subject: [PATCH 2/3] pre-provision self-hosted vault.diegonmarcos.com as the
 default environment

EnvironmentUrlDataJson?.toEnvironmentUrlsOrDefault() fell back to
Environment.Prod.Us (Bitwarden's hosted cloud) when no environment was
persisted yet (first run). Cloud Vault has no relationship with Bitwarden's
cloud service, so first run must default to our own self-hosted Vaultwarden
instance instead.
---
 .../repository/util/EnvironmentUrlDataJsonExtensions.kt     | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/data/src/main/kotlin/com/bitwarden/data/repository/util/EnvironmentUrlDataJsonExtensions.kt b/data/src/main/kotlin/com/bitwarden/data/repository/util/EnvironmentUrlDataJsonExtensions.kt
index 14aa211..6681546 100644
--- a/data/src/main/kotlin/com/bitwarden/data/repository/util/EnvironmentUrlDataJsonExtensions.kt
+++ b/data/src/main/kotlin/com/bitwarden/data/repository/util/EnvironmentUrlDataJsonExtensions.kt
@@ -22,7 +22,9 @@ fun EnvironmentUrlDataJson.toEnvironmentUrls(): Environment =
 
 /**
  * Converts a nullable [EnvironmentUrlDataJson] to an [Environment], where `null` values default to
- * the US environment.
+ * Cloud Vault's self-hosted Vaultwarden instance (was: the US environment).
  */
 fun EnvironmentUrlDataJson?.toEnvironmentUrlsOrDefault(): Environment =
-    this?.toEnvironmentUrls() ?: Environment.Prod.Us
+    this?.toEnvironmentUrls() ?: Environment.SelfHosted(
+        environmentUrlData = EnvironmentUrlDataJson(base = "https://vault.diegonmarcos.com"),
+    )
