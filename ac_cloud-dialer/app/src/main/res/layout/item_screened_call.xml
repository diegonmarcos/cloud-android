<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_screened_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="@dimen/normal_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/normal_margin"
    android:paddingBottom="@dimen/medium_margin">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/item_screened_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/bigger_text_size"
        tools:text="+1 900 555 0100" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/item_screened_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/item_screened_number"
        android:alpha="0.6"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size"
        tools:text="4 July, 04:37 PM • Known spam · premium-rate" />

</RelativeLayout>
