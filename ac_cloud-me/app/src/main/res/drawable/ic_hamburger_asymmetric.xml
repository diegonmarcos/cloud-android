<?xml version="1.0" encoding="utf-8"?>
<!-- Asymmetric hamburger — three horizontal dashes of decreasing
     width (Brave-style minimal "menu" glyph). Replaces the default
     drawer-toggle arrow drawable for the activity toolbar. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/textColorPrimary">
    <!-- Top dash — SHORT (smallest). -->
    <path android:fillColor="#000000"
        android:pathData="M9,6 H15 V8.5 H9 Z" />
    <!-- Middle dash — LONG (largest). -->
    <path android:fillColor="#000000"
        android:pathData="M3,10.75 H21 V13.25 H3 Z" />
    <!-- Bottom dash — MEDIUM. -->
    <path android:fillColor="#000000"
        android:pathData="M6,15.5 H18 V18 H6 Z" />
</vector>
