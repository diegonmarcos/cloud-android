<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Forced DARK (not DayNight): the section surfaces are drawn in code
         against @color/me_bg, and libs:health paints its
         own #0B0414 Compose ground. A system light-mode switch would recolour
         the chrome and leave the content dark, so the app commits to one. -->
    <style name="Theme.CloudMe" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/me_primary</item>
        <item name="colorOnPrimary">@color/me_on_primary</item>
        <item name="colorSurface">@color/me_surface</item>
        <item name="colorOnSurface">@color/me_text</item>
        <item name="android:colorBackground">@color/me_bg</item>

        <item name="android:statusBarColor" tools:targetApi="lollipop">@color/me_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@color/me_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
