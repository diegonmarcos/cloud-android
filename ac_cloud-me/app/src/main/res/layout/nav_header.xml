<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer header. Name and email come from BuildConfig (build.json::
     ui.profile_default) and are filled in by MainActivity, so the header is
     not a second place the profile is written down. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/me_surface_high"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="36dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/header_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/me_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/header_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/me_text_dim"
        android:textSize="13sp" />
</LinearLayout>
