<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Calendar — Agenda reads CalDAV events + todos through libs:cal. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Self-update from GHCR. UPDATE_PACKAGES_WITHOUT_USER_ACTION is THE
         permission that makes USER_ACTION_NOT_REQUIRED actually silent on
         Android 12+ (API 31); without it every update opens a dialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <queries>
        <!-- Package visibility. The first entry is this app (the installer
             compares digests when self-updating); the rest are the
             constellation members ui.external_apps links out to — without
             them getLaunchIntentForPackage returns null and every extapp:
             tile silently does nothing on Android 11+. -->
        <package android:name="com.diegonmarcos.cloudme" />
        <package android:name="com.diegonmarcos.cloudwallet" />
        <package android:name="com.diegonmarcos.cloudvault" />
        <package android:name="com.diegonmarcos.cloudide" />
        <package android:name="com.diegonmarcos.cloudcalendar" />
        <package android:name="com.diegonmarcos.cloudmediacenter" />
        <package android:name="com.diegonmarcos.cloudnav" />
        <package android:name="com.diegonmarcos.superapp" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudMe"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CloudMe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.diegonmarcos.superapp.updater.PackageInstallerReceiver"
            android:exported="false" />
    </application>
</manifest>
