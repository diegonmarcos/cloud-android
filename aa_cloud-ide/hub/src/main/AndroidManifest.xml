<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for the in-app updater (GHCR OCI HTTP API). The hub itself
         does no sync; the forks own all file/server traffic. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- In-app updater: install the hub APK via PackageInstaller (user prompt)
         + post download/result notifications.
         UPDATE_PACKAGES_WITHOUT_USER_ACTION is THE permission that makes
         USER_ACTION_NOT_REQUIRED (silent self-update) legal on Android 12+ —
         without it the OS silently downgrades every install to a prompt, so
         the updater's silent mode could never engage for this hub. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.CloudIde"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Configs (Update + About). About = full SuperApp-architecture page
             (AboutActivity). Update = UpdateOverlay DialogFragment. -->
        <activity android:name=".ConfigsActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />

        <!-- In-app updater + bundled-app PackageInstaller status callback. -->
        <receiver
            android:name=".update.PackageInstallerReceiver"
            android:exported="false" />

    </application>
</manifest>
