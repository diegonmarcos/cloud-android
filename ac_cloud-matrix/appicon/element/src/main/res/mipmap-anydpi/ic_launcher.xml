<?xml version="1.0" encoding="utf-8"?>
<!--
  Full launcher icon for API 24-25, which predate adaptive icons and so need a
  single self-contained drawable (background baked in). API 26+ never sees
  this file: mipmap-anydpi-v26/ic_launcher.xml wins there and composes the
  background + foreground + monochrome layers itself.

  minSdk for the FOSS/fdroid build is 24 (plugins/.../Versions.kt
  MIN_SDK_FOSS), which is why this fallback has to exist at all. It is a
  vector rather than the per-density .webp set it replaces because Element's
  raster artwork is trademarked and cannot be reused, and there is no way to
  author replacement rasters here.

  Original artwork — see NOTICE.md.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- rounded-square ground, matching the release ic_launcher_background tone -->
    <path
        android:fillColor="#0B1020"
        android:pathData="M22,4 L86,4 A18,18 0 0 1 104,22 L104,86 A18,18 0 0 1 86,104 L22,104 A18,18 0 0 1 4,86 L4,22 A18,18 0 0 1 22,4 Z" />

    <path
        android:pathData="M54,34 L36,70 M54,34 L72,70 M36,70 L72,70"
        android:strokeColor="#8AB4F8"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,34 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,70 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M72,70 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0" />
</vector>
