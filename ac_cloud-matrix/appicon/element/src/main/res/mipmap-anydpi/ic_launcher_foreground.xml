<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud Matrix launcher mark — ORIGINAL artwork, not derived from Element.

  Three nodes joined into a triangle: a mesh, for a federated Matrix client.
  Deliberately unlike upstream's mark, because "Element" and the Element logo
  are trademarks of Element Creations Ltd. / New Vector Ltd. and are not
  licensed by the AGPL. See ac_cloud-matrix/NOTICE.md.

  A vector in mipmap-anydpi/ rather than a drawable/: appicon's IconPreview.kt
  resolves R.mipmap.ic_launcher_foreground, so moving the resource out of
  mipmap would stop that module compiling. anydpi (no version qualifier)
  covers API 21+, and mipmap-anydpi-v26/ic_launcher.xml keeps pointing here
  unchanged for the adaptive icon.

  Content sits inside the inner 72x72 of the 108x108 viewport, so the adaptive
  mask cannot clip it whatever shape the launcher applies.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- links -->
    <path
        android:pathData="M54,32 L34,72 M54,32 L74,72 M34,72 L74,72"
        android:strokeColor="#8AB4F8"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- nodes -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,32 m-8.5,0 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,72 m-8.5,0 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M74,72 m-8.5,0 a8.5,8.5 0 1,0 17,0 a8.5,8.5 0 1,0 -17,0" />
</vector>
