<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for JMAP / CloudData fetch / GHCR in-app updater. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Read-only Wi-Fi state for the About page: SSID/BSSID need both
         this AND ACCESS_FINE_LOCATION (Android 10+ scoped Wi-Fi info);
         link speed / frequency / RSSI come from the same surface. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Surface area for Config → About → Permissions. Each row shows
         GRANTED / DENIED state at runtime; the user grants/revokes via
         system settings (Notifications has an in-app button that fires
         the standard request flow on API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Long-press → Uninstall, via PackageInstaller.uninstall (shows the
         system confirm dialog). Normal permission, auto-granted on API 26+. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Silent self-update: the fleet updater installs new APKs without a
         prompt (USER_ACTION_NOT_REQUIRED) once the user grants "Install unknown
         apps" (Configs/About → Permissions → Auto-update). Falls back to a
         prompt when the grant is absent. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- THE permission that makes USER_ACTION_NOT_REQUIRED actually silent on
         Android 12+ (API 31). Without it the platform IGNORES the no-user-action
         flag and forces the confirm dialog every time — the "Android warnings"
         seen on auto-update. Normal permission, auto-granted at install. Silent
         still requires this app to be the installer-of-record of the target
         (it becomes so the first time it installs/updates that app). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Floating Top Nav Bar overlay (FloatingNavService). SYSTEM_ALERT_WINDOW
         ("Display over other apps") is a Special-access perm — NOT runtime-
         grantable; the user toggles it in Settings → Special access → Display
         over other apps (the Configs → About → Permissions page surfaces a row
         + a "Set Display-over-apps" deep-link button). The overlay runs in a
         foreground service so Android keeps it alive while the user roams other
         apps; FOREGROUND_SERVICE_SPECIAL_USE is the API-34 type for a launcher-
         companion overlay that doesn't fit camera/location/etc. categories. -->
    <!-- DND toggle from the notification "Do Not Disturb" action. The user
         additionally grants Notification-policy access in Settings; this
         declares the app is allowed to change the interruption filter. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- WRITE_SETTINGS — Configs → Launcher → Others → Screen brightness sets
         device-wide Settings.System.SCREEN_BRIGHTNESS. signature|appop perm:
         declaring it lists the app in Settings → Special access → Modify system
         settings; the slider routes the user there via ACTION_MANAGE_WRITE_SETTINGS
         when not yet granted. tools:ignore suppresses the protected-perm lint
         (same pattern as DUMP / PACKAGE_USAGE_STATS). -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ACCESS_BACKGROUND_LOCATION + FOREGROUND_SERVICE +
         FOREGROUND_SERVICE_LOCATION + WAKE_LOCK + the
         LocationTrackerService declaration live in
         libs/maps/src/main/AndroidManifest.xml. Manifest-merger folds
         them into the final APK manifest at assembly time; app/ stays
         free of Maps-specific entries. -->

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- PACKAGE_USAGE_STATS is a "signature|appop" permission: regular
         apps can't be auto-granted by the runtime-permission dialog, but
         declaring it is what makes the app *appear in* Settings → Apps
         → Special access → Usage access (otherwise the picker filters
         us out, regardless of Play-Store vs. sideload). Once it's there
         the user toggles it on, and UsageStatsManager.queryUsageStats
         starts returning real data for the Battery & Usage screen.
         tools:ignore suppresses the lint warning about declaring a
         protected permission — that's exactly what we want here. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- MANAGE_EXTERNAL_STORAGE (API 30+, "All files access") is a
         Special Access permission, NOT a runtime perm — declaring it
         here is what makes the app *appear in* Settings → Special
         access → All files access (otherwise the picker filters us
         out, regardless of how many intents we fire). The user grants
         via the "Grant Files Access" button which jumps to
         ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION. Self-signed APK
         (no Play distribution), so the Play-Store policy gate on this
         permission does not apply; tools:ignore suppresses the lint
         warning for the same reason as PACKAGE_USAGE_STATS above. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- DUMP — signature|privileged perm required to invoke `dumpsys`
         from a regular app. We use `dumpsys battery` to read the
         negotiated max charger current/voltage (BatteryChargerSpec)
         since BatteryManager doesn't expose charger input wattage via
         the public API. Auto-granted to platform-signed apps; for our
         debuggable APK the user grants it once via
             adb shell pm grant com.diegonmarcos.superapp android.permission.DUMP
         tools:ignore suppresses the lint warning about declaring a
         protected permission, same pattern as PACKAGE_USAGE_STATS /
         MANAGE_EXTERNAL_STORAGE above. -->
    <uses-permission android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- QUERY_ALL_PACKAGES is the launcher's app-discovery permission.
         Self-signed APK (no Play distribution) so the usual Play Store
         policy gate on this permission does not apply; declaring it
         here grants LauncherApps + PackageManager full visibility over
         every installed launchable activity — the SuperApp needs that
         to act as a Home / Launcher replacement and render the app
         drawer for the Cloud Minimalist Black theme. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Superapp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="false"
        android:directBootAware="false"
        tools:replace="android:name,android:label,android:icon,android:roundIcon,android:allowBackup,android:defaultToDeviceProtectedStorage,android:directBootAware">
        <!-- libs:keyboard (vendored HeliBoard) ships its own <application> with
             conflicting attributes; the SuperApp is the host, so its values win
             via tools:replace:
               • name/label/icon/roundIcon/allowBackup — SuperApp branding +
                 backup policy (HeliBoard sets allowBackup=true; we keep false).
                 If the keyboard misbehaves, HeliBoard's App.onCreate init must
                 be ported into .App (see libs/keyboard/README.md "App-class init").
               • defaultToDeviceProtectedStorage / directBootAware — HeliBoard
                 sets these true for direct-boot typing. Adopting them app-wide
                 would move the SuperApp's default storage to device-protected
                 and BREAK EncryptedSharedPreferences (credential-keystore). We
                 force false; the keyboard still works post-unlock. -->
        <!-- WorkManager on-demand initialization. The vendored HeliBoard merge
             drops androidx.startup's auto-init, leaving WorkManager
             uninitialized (every getInstance() throws). We complete the
             official on-demand setup: remove the default WorkManagerInitializer
             here and provide config via App : Configuration.Provider, so the
             first getInstance() lazily initializes it. Keep both halves in sync. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <!-- FileProvider that backs the keyboard Sticker/GIF panel (libs:media).
             Picked GIFs/stickers are cached under cacheDir/keyboard_media and
             served back as content:// URIs to the target app via
             InputConnection.commitContent (GRANT_READ). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mediaprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/media_file_paths" />
        </provider>

        <!-- Bundled sticker packs (libs:media BundledStickerProvider).
             Authority ends with .stickercontentprovider so StickerRepo
             auto-discovers it alongside any installed WhatsApp sticker apps. -->
        <provider
            android:name="com.diegonmarcos.superapp.media.BundledStickerProvider"
            android:authorities="${applicationId}.stickercontentprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Quick-action handler for the persistent "Cloud SA - KDE" notification. -->
        <receiver
            android:name=".notificationcenter.KdeQuickActionReceiver"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="false"
            android:stateNotNeeded="true">
            <!-- Standard app-drawer entry. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- HOME intent-filter — flips the SuperApp into the
                 Android Home Screen replacement candidate list. Once
                 the user picks it as default, all Home button / home
                 gesture presses route here. launchMode=singleTask +
                 empty taskAffinity match the AOSP Launcher3 task
                 semantics so back / recents behave as expected. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Launcher icon long-press shortcuts -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Health Connect privacy-policy / rationale activity.
                 Without these intent-filters the Health Connect app
                 (or system module on API 34+) will NOT list the
                 Cloud SuperApp in its "App permissions" screen — the
                 user has no way to grant any HC perm.

                 androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE
                 is the legacy filter (Android 13 and earlier, HC as
                 a separate Play-Store app). VIEW_PERMISSION_USAGE +
                 category HEALTH_PERMISSIONS is the Android 14+
                 filter (HC is a system module, perms are standard
                 runtime perms). Both required — manifest-merger
                 leaves a single Activity entry hosting both. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

        <!-- ════════════ libs:keyboard (HeliBoard) manifest reconciliation ════════════
             The vendored HeliBoard manifest (libs/keyboard/src/main/AndroidManifest.xml,
             a verbatim upstream mirror) makes its SettingsActivity the LAUNCHER entry
             and SpellCheckerSettingsActivity a MAIN entry. The SuperApp is the launcher,
             so we strip those intent-filters at merge time via tools:node="remove".
             The activities themselves remain (reachable from the system IME settings
             "gear" and the SuperApp's keyboard entry point) — only their launcher hooks
             are removed, so the keyboard adds NO second/third launcher icon.
             See libs/keyboard/README.md. -->
        <activity
            android:name="helium314.keyboard.settings.SettingsActivity"
            tools:node="merge">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="helium314.keyboard.latin.spellcheck.SpellCheckerSettingsActivity"
            tools:node="merge">
            <intent-filter tools:node="remove">
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- PowerStateReceiver moved to :libs:battery (manifest-merged). -->

        <!-- LockScreenAdminReceiver — Device Admin bind target needed for
             DevicePolicyManager.lockNow() (used by the home-screen
             double-tap-to-lock gesture). Single-policy scope (force-lock
             only) declared in res/xml/device_admin_policy.xml so the
             system activation dialog lists exactly one capability — no
             wipe / reset warnings. BIND_DEVICE_ADMIN is signature-level;
             the receiver MUST require it to be a valid admin target. -->
        <receiver
            android:name=".system.LockScreenAdminReceiver"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policy" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- LockScreenAccessibilityService — hosts the AccessibilityService.
             GLOBAL_ACTION_LOCK_SCREEN call (API 28+). Preferred path for
             the home double-tap-to-lock gesture because it preserves Smart
             Lock (Trusted Device / Trusted Place) + biometric unlock,
             unlike DevicePolicyManager.lockNow which trips the strong-auth
             bit and forces a PIN entry after the next wake. BIND_ACCESSIBILITY_SERVICE
             is signature-level; the service MUST require it to be a valid
             accessibility target. Config (zero events observed, no UI
             scraping, no gestures) lives in
             res/xml/lock_screen_accessibility_service.xml. -->
        <service
            android:name=".system.LockScreenAccessibilityService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_screen_accessibility_service" />
        </service>

        <!-- NotificationListenerService — surfaces every phone-system
             notification in the Infos/Admin "Phone Notifications" panel.
             Permission BIND_NOTIFICATION_LISTENER_SERVICE is signature-
             level, so declaring it is necessary but not sufficient: the
             user must additionally toggle our app ON in
             Settings → Special access → Notification access. The panel
             surfaces a CTA button that opens that screen directly. -->
        <service
            android:name=".notificationcenter.PhoneNotificationListenerService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- FloatingNavService — the cross-app Floating Top Nav Bar overlay.
             Foreground service (START_STICKY) so it survives while the user is
             in other apps; type=specialUse because a launcher-companion overlay
             doesn't map to the predefined FGS categories. Not exported — only
             our own MainActivity / Permissions page start it, gated by
             Settings.canDrawOverlays + build.json::ui.floating_nav.enabled. -->
        <service
            android:name=".floatingnav.FloatingNavService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating cross-app navigation bar overlay for the Cloud SuperApp launcher" />
        </service>

        <!-- Invisible trampoline for notification action buttons — performs
             the action + finishes, which closes the notification shade. -->
        <activity
            android:name=".floatingnav.NavActionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true" />

        <!-- ScreensaverService — full-black cover overlay (Black-Screen-style;
             keeps apps playing underneath, no lock). Started from the
             floating-nav Screensaver action; same overlay + FGS perms. -->
        <service
            android:name=".floatingnav.ScreensaverService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Full-screen black screensaver overlay for the Cloud SuperApp launcher" />
        </service>

        <!-- KdeStatusService — pins the persistent "Cloud SA - KDE" status
             notification via startForeground (parity with FloatingNavService's
             "Cloud SA - Quick Actions"). type=specialUse: a KDE-Connect
             connection/pairing status badge doesn't map to a predefined FGS
             category. Not exported — only App.onCreate / KdeQuickActionReceiver
             start it. -->
        <service
            android:name=".notificationcenter.KdeStatusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent KDE Connect connection + pairing status notification for the Cloud SuperApp" />
        </service>

        <!-- Shizuku provider — required by the Shizuku client lib so the
             app can talk to the Shizuku server (binder + permission).
             Backs the exact per-app energy attribution (ShizukuEnergy +
             ShizukuUserService running dumpsys batterystats in shell
             context). No-op when Shizuku isn't installed/running. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
