<?xml version="1.0" encoding="utf-8"?>
<!-- Activity-level toolbar menu. The whole toolbar surface ALSO acts as a
     search trigger — tapping any blank area opens the search sheet
     (wiring in MainActivity.onCreate). The icons here are visual
     affordances for the same action + the hierarchical Back. The old
     Apps/Admin mode toggle moved to the drawer-header identity row. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Search action moved INTO the Home Apps page (AppDrawerSheet).
         The global activity toolbar no longer carries a search icon
         — toolbar is hamburger | island | back only. -->

    <item android:id="@+id/action_back"
          android:title="@string/action_back"
          android:icon="@drawable/ic_back"
          app:showAsAction="ifRoom" />

    <!-- Wallet shortcut — shown ONLY on the Home screen (mirror of
         action_back which hides on Home). Tap navigates to the Wallet
         section page (page:wallet/cards). The Virtual Business Card
         screen is now reachable from inside the Wallet by tapping the
         vCard at the top of the deck. Visibility toggled in
         MainActivity.onPrepareOptionsMenu. -->
    <item android:id="@+id/action_wallet"
          android:title="@string/action_wallet"
          android:icon="@drawable/ic_wallet"
          app:showAsAction="ifRoom" />
</menu>
