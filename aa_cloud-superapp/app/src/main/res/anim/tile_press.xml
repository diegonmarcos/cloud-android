<?xml version="1.0" encoding="utf-8"?>
<!-- Quick scale-down + bounce-back on tile tap. Gives the grid its
     tactile "press" feel without needing motion-layout / animator. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator">

    <scale
        android:fromXScale="1.0"
        android:toXScale="0.92"
        android:fromYScale="1.0"
        android:toYScale="0.92"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="80" />

    <scale
        android:fromXScale="0.92"
        android:toXScale="1.0"
        android:fromYScale="0.92"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:startOffset="80"
        android:duration="160" />
</set>
