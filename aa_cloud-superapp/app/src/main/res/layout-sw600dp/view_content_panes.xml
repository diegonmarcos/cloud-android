<?xml version="1.0" encoding="utf-8"?>
<!-- Tablet content host (smallest width ≥ 600dp): master-detail split.

       ┌─────────────┬──────────────────────┐
       │  master     │      detail          │
       │  (section   │   (opened page)      │
       │   grid)     │                      │
       └─────────────┴──────────────────────┘

     • @id/fragment_container — MASTER. Holds the section tile-grid (or
       the Home3D / minimalist home). Same id as the phone host so ALL
       existing MainActivity transactions target it unchanged.
     • @id/detail_container   — DETAIL. MainActivity.pushContent routes
       opened pages here (instead of the back stack) so the master stays
       visible alongside. Collapsed to GONE on the Home section, at which
       point the master — the only visible weighted child — expands to
       fill the full width (Home renders edge-to-edge like on phones).

     Both panes are width=0dp + layout_weight so the ratio is purely
     proportional and the GONE-collapse "just works" with no runtime
     LayoutParams math. Paddings mirror the phone host (island clearance). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.40"
        android:paddingTop="84dp"
        android:paddingBottom="92dp"
        android:clipToPadding="false" />

    <View
        android:id="@+id/pane_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="84dp"
        android:layout_marginBottom="92dp"
        android:background="#22FFFFFF" />

    <FrameLayout
        android:id="@+id/detail_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.60"
        android:paddingTop="84dp"
        android:paddingBottom="92dp"
        android:clipToPadding="false" />
</LinearLayout>
