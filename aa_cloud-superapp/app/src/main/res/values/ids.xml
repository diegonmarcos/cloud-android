<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pane hosts for SectionTabsFragment. STABLE resource ids — NOT
         View.generateViewId() — so a committed child fragment restores into
         the same host after process death. generateViewId() hands out a fresh
         int each process, so a saved child's container id no longer matches
         any view on restore → "No view found for id 0x2".
         Four of them: a tablet renders one pane per page and build.json tops
         out at 4 pages for the tabbed (aggregator) sections. Sections with
         more pages take the icon-rail + detail route instead, so they only
         ever need pane 0. Add ids here if an aggregator ever grows a 5th. -->
    <item name="section_pane_0" type="id" />
    <item name="section_pane_1" type="id" />
    <item name="section_pane_2" type="id" />
    <item name="section_pane_3" type="id" />
</resources>
