<?xml version="1.0" encoding="utf-8"?>
<!-- The SuperApp's own brand "D", lifted verbatim from the adaptive-icon
     foreground (ic_launcher_foreground.xml) so the tile and the launcher icon
     are the same glyph and can never drift apart.
     ic_launcher_foreground itself is unusable as a tile icon: it is a 108dp
     adaptive foreground, so it carries the icon-family cloud tick and the
     ~18dp safe-area padding an adaptive mask crops away — inside a flat tile
     that renders as a small D floating in empty space.
     The path is kept in its original 108-space and mapped into the 24dp grid
     by the group transform (x' = translateX + scale*x), which fits the glyph's
     42x48 box to 17.5x20 centred on 12,12. Recomputing the path by hand would
     have been a silent way to distort it.
     fillColor is #000000 + tint, not the source's hardcoded white, so it
     follows the theme like every other tile icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24"
    android:tint="?android:attr/textColorPrimary">
    <group
        android:scaleX="0.41667" android:scaleY="0.41667"
        android:translateX="-11.75" android:translateY="-10.5">
        <path android:fillColor="#000000"
            android:pathData="M36,30 L36,78 L56,78 C70.36,78 78,69.04 78,54 C78,38.96 70.36,30 56,30 Z M46,40 L56,40 C64.84,40 68,46.16 68,54 C68,61.84 64.84,68 56,68 L46,68 Z"/>
    </group>
</vector>
