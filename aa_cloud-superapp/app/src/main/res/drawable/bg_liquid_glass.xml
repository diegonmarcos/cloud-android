<?xml version="1.0" encoding="utf-8"?>
<!-- Apple-style "liquid glass" island fill — three-stop diagonal gradient
     gives the optical-illusion refraction look used in the linktree
     front-end (and in iOS 26's Liquid Glass system surfaces). White
     hot-spot top-left, soft middle, deep cool tone bottom-right;
     overlaid with a thin highlight inner stroke. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#40FFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#1AB794F4" />
        </shape>
    </item>
    <!-- Inner-edge highlight — top edge brighter to suggest a light source -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
