<?xml version="1.0" encoding="utf-8"?>
<!-- Apple-style Dynamic Island pill for the activity toolbar center.
     Pure black surface with a faint violet hairline so it reads as
     a separate "chip" against the toolbar's already-glassmorphic
     background, NOT the same colour as the toolbar itself. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF000000" />
    <stroke
        android:width="1dp"
        android:color="#55B794F4" />
    <corners android:radius="999dp" />
</shape>
