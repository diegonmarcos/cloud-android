<?xml version="1.0" encoding="utf-8"?>
<!-- vCard glyph — connects to the asymmetric-hamburger family
     (ic_hamburger_asymmetric): same three dashes of varying widths,
     but framed inside a rounded card outline with a filled avatar
     dot on the left so the reader instantly parses "business card
     with name + lines of info". Minimal, monochrome, 24dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/textColorPrimary">
    <!-- Card frame: rounded rectangle (3,5) → (21,19). 1.5dp stroke,
         transparent fill so the inner glyphs read clearly. -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="1.5"
        android:fillColor="#00000000"
        android:pathData="M5,5 L19,5 A2,2 0 0 1 21,7 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 L3,7 A2,2 0 0 1 5,5 Z" />
    <!-- Avatar dot — solid circle (left half). -->
    <path android:fillColor="#000000"
        android:pathData="M7,12 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0" />
    <!-- Three asymmetric dashes (matches ic_hamburger_asymmetric's
         short / long / medium pattern, shifted right of the avatar). -->
    <!-- Top — SHORT. -->
    <path android:fillColor="#000000"
        android:pathData="M11,9 H16 V10.2 H11 Z" />
    <!-- Middle — LONG (widest, like the hamburger's middle bar). -->
    <path android:fillColor="#000000"
        android:pathData="M11,11.4 H18 V12.6 H11 Z" />
    <!-- Bottom — MEDIUM. -->
    <path android:fillColor="#000000"
        android:pathData="M11,13.8 H15.5 V15 H11 Z" />
</vector>
