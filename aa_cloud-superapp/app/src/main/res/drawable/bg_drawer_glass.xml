<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer panel background — matches the body's black→purple gradient
     palette + the island's glass overlay so the drawer reads as part
     of the same surface family.
     Previous version's #EE000000 base was effectively opaque black —
     the violet gradient on top barely registered. Now the BASE is
     the brand gradient, glass tint sits over it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base = the same purple→black→purple vertical gradient as the
         app body background, so the drawer continues that surface. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FF2D1B69"
                android:centerColor="#FF000000"
                android:endColor="#FF2D1B69" />
        </shape>
    </item>
    <!-- Glassmorphism tint — diagonal violet gradient, low alpha so the
         body gradient breathes through. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#33B794F4"
                android:centerColor="#0DFFFFFF"
                android:endColor="#1A7C3AED" />
        </shape>
    </item>
    <!-- Right-edge hairline for separation from the body. -->
    <item android:left="278dp">
        <shape android:shape="rectangle">
            <solid android:color="#55B794F4" />
        </shape>
    </item>
</layer-list>
