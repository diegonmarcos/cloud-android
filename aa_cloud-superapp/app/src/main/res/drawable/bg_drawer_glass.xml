<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer panel glass — same gradient family as bg_liquid_glass but
     tinted for a left-anchored panel (135° gradient origin matches
     a light source from the top-right of the screen). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid black base so the drawer reads against the gradient
         backdrop even with the glass tint on top. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EE000000" />
        </shape>
    </item>
    <!-- Glass overlay — translucent violet diagonal gradient. -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#33B794F4"
                android:centerColor="#0DFFFFFF"
                android:endColor="#1A7C3AED" />
        </shape>
    </item>
    <!-- Right-edge violet hairline so the drawer reads as a separate
         surface from the body. -->
    <item android:left="278dp">
        <shape android:shape="rectangle">
            <solid android:color="#55B794F4" />
        </shape>
    </item>
</layer-list>
