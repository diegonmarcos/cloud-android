<?xml version="1.0" encoding="utf-8"?>
<!-- Roundy-rectangle surface for the music-controls popup. Same
     black-with-violet-hairline visual language as bg_dynamic_island,
     but a moderate 20dp corner radius so the card reads as a rounded
     rectangle (not a fully-rounded pill). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FF000000" />
    <stroke
        android:width="1dp"
        android:color="#55B794F4" />
    <corners android:radius="20dp" />
</shape>
