<?xml version="1.0" encoding="utf-8"?>
<!-- Glassy icon container — mirrors linktree's `.icon` treatment:
       background: linear-gradient(135deg, rgba(255,255,255,0.1),
                                            rgba(255,255,255,0.05));
       border-radius: $border-radius-md (20px);
     Two-layer: gradient fill + faint outer ring so the icon reads
     as a translucent glass coin sitting on the surrounding tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1AFFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#1A7C3AED" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
