<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent shape used as `android:tooltipFrameBackground` in
     Theme.Superapp. The system tooltip popup still fires on long-press
     (so accessibility services + TalkBack still get the label), it just
     paints onto nothing — the white/dark pill becomes invisible.
     Less invasive than nulling tooltipText on every descendant view,
     which we tried earlier and which made every tap wait the full
     long-press timeout before committing. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
</shape>
