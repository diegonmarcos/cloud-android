<?xml version="1.0" encoding="utf-8"?>
<!-- Symmetric purple → black → purple vertical gradient. Top edge AND
     bottom edge are deep purple; black sits in the middle so both
     islands (top toolbar + bottom nav) sit against purple and stay
     visible (black-island-on-black-bg was invisible before). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#FF2D1B69"
        android:centerColor="#FF000000"
        android:endColor="#FF2D1B69" />
</shape>
