<?xml version="1.0" encoding="utf-8"?>
<!--
    Device Admin policy declaration — declares the EXACT set of
    DevicePolicyManager capabilities this app needs and NOTHING ELSE.
    Activation surfaces the listed policies to the user in the system
    confirmation dialog (Settings → Security → Device admin apps); the
    user knows exactly what they're granting.

    Scope: <force-lock /> ONLY — needed so DPM.lockNow() succeeds.
    We do NOT request wipe-data, reset-password, expire-password,
    encrypted-storage, limit-password, watch-login, or disable-keyguard
    — those would surface scary warnings ("This app can erase all data
    on your phone") for a feature the user expressly wants to be the
    double-tap-to-lock shortcut and nothing more.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
