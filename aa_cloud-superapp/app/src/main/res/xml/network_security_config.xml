<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration — controls TLS-by-default vs cleartext
  permitted on a per-domain basis. Android 9+ blocks cleartext HTTP by
  default; that's why http://localhost:8000 returns net::ERR in WebView
  without this file.

  Policy:
   • Public internet — HTTPS only (base-config default).
   • Loopback + private RFC1918 prefixes — cleartext allowed. Covers
     localhost, 127.0.0.1, the WG mesh (10.0.0.x), and home LAN ranges.
   • mDNS — *.local + *.lan allowed (printer / Pi-hole / etc.).

  IP-prefix enumeration: Android's <domain> element does NOT accept
  CIDR. The list below enumerates 10.0.0.x explicitly (covers the WG
  mesh declared in cloud-data) plus the common 192.168.x.y first-octet
  pairs Diego uses on home/office Wi-Fi. Adding a new private host =
  one <domain> line.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>

        <!-- WG mesh — Diego's 10.0.0.x peers per cloud-data mesh.json. -->
        <domain>10.0.0.1</domain>
        <domain>10.0.0.2</domain>
        <domain>10.0.0.3</domain>
        <domain>10.0.0.4</domain>
        <domain>10.0.0.5</domain>
        <domain>10.0.0.6</domain>
        <domain>10.0.0.7</domain>
        <domain>10.0.0.8</domain>
        <domain>10.0.0.9</domain>
        <domain>10.0.0.10</domain>

        <!-- Home / office LAN typical first-octet pairs. Add more as
             needed; CIDR is not supported by this schema. -->
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.4.1</domain>
        <domain includeSubdomains="true">192.168.8.1</domain>

        <!-- mDNS / Bonjour service discovery names (printers, Pi-hole,
             Synology). -->
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="true">lan</domain>
    </domain-config>
</network-security-config>
