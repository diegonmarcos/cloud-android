<?xml version="1.0" encoding="utf-8"?>
<!-- Grouped Home master view. Scrollable so groups stack at a fixed
     per-row height and labels never overflow. The fragment sets a
     fixed minHeight per row in code; everything past the visible area
     scrolls. Replaces the earlier "auto-fit to one screen" weight
     layout that crammed rows into too-short heights and clipped tile
     labels. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/home_grouped_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp" />
</ScrollView>
