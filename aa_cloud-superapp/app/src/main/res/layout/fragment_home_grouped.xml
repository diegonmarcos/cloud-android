<?xml version="1.0" encoding="utf-8"?>
<!-- Grouped Home master view. Auto-scales to fit one screen — no scroll.
     The Fragment builds groups with weight-distributed tile rows so the
     whole grid + headers always fit between the AppBar and BottomNav.
     If the screen is too short the rows shrink uniformly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_grouped_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp" />
