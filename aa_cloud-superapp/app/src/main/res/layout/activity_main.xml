<?xml version="1.0" encoding="utf-8"?>
<!-- ┌───────────────────────────────────────────────────────────────────┐
     │                            Toolbar  (per-page top buttons)        │
     ├──────────┬────────────────────────────────────────────────────────┤
     │ Drawer   │                                                        │
     │ (left,   │              Section Fragment (mail/feed/…)            │
     │  collap- │              host = R.id.fragment_container             │
     │  sible,  │                                                        │
     │  2-level)│                                                        │
     ├──────────┴────────────────────────────────────────────────────────┤
     │              BottomNavigationView (6 section buttons)              │
     └───────────────────────────────────────────────────────────────────┘
     The DrawerLayout is the root; CoordinatorLayout sits in its primary
     content slot; NavigationView sits in the start-edge slot. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_black_purple">

        <!-- Floating "Dynamic Island"-style top bar: pill-shaped card with
             horizontal + top margins so it visually detaches from the
             screen edges, matching the bottom nav island. AppBarLayout
             itself is transparent so only the inner card surface shows. -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fitsSystemWindows="true"
            app:liftOnScroll="false">

            <!-- Glass island (linktree $glass-bg / $glass-border / radius-md).
                 Low elevation + 1dp stroke gives the "frosted panel" feel
                 even on devices without backdrop-blur support (pre-API 31).
                 MainActivity adds Window.setBackgroundBlurRadius on API 31+
                 to push it the rest of the way toward true glassmorphism. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/toolbar_island"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/glass_bg"
                app:strokeWidth="1dp"
                app:strokeColor="@color/glass_border">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:titleCentered="false"
                    app:titleTextAppearance="?attr/textAppearanceTitleLarge"
                    app:title="@string/app_name" />

            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Section fragment swap target. Bottom margin reserves space for
             the floating "Dynamic Island" nav below (height ~72dp + 24dp
             gap so the island doesn't overlap scrolling content). -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="96dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- Floating "Dynamic Island"-style nav: pill-shaped card with
             horizontal + bottom margins so it visually detaches from the
             screen edges. Card host clips its child to the rounded
             outline; the BottomNavigationView inside is transparent so
             only the card surface shows. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottom_nav_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/glass_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/glass_border">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />

        </com.google.android.material.card.MaterialCardView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Drawer panel — see view_drawer_panel.xml. Two-tab paginated drawer:
         [Home] shows the all-sections index (the previous NavigationView
         content, hosted by HomeDrawerFragment); [<currentSection>] shows
         that section module's own drawer fragment (e.g. MailDrawerFragment
         for FairEmail's account+folder tree). -->
    <include layout="@layout/view_drawer_panel" />

</androidx.drawerlayout.widget.DrawerLayout>
