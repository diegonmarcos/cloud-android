<?xml version="1.0" encoding="utf-8"?>
<!-- Shell = FrameLayout. Three children, each with explicit gravity:
     - FragmentContainerView (background) MATCH_PARENT with paddings
       accommodating both islands' heights so content doesn't slide
       under them.
     - AppBarLayout (top island)        layout_gravity=top
     - bottom_nav_island MaterialCardView (bottom island) gravity=bottom

     Why FrameLayout: LinearLayout's weight calculation kept producing
     regressions where the bottom island vanished. FrameLayout positions
     children at explicit anchors with NO inter-child sizing math. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    app:statusBarBackground="@android:color/transparent"
    tools:openDrawer="start">

    <FrameLayout
        android:id="@+id/shell_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_black_purple"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Galaxy backdrop — promoted to the shell level so the stars +
             comets fill the WHOLE screen edge-to-edge, including the
             status-bar area where the camera punch-hole + system icons
             live. On non-home pages most fragments overlay opaque
             content so the galaxy only peeks through transparent zones
             (the system bars, fragment-transition fade, etc.). -->
        <com.diegonmarcos.superapp.GalaxyBackdropView
            android:id="@+id/galaxy_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <!-- Fragment fills the whole shell; paddings carve out room for
             both islands so content stays clear of them. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="84dp"
            android:paddingBottom="92dp"
            android:clipToPadding="false" />

        <!-- Launcher status strip — visible ONLY when the SuperApp is
             the default Android launcher AND the active LauncherTheme
             is Cloud. Drawn at the very top edge (where the system
             status bar used to live before MainActivity hid it).
             Default visibility is gone; MainActivity.applyLauncherChrome
             flips it on per the (isLauncher, theme) state. -->
        <com.diegonmarcos.superapp.LauncherStatusStripView
            android:id="@+id/launcher_status_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:elevation="20dp"
            android:visibility="gone" />

        <!-- Top island — FrameLayout with the bg_liquid_glass rounded
             drawable as background. MaterialCardView was producing
             measure-cycle bugs with match_parent children (View +
             ShimmerBorderView) inside a wrap_content card; the card
             would inflate to the full screen and the shimmer would
             draw around the entire viewport. FrameLayout with a
             rounded drawable bg avoids all that — wrap_content
             collapses to its single intrinsic-sized child
             (MaterialToolbar at ?attr/actionBarSize). -->
        <FrameLayout
            android:id="@+id/toolbar_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:titleCentered="false"
                app:title="" />

            <!-- Music-playing indicator — 3 animated equalizer bars,
                 sits between the status-strip's date/time row and the
                 centered Dynamic Island below. Default GONE; flipped
                 to VISIBLE by [NowPlayingMonitor] the moment any
                 system-wide media session enters STATE_PLAYING.
                 Width is small (28dp) so it doesn't compete visually
                 with the date/time it's anchored under. -->
            <com.diegonmarcos.superapp.EqualizerBarsView
                android:id="@+id/music_playing_indicator"
                android:layout_width="28dp"
                android:layout_height="14dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="2dp"
                android:visibility="gone" />

            <!-- Apple-style centered "Dynamic Island" pill. Anchored to the
                 toolbar center via gravity; lives between the hamburger
                 (left, drawer toggle) and the action items (right, Back).
                 Half the width / height of where the old search trigger
                 sat — pure decoration for now, but with a stable id so
                 future status surfaces (sync state, notifications, etc.)
                 can swap into it. -->
            <FrameLayout
                android:id="@+id/dynamic_island"
                android:layout_width="120dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dynamic_island"
                android:clickable="false"
                android:focusable="false">

                <!-- IslandWaveView replaces the old "DCM · Apps"
                     identity text — a Samsung-music-island-style
                     animated triple-sine wave in violet→lilac gradient.
                     The id stays `dynamic_island_label` so the existing
                     refreshDynamicIsland's findViewById<TextView>
                     short-circuits gracefully (returns null → early
                     return) without any code change. -->
                <com.diegonmarcos.superapp.IslandWaveView
                    android:id="@+id/dynamic_island_wave"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false" />

                <!-- Prismatic neon halo around the island perimeter —
                     full rainbow sweep chasing around the pill. Sized
                     match_parent so it covers the island exactly.
                     clickable=false so taps pass through to the parent
                     island FrameLayout's notification-center handler. -->
                <com.diegonmarcos.superapp.PrismaticShimmerView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>

        </FrameLayout>

        <!-- Bottom island — same pattern. -->
        <FrameLayout
            android:id="@+id/bottom_nav_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_liquid_glass">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />

        </FrameLayout>
    </FrameLayout>

    <include layout="@layout/view_drawer_panel" />

</androidx.drawerlayout.widget.DrawerLayout>
