<?xml version="1.0" encoding="utf-8"?>
<!-- Shell = FrameLayout. Three children, each with explicit gravity:
     - FragmentContainerView (background) MATCH_PARENT with paddings
       accommodating both islands' heights so content doesn't slide
       under them.
     - AppBarLayout (top island)        layout_gravity=top
     - bottom_nav_island MaterialCardView (bottom island) gravity=bottom

     Why FrameLayout: LinearLayout's weight calculation kept producing
     regressions where the bottom island vanished. FrameLayout positions
     children at explicit anchors with NO inter-child sizing math. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <FrameLayout
        android:id="@+id/shell_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_black_purple"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Galaxy backdrop — promoted to the shell level so the stars +
             comets fill the WHOLE screen edge-to-edge, including the
             status-bar area where the camera punch-hole + system icons
             live. On non-home pages most fragments overlay opaque
             content so the galaxy only peeks through transparent zones
             (the system bars, fragment-transition fade, etc.). -->
        <com.diegonmarcos.superapp.ui.GalaxyBackdropView
            android:id="@+id/galaxy_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <!-- Content host — responsive. Phone (default): a single
             full-bleed @id/fragment_container. Tablet (sw600dp): a
             master (@id/fragment_container) + detail (@id/detail_container)
             split. See res/layout[-sw600dp]/view_content_panes.xml. The
             chrome below (islands, sirius star, drawer) is shared by BOTH
             form factors — only the content host swaps. -->
        <include layout="@layout/view_content_panes" />

        <!-- Full-bleed modal overlay host. Notification Center, Search and
             the update overlay are added here (not into the content host)
             so they ALWAYS span the full screen width — on tablets they
             cover both master + detail panes instead of being trapped in
             the 40% master column. Same island paddings as the content
             host so they stay clear of the top/bottom islands exactly as
             before; empty + non-clickable → touch-transparent to the
             content underneath until an overlay is added. -->
        <FrameLayout
            android:id="@+id/overlay_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="84dp"
            android:paddingBottom="92dp"
            android:clipToPadding="false"
            android:clickable="false"
            android:focusable="false" />

        <!-- Sirius Star — a single bright, bluish-white sparkle centred on the
             home screen (theme-agnostic: it floats over whichever home
             fragment is active). A tap opens the FloatingNav menu. Slightly
             larger than the home tiles + a soft glow (shadowLayer) for the
             "shining" look; MainActivity adds a gentle pulse and flips it
             VISIBLE only on the `home` section. Default gone. -->
        <TextView
            android:id="@+id/sirius_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✦"
            android:textSize="13sp"
            android:textColor="#F2F7FF"
            android:shadowColor="#9CC2FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="7"
            android:contentDescription="Sirius Star — open navigation"
            android:clickable="true"
            android:focusable="true"
            android:elevation="16dp"
            android:visibility="gone" />

        <!-- Canopus star — the 2nd-brightest. Sits UNDER the cube (translationY
             set in code), a touch bigger than Sirius. Tapping it opens the
             libs:onehand circular-menu. Glyph/size data-driven from
             build.json::onehand.circular_menu.star. VISIBLE only on `home`. -->
        <TextView
            android:id="@+id/canopus_star"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="✦"
            android:textSize="20sp"
            android:textColor="#F2F7FF"
            android:shadowColor="#9CC2FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8"
            android:contentDescription="Canopus Star — open circular menu"
            android:clickable="true"
            android:focusable="true"
            android:elevation="16dp"
            android:visibility="gone" />

        <!-- Launcher status strip — visible ONLY when the SuperApp is
             the default Android launcher AND the active LauncherTheme
             is Cloud. Drawn at the very top edge (where the system
             status bar used to live before MainActivity hid it).
             Default visibility is gone; MainActivity.applyLauncherChrome
             flips it on per the (isLauncher, theme) state. -->
        <com.diegonmarcos.superapp.launcher.LauncherStatusStripView
            android:id="@+id/launcher_status_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:elevation="20dp"
            android:visibility="gone" />

        <!-- Top island — FrameLayout with the bg_liquid_glass rounded
             drawable as background. MaterialCardView was producing
             measure-cycle bugs with match_parent children (View +
             ShimmerBorderView) inside a wrap_content card; the card
             would inflate to the full screen and the shimmer would
             draw around the entire viewport. FrameLayout with a
             rounded drawable bg avoids all that — wrap_content
             collapses to its single intrinsic-sized child
             (MaterialToolbar at ?attr/actionBarSize). -->
        <FrameLayout
            android:id="@+id/toolbar_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="26dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:titleCentered="false"
                app:title="" />

            <!-- Music-playing mini-island — Samsung now-playing style:
                 small dark pill above the main Dynamic Island, with
                 the currently-playing app's icon on the LEFT and the
                 song title scrolling horizontally (marquee) on the
                 RIGHT. Behind both sits a thin line-wave background
                 (WaveLineView) — visually distinct from the main
                 Dynamic Island's 4-channel pastel waveform so the
                 two pills read as related but not duplicate.
                 Tap → open the app whose media session is currently
                 PLAYING (wired in MainActivity via
                 NowPlayingMonitor.currentPackage). Default GONE;
                 flipped VISIBLE by NowPlayingMonitor when any system-
                 wide media session enters STATE_PLAYING. -->
            <FrameLayout
                android:id="@+id/music_playing_island"
                android:layout_width="90dp"
                android:layout_height="16dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_dynamic_island"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <!-- Thin scrolling-sinusoid line drawn full-bleed behind
                     the icon + marquee. DIFFERENT pattern from the main
                     Dynamic Island's IslandWaveView: a single low-alpha
                     line that's the sum of a slow body wave + a fast
                     carrier, producing a subtle beating effect that
                     doesn't compete with the marquee text. Self-managing
                     animator (onAttachedToWindow / onDetachedFromWindow). -->
                <com.diegonmarcos.superapp.ui.WaveLineView
                    android:id="@+id/music_playing_wave"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="3dp"
                    android:paddingEnd="6dp"
                    android:clickable="false"
                    android:focusable="false">

                    <ImageView
                        android:id="@+id/music_playing_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null"
                        android:clickable="false"
                        android:focusable="false" />

                    <!-- Marquee song title. setSelected(true) from
                         MainActivity is what kicks the scroll animation
                         off — without it, the marquee just ellipsizes.
                         singleLine + ellipsize=marquee + scrollHorizontally
                         are the canonical combination per Android docs. -->
                    <TextView
                        android:id="@+id/music_playing_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:textSize="8sp"
                        android:textColor="#E5E7EB"
                        android:fontFamily="sans-serif-medium"
                        android:clickable="false"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>

            <!-- Apple-style centered "Dynamic Island" pill. Anchored to the
                 toolbar center via gravity; lives between the hamburger
                 (left, drawer toggle) and the action items (right, Back).
                 Half the width / height of where the old search trigger
                 sat — pure decoration for now, but with a stable id so
                 future status surfaces (sync state, notifications, etc.)
                 can swap into it. -->
            <FrameLayout
                android:id="@+id/dynamic_island"
                android:layout_width="120dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dynamic_island"
                android:clickable="false"
                android:focusable="false">

                <!-- IslandWaveView replaces the old "DCM · Apps"
                     identity text — a Samsung-music-island-style
                     animated triple-sine wave in violet→lilac gradient.
                     The id stays `dynamic_island_label` so the existing
                     refreshDynamicIsland's findViewById<TextView>
                     short-circuits gracefully (returns null → early
                     return) without any code change. -->
                <com.diegonmarcos.superapp.ui.IslandWaveView
                    android:id="@+id/dynamic_island_wave"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false" />

                <!-- Prismatic neon halo around the island perimeter —
                     full rainbow sweep chasing around the pill. Sized
                     match_parent so it covers the island exactly.
                     clickable=false so taps pass through to the parent
                     island FrameLayout's notification-center handler. -->
                <com.diegonmarcos.superapp.ui.PrismaticShimmerView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>

        </FrameLayout>

        <!-- Bottom island — same pattern. -->
        <FrameLayout
            android:id="@+id/bottom_nav_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_liquid_glass">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />

        </FrameLayout>
    </FrameLayout>

    <include layout="@layout/view_drawer_panel" />

</androidx.drawerlayout.widget.DrawerLayout>
