<?xml version="1.0" encoding="utf-8"?>
<!-- Vertical LinearLayout — top-down stacking is the GUARANTEE.
     ConstraintLayout and CoordinatorLayout both produced regressions
     where the bottom island drifted toward the top; LinearLayout makes
     positioning purely declarative: AppBar at top, fragment fills the
     middle (layout_weight=1), bottom island bolted to the bottom. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <LinearLayout
        android:id="@+id/shell_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_black_purple"
        android:orientation="vertical">

        <!-- Top island toolbar — AppBarLayout kept so ActionBarDrawerToggle
             still has an AppBar host. -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/toolbar_island"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_liquid_glass" />

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:titleCentered="false"
                    app:titleTextAppearance="?attr/textAppearanceTitleLarge"
                    app:title="@string/app_name" />

                <com.diegonmarcos.superapp.ShimmerBorderView
                    android:id="@+id/toolbar_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Fragment fills the middle band. layout_weight=1 means
             "take all remaining vertical space" — the only way the
             bottom island could collapse upward is if THIS view's
             measured height collapses, which can't happen with weight=1
             and height=0dp. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom island — bolted to the bottom of the LinearLayout. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottom_nav_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_liquid_glass" />

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />

        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <include layout="@layout/view_drawer_panel" />

</androidx.drawerlayout.widget.DrawerLayout>
