<?xml version="1.0" encoding="utf-8"?>
<!-- Shell = FrameLayout. Three children, each with explicit gravity:
     - FragmentContainerView (background) MATCH_PARENT with paddings
       accommodating both islands' heights so content doesn't slide
       under them.
     - AppBarLayout (top island)        layout_gravity=top
     - bottom_nav_island MaterialCardView (bottom island) gravity=bottom

     Why FrameLayout: LinearLayout's weight calculation kept producing
     regressions where the bottom island vanished. FrameLayout positions
     children at explicit anchors with NO inter-child sizing math. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <FrameLayout
        android:id="@+id/shell_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_black_purple">

        <!-- Fragment fills the whole shell; paddings carve out room for
             both islands so content stays clear of them. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="84dp"
            android:paddingBottom="92dp"
            android:clipToPadding="false" />

        <!-- Top island — FrameLayout with the bg_liquid_glass rounded
             drawable as background. MaterialCardView was producing
             measure-cycle bugs with match_parent children (View +
             ShimmerBorderView) inside a wrap_content card; the card
             would inflate to the full screen and the shimmer would
             draw around the entire viewport. FrameLayout with a
             rounded drawable bg avoids all that — wrap_content
             collapses to its single intrinsic-sized child
             (MaterialToolbar at ?attr/actionBarSize). -->
        <FrameLayout
            android:id="@+id/toolbar_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_liquid_glass">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:titleCentered="false"
                app:title="" />

            <!-- Apple-style centered "Dynamic Island" pill. Anchored to the
                 toolbar center via gravity; lives between the hamburger
                 (left, drawer toggle) and the action items (right, Back).
                 Half the width / height of where the old search trigger
                 sat — pure decoration for now, but with a stable id so
                 future status surfaces (sync state, notifications, etc.)
                 can swap into it. -->
            <FrameLayout
                android:id="@+id/dynamic_island"
                android:layout_width="120dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dynamic_island"
                android:clickable="false"
                android:focusable="false">

                <TextView
                    android:id="@+id/dynamic_island_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="monospace"
                    android:textColor="@color/island_accent"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:text="DCM · Apps" />
            </FrameLayout>

            <!-- Neon-violet shimmer comet around the toolbar perimeter.
                 Explicit actionBarSize height (NOT match_parent) so the
                 wrap_content FrameLayout doesn't enter a measure cycle
                 with this child. -->
            <com.diegonmarcos.superapp.ShimmerBorderView
                android:id="@+id/toolbar_shimmer"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize" />

        </FrameLayout>

        <!-- Bottom island — same pattern. -->
        <FrameLayout
            android:id="@+id/bottom_nav_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_liquid_glass">

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />

        </FrameLayout>
    </FrameLayout>

    <include layout="@layout/view_drawer_panel" />

</androidx.drawerlayout.widget.DrawerLayout>
