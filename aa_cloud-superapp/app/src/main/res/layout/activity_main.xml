<?xml version="1.0" encoding="utf-8"?>
<!-- Shell = FrameLayout. Three children, each with explicit gravity:
     - FragmentContainerView (background) MATCH_PARENT with paddings
       accommodating both islands' heights so content doesn't slide
       under them.
     - AppBarLayout (top island)        layout_gravity=top
     - bottom_nav_island MaterialCardView (bottom island) gravity=bottom

     Why FrameLayout: LinearLayout's weight calculation kept producing
     regressions where the bottom island vanished. FrameLayout positions
     children at explicit anchors with NO inter-child sizing math. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <FrameLayout
        android:id="@+id/shell_linear"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_black_purple">

        <!-- Fragment fills the whole shell; paddings carve out room for
             both islands so content stays clear of them. -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="84dp"
            android:paddingBottom="92dp"
            android:clipToPadding="false" />

        <!-- Top island toolbar — direct child of the FrameLayout shell,
             no AppBarLayout wrapper (which is designed for
             CoordinatorLayout and was claiming full-screen height
             when nested elsewhere, leaving the shimmer-border drawn
             as a rectangle around the entire screen). The AppBar
             provided nothing we use besides being a host for the
             toolbar — ActionBarDrawerToggle works directly with the
             toolbar reference. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/toolbar_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_liquid_glass" />

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:titleCentered="false"
                app:titleTextAppearance="?attr/textAppearanceTitleLarge"
                app:title="@string/app_name" />

            <com.diegonmarcos.superapp.ShimmerBorderView
                android:id="@+id/toolbar_shimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom island. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottom_nav_island"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_liquid_glass" />

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/bottom_nav" />

        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <include layout="@layout/view_drawer_panel" />

</androidx.drawerlayout.widget.DrawerLayout>
