<?xml version="1.0" encoding="utf-8"?>
<!-- WG mesh — rich peer table. Header card + scrollable rows fed from
     build.json::ui.mesh_topology. Live status overlay arrives once the
     Rust cloud_url_health binary is wired into the APK. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:text="@string/mesh_title" />

        <TextView
            android:id="@+id/mesh_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Column header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:gravity="center_vertical">

                <View android:layout_width="10dp" android:layout_height="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:layout_marginStart="10dp"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:text="@string/mesh_col_name" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:text="@string/mesh_col_wg_ip" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:text="@string/mesh_col_endpoint_role" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/mesh_table"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
