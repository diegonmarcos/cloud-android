<?xml version="1.0" encoding="utf-8"?>
<!-- The existing all-sections menu, wrapped as a Fragment view so it can be
     swapped in/out of the drawer's page container. Dense styling preserved. -->
<com.google.android.material.navigation.NavigationView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:headerLayout="@layout/nav_header"
    app:itemMinHeight="44dp"
    app:itemHorizontalPadding="14dp"
    app:itemIconPadding="14dp"
    app:itemTextAppearance="?attr/textAppearanceBodyMedium"
    app:itemTextColor="#FFE9D8FD"
    app:itemIconTint="#FFE9D8FD"
    app:itemBackground="@android:color/transparent"
    app:itemIconSize="26dp"
    app:subheaderColor="#CCB794F4"
    app:subheaderInsetStart="8dp"
    app:dividerInsetStart="8dp" />
