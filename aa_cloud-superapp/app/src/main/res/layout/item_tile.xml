<?xml version="1.0" encoding="utf-8"?>
<!-- Single tile — MaterialCardView wrapper, weight-distributed icon + label
     so BOTH scale together when HomeGroupedFragment shrinks the tile.
     Label uses autoSizeText (uniform 9–13sp) so it always fits even on
     short rows. Default 128dp height is only honoured when not used in
     a weight-based parent (the legacy flat TileGrid). -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    android:background="@drawable/bg_tile_glass"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp">

        <!-- Icon: small (32dp), centered, no background. Linktree pattern —
             the link CARD carries the glass, the icon itself is just a
             small white glyph (filter:invert(1) in CSS, near-white violet
             tint here). -->
        <FrameLayout
            android:id="@+id/tile_icon_bg"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp">

            <ImageView
                android:id="@+id/tile_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/tile_label"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSurface"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="13sp"
            app:autoSizeStepGranularity="1sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
