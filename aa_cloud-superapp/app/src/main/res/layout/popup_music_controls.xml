<?xml version="1.0" encoding="utf-8"?>
<!-- Samsung-style music controls popup — surfaced when the user taps
     the music mini-island. Layout mirrors Samsung's One UI now-playing
     card on the lock screen / notification shade:
       row 1: album art (left, ~48dp square) + title/artist stack (right)
       row 2: progress bar with current/total time underneath
       row 3: three transport buttons centered — prev | play/pause | next
     The album-art ImageView is the launcher-app-icon target: tapping it
     opens the music app. Outside-tap or back closes (PopupWindow's
     outsideTouchable). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_music_popup"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/music_popup_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/music_popup_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textSize="14sp"
                android:textColor="#F5F5F5"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/music_popup_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="#B4B4B4"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <SeekBar
        android:id="@+id/music_popup_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progress="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="-2dp">

        <TextView
            android:id="@+id/music_popup_time_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#9CA3AF"
            android:text="0:00" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/music_popup_time_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#9CA3AF"
            android:text="0:00" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="6dp">

        <ImageButton
            android:id="@+id/music_popup_prev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:tint="#F5F5F5"
            android:contentDescription="@null" />

        <Space
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <ImageButton
            android:id="@+id/music_popup_play_pause"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@android:drawable/ic_media_pause"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:tint="#F5F5F5"
            android:contentDescription="@null" />

        <Space
            android:layout_width="16dp"
            android:layout_height="0dp" />

        <ImageButton
            android:id="@+id/music_popup_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@android:drawable/ic_media_next"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:tint="#F5F5F5"
            android:contentDescription="@null" />
    </LinearLayout>
</LinearLayout>
