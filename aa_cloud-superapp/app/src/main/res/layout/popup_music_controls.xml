<?xml version="1.0" encoding="utf-8"?>
<!-- Samsung-style music controls popup — surfaced when the user taps
     the music mini-island. A LANDSCAPE rounded-rectangle card (wider
     than tall) whose full background is the current track's album
     cover (centerCrop), dimmed by a dark scrim so the controls stay
     legible. MaterialCardView gives the rounded corners + clips the
     album art to them + the violet hairline stroke (matching the
     dynamic-island family).

     Content stacked over the art:
       row 1: app icon (left, tap → open the music app) + title/artist
       row 2: progress bar with current/total time underneath
       row 3: three transport buttons centered — prev | play/pause | next -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="#FF000000"
    app:strokeColor="#55B794F4"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <!-- FrameLayout is match_parent in BOTH axes — pinned to the card's
         FIXED 340×188dp box. This is what stops the album art from
         resizing the popup: the ImageView fills (and centerCrops into)
         this fixed box instead of the box growing to the bitmap's
         intrinsic size (which, with wrap_content, blew the frame up to
         fill the whole screen). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Full-bleed album cover. centerCrop fills the whole card;
             the MaterialCardView clips it to the 20dp rounded corners.
             Left null until refreshMetadata loads ALBUM_ART; when the
             session publishes no art the card's black background shows
             through. -->
        <ImageView
            android:id="@+id/music_popup_art_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- Dark scrim over the art for text/button contrast. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#A6000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/music_popup_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/music_popup_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:scrollHorizontally="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:textSize="14sp"
                        android:textColor="#F5F5F5"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#FF000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/music_popup_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="11sp"
                        android:textColor="#D4D4D4"
                        android:layout_marginTop="2dp"
                        android:shadowColor="#FF000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Audio-route + volume info row. Left: where the media
                 is playing (Bluetooth device / wired headphones /
                 phone speaker). Right: the session volume percent.
                 Both refreshed on the same 500ms tick as the progress
                 bar so route/volume changes reflect live. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/music_popup_route"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textColor="#E0E0E0"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:includeFontPadding="false"
                    android:text="" />

                <TextView
                    android:id="@+id/music_popup_volume"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="11sp"
                    android:textColor="#E0E0E0"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:includeFontPadding="false"
                    android:text="" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/music_popup_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:progress="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="-2dp">

                <TextView
                    android:id="@+id/music_popup_time_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#E0E0E0"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="0:00" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/music_popup_time_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#E0E0E0"
                    android:shadowColor="#FF000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:text="0:00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="2dp">

                <!-- Shazam (leftmost) — opens the Shazam app. Monochrome
                     white glyph to match the transport row. -->
                <ImageButton
                    android:id="@+id/music_popup_shazam"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_music_recognise"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:tint="#FFFFFF"
                    android:contentDescription="@null" />

                <Space
                    android:layout_width="14dp"
                    android:layout_height="0dp" />

                <ImageButton
                    android:id="@+id/music_popup_prev"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@android:drawable/ic_media_previous"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:tint="#FFFFFF"
                    android:contentDescription="@null" />

                <Space
                    android:layout_width="14dp"
                    android:layout_height="0dp" />

                <ImageButton
                    android:id="@+id/music_popup_play_pause"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:src="@android:drawable/ic_media_pause"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:tint="#FFFFFF"
                    android:contentDescription="@null" />

                <Space
                    android:layout_width="14dp"
                    android:layout_height="0dp" />

                <ImageButton
                    android:id="@+id/music_popup_next"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:src="@android:drawable/ic_media_next"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:tint="#FFFFFF"
                    android:contentDescription="@null" />

                <Space
                    android:layout_width="14dp"
                    android:layout_height="0dp" />

                <!-- Favourite (heart) — far right. Toggles + sends a
                     heart rating to the session when supported. -->
                <ImageButton
                    android:id="@+id/music_popup_favourite"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_music_heart"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:scaleType="centerInside"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
