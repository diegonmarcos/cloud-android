<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer header with TWO distinct banners stacked + a clear separator:
       App Banner   — colorPrimaryContainer    — brand identity + build info.
       Separator    — 1dp colorOutlineVariant  — visual break.
       User Banner  — colorSecondaryContainer  — initials avatar + mode pill,
                      tappable to flip Apps↔Admin.
     The container itself has no background — each child paints its own
     surface so the two banners read as separate cards. Wiring in
     HomeDrawerFragment.onViewCreated. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ── App Banner ───────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/nav_header_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/drawer_banner_app"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="84dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_home"
            app:tint="@color/drawer_banner_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/drawer_banner_text"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/nav_header_build"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:alpha="0.7"
                android:fontFamily="monospace"
                android:textColor="@color/drawer_banner_text"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

            <TextView
                android:id="@+id/nav_header_timestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:alpha="0.55"
                android:fontFamily="monospace"
                android:textColor="@color/drawer_banner_text"
                android:textAppearance="?attr/textAppearanceLabelSmall" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Separator ────────────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/drawer_separator" />

    <!-- ── User Banner ──────────────────────────────────────────────── -->
    <!-- Same minHeight as App Banner so the two strips read as paired
         cards. Three lines: full name → email → mode (with toggle icon).
         The avatar circle on the left mirrors the App Banner's icon. -->
    <LinearLayout
        android:id="@+id/nav_header_user_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/drawer_banner_user"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="84dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/nav_header_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_user_avatar"
            android:gravity="center"
            android:textColor="@color/drawer_banner_text"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textStyle="bold"
            tools:text="DCM" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_header_user_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/drawer_banner_text"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Diego Coelho Marcos" />

            <TextView
                android:id="@+id/nav_header_user_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:alpha="0.7"
                android:fontFamily="monospace"
                android:textColor="@color/drawer_banner_text"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                tools:text="me@diegonmarcos.com" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nav_header_user_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/drawer_banner_text"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    tools:text="Mode: Apps" />

                <ImageView
                    android:id="@+id/nav_header_swap"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_refresh"
                    android:alpha="0.85"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/drawer_banner_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
