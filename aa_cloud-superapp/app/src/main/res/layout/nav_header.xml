<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer header with TWO distinct banners stacked + a clear separator:
       App Banner   — colorPrimaryContainer    — brand identity + build info.
       Separator    — 1dp colorOutlineVariant  — visual break.
       User Banner  — colorSecondaryContainer  — initials avatar + mode pill,
                      tappable to flip Apps↔Admin.
     The container itself has no background — each child paints its own
     surface so the two banners read as separate cards. Wiring in
     HomeDrawerFragment.onViewCreated. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ── App Banner ───────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/nav_header_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimaryContainer"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="96dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:src="@drawable/ic_home"
            app:tint="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nav_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/nav_header_build"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:alpha="0.7"
                android:fontFamily="monospace"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textAppearance="?attr/textAppearanceLabelSmall" />

            <TextView
                android:id="@+id/nav_header_timestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:alpha="0.55"
                android:fontFamily="monospace"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textAppearance="?attr/textAppearanceLabelSmall" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Separator ────────────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <!-- ── User Banner ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/nav_header_user_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSecondaryContainer"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/nav_header_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_user_avatar"
            android:gravity="center"
            android:textColor="?attr/colorOnTertiary"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textStyle="bold"
            tools:text="DCM" />

        <TextView
            android:id="@+id/nav_header_identity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="DCM  |  Apps" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_refresh"
            android:alpha="0.55"
            app:tint="?attr/colorOnSecondaryContainer" />
    </LinearLayout>
</LinearLayout>
