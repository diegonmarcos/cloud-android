<?xml version="1.0" encoding="utf-8"?>
<!-- Compact drawer header (was 176dp / Material default) → 64dp so the
     drawer body can host many dense links (accounts, feeds, C3 reports, …). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?attr/colorPrimaryContainer"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/nav_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <!-- Build identifier — set dynamically from BuildConfig in MainActivity. -->
    <TextView
        android:id="@+id/nav_header_build"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textAppearance="?attr/textAppearanceLabelSmall" />
</LinearLayout>
