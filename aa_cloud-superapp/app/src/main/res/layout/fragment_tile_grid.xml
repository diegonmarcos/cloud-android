<?xml version="1.0" encoding="utf-8"?>
<!-- Tile grid host — auto-fits to one screen, same pattern as
     HomeGroupedFragment so the tile icons here match the Home grid's
     visual size. No scroll: title at top (wrap_content), grid takes the
     remaining height (weight=1) and the Fragment distributes rows as
     equal vertical weights inside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/tile_grid_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:textColor="?attr/colorPrimary"
        android:textAllCaps="true"
        android:textAppearance="?attr/textAppearanceLabelMedium" />

    <TextView
        android:id="@+id/tile_grid_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:visibility="gone"
        android:text="@string/tile_grid_empty"
        android:textAppearance="?attr/textAppearanceLabelMedium" />

    <LinearLayout
        android:id="@+id/grid_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
