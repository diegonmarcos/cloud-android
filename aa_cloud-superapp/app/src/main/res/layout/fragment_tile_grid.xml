<?xml version="1.0" encoding="utf-8"?>
<!-- Tile grid host — scrollable. Tile height is fixed via item_tile.xml
     so single-row sections don't blow up into full-screen tiles
     (icons looked huge under the weighted auto-fit). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/tile_grid_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:textColor="?attr/colorPrimary"
            android:textAllCaps="true"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <TextView
            android:id="@+id/tile_grid_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/tile_grid_empty"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:id="@+id/grid_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
