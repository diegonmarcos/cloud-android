<?xml version="1.0" encoding="utf-8"?>
<!-- Tile grid host. The Fragment builds rows of N tiles programmatically into
     `grid_container` (LinearLayout vertical) — each row is a horizontal
     LinearLayout with weight=1 children. No GridLayout / RecyclerView dep
     needed for the ~10 tiles a section index has. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tile_grid_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/tile_grid_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/tile_grid_empty"
            android:textAppearance="?attr/textAppearanceLabelMedium" />

        <LinearLayout
            android:id="@+id/grid_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
