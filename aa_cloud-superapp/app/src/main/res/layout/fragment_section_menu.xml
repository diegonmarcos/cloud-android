<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer's section pane — site-map navigation for ONE section. Same
     NavigationView pattern as fragment_home_drawer (whole site), but
     scoped to the currently-open section. Items are added programma-
     tically from Sections.byId(sectionId).pages with their sub_pages
     expanded as a 2nd level. -->
<com.google.android.material.navigation.NavigationView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/section_navigation_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:itemMinHeight="44dp"
    app:itemHorizontalPadding="14dp"
    app:itemIconPadding="14dp"
    app:itemTextAppearance="?attr/textAppearanceBodyMedium"
    app:itemIconSize="26dp"
    app:subheaderInsetStart="8dp"
    app:dividerInsetStart="8dp" />
