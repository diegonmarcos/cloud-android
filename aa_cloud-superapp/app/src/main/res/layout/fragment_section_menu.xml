<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer's section pane — site-map navigation for ONE section. Same
     NavigationView pattern as fragment_home_drawer (whole site), but
     scoped to the currently-open section. Items are added programma-
     tically from Sections.byId(sectionId).pages with their sub_pages
     expanded as a 2nd level. -->
<com.google.android.material.navigation.NavigationView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/section_navigation_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    app:itemMinHeight="22dp"
    app:itemVerticalPadding="0dp"
    app:itemHorizontalPadding="10dp"
    app:itemIconPadding="8dp"
    app:itemTextAppearance="?attr/textAppearanceBodyMedium"
    app:itemTextColor="#FFE9D8FD"
    app:itemIconTint="#FFE9D8FD"
    app:itemBackground="@android:color/transparent"
    app:itemIconSize="18dp"
    app:subheaderColor="#CCB794F4"
    app:subheaderInsetStart="8dp"
    app:dividerInsetStart="8dp"
    app:itemShapeInsetTop="0dp"
    app:itemShapeInsetBottom="0dp"
    app:itemShapeInsetStart="0dp"
    app:itemShapeInsetEnd="0dp" />
