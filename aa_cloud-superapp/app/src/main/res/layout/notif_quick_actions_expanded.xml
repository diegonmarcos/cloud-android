<?xml version="1.0" encoding="utf-8"?>
<!-- Custom view for the NC Quick Actions notification so the action icons are
     CENTERED (MediaStyle left-aligns them). Each is a white icon on a circular
     accent pill (theme-proof). FloatingNavService binds icon + click intent
     per slot and hides the unused ones (3 collapsed / 5 expanded). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageButton android:id="@+id/qa_0"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
        android:padding="11dp"
        android:background="@drawable/bg_qa_pill"
        android:scaleType="fitCenter" android:contentDescription="@null" />
    <ImageButton android:id="@+id/qa_1"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
        android:padding="11dp"
        android:background="@drawable/bg_qa_pill"
        android:scaleType="fitCenter" android:contentDescription="@null" />
    <ImageButton android:id="@+id/qa_2"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
        android:padding="11dp"
        android:background="@drawable/bg_qa_pill"
        android:scaleType="fitCenter" android:contentDescription="@null" />
    <ImageButton android:id="@+id/qa_3"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
        android:padding="11dp"
        android:background="@drawable/bg_qa_pill"
        android:scaleType="fitCenter" android:contentDescription="@null" />
    <ImageButton android:id="@+id/qa_4"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
        android:padding="11dp"
        android:background="@drawable/bg_qa_pill"
        android:scaleType="fitCenter" android:contentDescription="@null" />
</LinearLayout>
