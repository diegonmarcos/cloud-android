<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- wg0 reachability probe + unicast/broadcast KDE Connect identity. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Enumerate networks to find + bind the native VPN (wg0) interface. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Surface pings + mirrored desktop notifications from paired devices
         (KdeNotifications). Runtime-requested by the host app on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Contacts sync (ContactsPlugin) + connectivity/signal report
         (ConnectivityReportPlugin). Runtime-gated: the plugins respond empty
         until the host app grants these, so the desktop never hangs. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- SMS sync (SmsPlugin), runtime-gated; reply empty until granted. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Package visibility for the explicit "Open KDE-Connect (App)" button
         (getLaunchIntentForPackage). Scoped — no QUERY_ALL_PACKAGES needed. -->
    <queries>
        <package android:name="org.kde.kdeconnect_tp" />
    </queries>

    <!-- Device-admin receiver for remote lock (LockDevicePlugin). Merged into
         the app's <application>. Inactive until the user enrolls it. -->
    <application>
        <receiver
            android:name="com.diegonmarcos.superapp.kdeconnect.KdeDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/kde_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
