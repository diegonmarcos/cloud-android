+<?xml version="1.0" encoding="utf-8"?>
+<!-- SuperApp addition (patch 0007) — labels for the emoji-surface type tabs
+     (row 1: Emoji / Sticker / GIF). Kept in a dedicated file, not upstream
+     strings.xml, so sync-heliboard's brand-rename never touches them and the
+     patch cleanly re-creates them after the rsync mirror. -->
+<resources>
+    <string name="emoji_type_tab_emoji">Emoji</string>
+    <string name="emoji_type_tab_sticker">Sticker</string>
+    <string name="emoji_type_tab_gif">GIF</string>
+</resources>
