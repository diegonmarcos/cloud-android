<helium314.keyboard.keyboard.emoji.EmojiPalettesView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:visibility="gone"
    android:background="@android:color/transparent"
    style="?attr/emojiPalettesViewStyle"
>
    <!-- patch 0010: ROW 0 — emoji search bar. Height is fixed (wrap_content ~40dp);
         EmojiLayoutParams already accounts for it because the pager height is set
         separately via setEmojiListProperties(). The bar is always visible above the pager. -->
    <EditText
        android:id="@+id/emoji_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textFilter"
        android:maxLines="1"
        android:padding="6dp"
        android:textSize="14sp"
        android:background="@android:color/transparent"
        android:hint="@string/emoji_search_hint" />

    <!-- SuperApp (patch 0007): ROW 1 — Emoji / Sticker / GIF type tabs. Hidden
         unless build.json::keyboard_media.enabled. Toggles the bodies below. -->
    <LinearLayout
        android:id="@+id/emoji_type_tab_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView android:id="@+id/emoji_type_tab_emoji"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:padding="10dp"
            android:textAllCaps="true" android:text="@string/emoji_type_tab_emoji" />
        <TextView android:id="@+id/emoji_type_tab_sticker"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:padding="10dp"
            android:textAllCaps="true" android:text="@string/emoji_type_tab_sticker" />
        <TextView android:id="@+id/emoji_type_tab_gif"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:padding="10dp"
            android:textAllCaps="true" android:text="@string/emoji_type_tab_gif" />
    </LinearLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/emoji_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <helium314.keyboard.keyboard.emoji.EmojiCategoryPageIndicatorView
        android:id="@+id/emoji_category_page_id_view"
        android:layout_width="match_parent"
        android:layout_height="2dip" />
    <!-- SuperApp (patch 0007): Sticker/GIF body (libs:media). Owns its own ROW 2
         (category tabs) internally. Height set in code to the emoji list height. -->
    <com.diegonmarcos.superapp.media.MediaPanelView
        android:id="@+id/media_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <helium314.keyboard.keyboard.MainKeyboardView
        android:id="@+id/bottom_row_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</helium314.keyboard.keyboard.emoji.EmojiPalettesView>
