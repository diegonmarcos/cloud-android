{
  "_doc": "Predefined firewall rule presets — DATA, not hardcoded in Kotlin (CLAUDE rule 6). Each preset is one atomic block condition: block `direction` traffic only while on one of `transports` AND in one of `energy` states. A per-app policy is a LIST of these (OR'd: a flow is blocked if ANY rule applies). The user assembles per-app policies from these building blocks; e.g. 'Wi-Fi only, no background' = [wifi-only] + [background]. direction IN/OUT is only ENFORCED once the firestack netstack lands (Phase 3); the current drain-engine treats any non-IN match as block-all and logs the limitation.",
  "_enums": {
    "direction": ["ALL", "IN", "OUT"],
    "transports": ["WIFI", "CELL", "VPN", "OTHER"],
    "energy": ["ACTIVE", "BACKGROUND"]
  },
  "presets": [
    { "id": "block-all",            "label": "Block all",               "block": "ALL", "transports": ["WIFI", "CELL", "VPN", "OTHER"], "energy": ["ACTIVE", "BACKGROUND"] },
    { "id": "block-incoming",       "label": "Block incoming",          "block": "IN",  "transports": ["WIFI", "CELL", "VPN", "OTHER"], "energy": ["ACTIVE", "BACKGROUND"] },
    { "id": "block-outgoing",       "label": "Block outgoing",          "block": "OUT", "transports": ["WIFI", "CELL", "VPN", "OTHER"], "energy": ["ACTIVE", "BACKGROUND"] },
    { "id": "wifi-only",            "label": "Wi-Fi only (block cell)", "block": "ALL", "transports": ["CELL", "OTHER"],                "energy": ["ACTIVE", "BACKGROUND"] },
    { "id": "vpn-only",             "label": "Cloud-VPN only",          "block": "ALL", "transports": ["WIFI", "CELL", "OTHER"],        "energy": ["ACTIVE", "BACKGROUND"] },
    { "id": "no-cell",             "label": "Never on cellular",        "block": "ALL", "transports": ["CELL"],                         "energy": ["ACTIVE", "BACKGROUND"] },
    { "id": "foreground-only",      "label": "Foreground only",         "block": "ALL", "transports": ["WIFI", "CELL", "VPN", "OTHER"], "energy": ["BACKGROUND"] },
    { "id": "no-cell-background",   "label": "No cellular in background","block": "ALL","transports": ["CELL"],                         "energy": ["BACKGROUND"] }
  ]
}
