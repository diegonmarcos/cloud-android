<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: without this a member cannot even see
         the minting app, so the token handshake fails with NameNotFound. One
         package, not QUERY_ALL_PACKAGES — the mesh only ever reads SuperApp. -->
    <queries>
        <package android:name="com.diegonmarcos.superapp" />
    </queries>

    <application>
        <provider
            android:name="com.diegonmarcos.superapp.devtools.DebugInitProvider"
            android:authorities="${applicationId}.devtools.debuginit"
            android:exported="false"
            android:initOrder="100" />

        <!-- The mesh handshake. Exported so siblings can reach it, gated on the
             CONSTELLATION_DATA permission that libs:core already declares
             signature-level for the AIDL engines — fleet membership is one
             concept, so it gets one permission. core depends on devtools, so
             the declaration always merges in above us. -->
        <provider
            android:name="com.diegonmarcos.superapp.devtools.FleetTokenProvider"
            android:authorities="${applicationId}.fleet"
            android:exported="true"
            android:permission="com.diegonmarcos.cloud.permission.CONSTELLATION_DATA" />
    </application>

</manifest>
