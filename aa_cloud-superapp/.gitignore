# ── Build output ──────────────────────────────────────────────
build/
.gradle/
.idea/
*.iml
local.properties
dist/
captures/
.externalNativeBuild/
.cxx/

# firestack netstack build artifacts (`build.sh firestack`). The parent
# unix/.gitignore force-includes libs/**, so the prebuilt aar + the pinned
# Go download cache must be re-ignored here (more-specific child rule wins).
libs/firewall/firestack/*.aar
libs/firewall/firestack/*.jar
libs/firewall/firestack/*.zip
.cache/golang/

# ── Nix ───────────────────────────────────────────────────────
# Anchored to the project root: the Nix build symlink is ./result here.
# Unanchored `result` also matched nested vendored source dirs named
# `result` (e.g. libs/keyboard HeliBoard jni .../suggest/core/result/),
# silently dropping their .cpp from commits → ndk-build "No rule to make".
/result
/result-*

# ── Secrets (signing keystore + sops) ────────────────────────
src/secrets.yaml.dec
*.keystore
*.jks
keystore.properties
dist/.secrets

# ── OS / IDE noise ────────────────────────────────────────────
.DS_Store
*.swp
*~
.vscode/

# ── Generated Gradle files (we ship a checked-in wrapper) ────
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat
