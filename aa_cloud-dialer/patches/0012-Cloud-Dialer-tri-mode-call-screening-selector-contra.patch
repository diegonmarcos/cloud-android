From e4cd99747c9de822ceadef9030d8d04e4a749db4 Mon Sep 17 00:00:00 2001
From: Diego <me@diegonmarcos.com>
Date: Fri, 3 Jul 2026 15:16:16 +0300
Subject: [PATCH 12/12] Cloud-Dialer: tri-mode call-screening selector
 (contract: build.json call_screening)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Settings ▸ Call screening ▸ 'Screening mode': contacts_only /
  block_known_spam / allow_all — replaces the single spam switch. Mode values
  mirror build.json::forks.dialer.call_screening.modes.
- Config.callScreeningMode is DERIVED over blockUnknownNumbers +
  blockKnownSpam (no third pref) so commons' blocked-numbers toggles stay in
  sync bidirectionally.
- App.onCreate seeds blockUnknownNumbers=true once (key-absence check) so the
  FIRST-RUN default == contacts_only per the owner contract; the user's later
  choice always wins.
---
 app/src/main/kotlin/org/fossify/phone/App.kt  | 10 +++++
 .../phone/activities/SettingsActivity.kt      | 38 ++++++++++++++-----
 .../org/fossify/phone/helpers/Config.kt       | 17 +++++++++
 .../org/fossify/phone/helpers/Constants.kt    |  6 +++
 app/src/main/res/layout/activity_settings.xml | 22 +++++++----
 app/src/main/res/values/strings.xml           |  7 +++-
 6 files changed, 82 insertions(+), 18 deletions(-)

diff --git a/app/src/main/kotlin/org/fossify/phone/App.kt b/app/src/main/kotlin/org/fossify/phone/App.kt
index 8a2e2b3d..19f4233e 100644
--- a/app/src/main/kotlin/org/fossify/phone/App.kt
+++ b/app/src/main/kotlin/org/fossify/phone/App.kt
@@ -2,6 +2,8 @@ package org.fossify.phone
 
 import org.fossify.commons.FossifyApp
 import org.fossify.commons.extensions.baseConfig
+import org.fossify.commons.extensions.getSharedPrefs
+import org.fossify.commons.helpers.BLOCK_UNKNOWN_NUMBERS
 import org.fossify.commons.helpers.SIDELOADING_FALSE
 
 /**
@@ -19,5 +21,13 @@ class App : FossifyApp() {
     override fun onCreate() {
         super.onCreate()
         baseConfig.appSideloadingStatus = SIDELOADING_FALSE
+
+        // First-run screening default = contacts_only, per the owner contract in
+        // build.json::forks.dialer.call_screening.default_mode: unknown numbers
+        // are silently rejected until the user picks another mode in Settings.
+        // Seed-once (key-absence check) so the user's later choice always wins.
+        if (!getSharedPrefs().contains(BLOCK_UNKNOWN_NUMBERS)) {
+            baseConfig.blockUnknownNumbers = true
+        }
     }
 }
