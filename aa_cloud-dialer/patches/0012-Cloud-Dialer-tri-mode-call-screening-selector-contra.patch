             ?: getString(R.string.always_ask)
     }
 
-    // Cloud Dialer: toggle the self-contained offline spam filter (patch 0007).
-    // Mirrors Fossify's other MyMaterialSwitch settings; wired to config.blockKnownSpam.
-    private fun setupBlockKnownSpam() {
-        binding.apply {
-            settingsBlockKnownSpam.isChecked = config.blockKnownSpam
-            settingsBlockKnownSpamHolder.setOnClickListener {
-                settingsBlockKnownSpam.toggle()
-                config.blockKnownSpam = settingsBlockKnownSpam.isChecked
+    // Cloud Dialer: tri-mode call screening selector, values from
+    // build.json::forks.dialer.call_screening.modes (contract). Backed by the
+    // derived Config.callScreeningMode over blockUnknownNumbers + blockKnownSpam,
+    // so commons' own blocked-numbers toggles stay consistent.
+    private fun setupScreeningMode() {
+        binding.settingsScreeningMode.text = getScreeningModeText()
+        binding.settingsScreeningModeHolder.setOnClickListener {
+            val items = arrayListOf(
+                RadioItem(0, getString(R.string.screening_contacts_only), SCREENING_CONTACTS_ONLY),
+                RadioItem(1, getString(R.string.screening_block_known_spam), SCREENING_BLOCK_KNOWN_SPAM),
+                RadioItem(2, getString(R.string.screening_allow_all), SCREENING_ALLOW_ALL),
+            )
+
+            val checkedId = items.firstOrNull { it.value == config.callScreeningMode }?.id ?: 0
+            RadioGroupDialog(this@SettingsActivity, items, checkedId) {
+                config.callScreeningMode = it as String
+                binding.settingsScreeningMode.text = getScreeningModeText()
             }
         }
     }
 
+    private fun getScreeningModeText(): String = getString(
+        when (config.callScreeningMode) {
+            SCREENING_CONTACTS_ONLY -> R.string.screening_contacts_only
+            SCREENING_BLOCK_KNOWN_SPAM -> R.string.screening_block_known_spam
+            else -> R.string.screening_allow_all
+        }
+    )
+
     // Cloud Dialer: manual "Check for updates" entry point for the self-contained
     // GHCR/WorkManager updater. The label shows the running version; tapping runs
     // a one-shot check (Updater.checkNow) that installs a newer GHCR build.
diff --git a/app/src/main/kotlin/org/fossify/phone/helpers/Config.kt b/app/src/main/kotlin/org/fossify/phone/helpers/Config.kt
index 92bc1b90..f57f5544 100644
--- a/app/src/main/kotlin/org/fossify/phone/helpers/Config.kt
+++ b/app/src/main/kotlin/org/fossify/phone/helpers/Config.kt
@@ -144,6 +144,23 @@ class Config(context: Context) : BaseConfig(context) {
         get() = prefs.getBoolean(BLOCK_KNOWN_SPAM, true)
         set(blockKnownSpam) = prefs.edit().putBoolean(BLOCK_KNOWN_SPAM, blockKnownSpam).apply()
 
+    // Cloud Dialer: single tri-mode view over the two screening prefs, per
+    // build.json::forks.dialer.call_screening.modes. DERIVED — no third pref,
+    // so commons' own blocked-numbers toggles stay in sync automatically.
+    //   contacts_only    → blockUnknownNumbers=true  (non-contacts silently rejected)
+    //   block_known_spam → blockUnknownNumbers=false, blockKnownSpam=true
+    //   allow_all        → both false
+    var callScreeningMode: String
+        get() = when {
+            blockUnknownNumbers -> SCREENING_CONTACTS_ONLY
+            blockKnownSpam -> SCREENING_BLOCK_KNOWN_SPAM
+            else -> SCREENING_ALLOW_ALL
+        }
+        set(mode) {
+            blockUnknownNumbers = mode == SCREENING_CONTACTS_ONLY
+            blockKnownSpam = mode != SCREENING_ALLOW_ALL
+        }
+
     // Cloud Dialer: how outgoing calls are placed. "" = always show the provider
     // chooser; CALL_PROVIDER_CELLULAR = always plain cellular; any other value =
     // a provider id from assets/call_providers.json (fail-open to the chooser
