From c1e7f0891dc90bb94a7bb2da08fce687c599d869 Mon Sep 17 00:00:00 2001
From: Diego Nepomuceno Marcos <me@diegonmarcos.com>
Date: Wed, 1 Jul 2026 12:34:16 +0200
Subject: [PATCH 06/12] Cloud-Dialer: unique applicationId
 (com.diegonmarcos.comms.dialer) to hold the default-Phone role
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The rebrand only changed the launcher label; the APK still installed as
org.fossify.phone, colliding with the stock Fossify Phone identity — Android
then refused to grant our build the default-Phone-app (ROLE_DIALER) role.
applicationId now comes from -PAPPLICATION_ID (build.json gradle_props), giving
the fork its own package that matches forks.dialer.app_id. namespace (R/
BuildConfig package) stays org.fossify.phone so the code/manifest are unchanged.
---
 app/build.gradle.kts | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 8b40b103..54022b9e 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -27,7 +27,14 @@ android {
     compileSdk = project.libs.versions.app.build.compileSDKVersion.get().toInt()
 
     defaultConfig {
-        applicationId = project.property("APP_ID").toString()
+        // Cloud Dialer: the INSTALLED package id. Defaults to APP_ID (stock
+        // org.fossify.phone) but the engine passes -PAPPLICATION_ID=
+        // com.diegonmarcos.comms.dialer (build.json::forks.dialer.build.gradle_props)
+        // so our fork has its OWN unique package — it never collides with a
+        // stock Fossify Phone install, which is what let Android grant it the
+        // default-Phone-app (ROLE_DIALER) role. The `namespace` (R/BuildConfig
+        // package) intentionally stays APP_ID = org.fossify.phone (the code pkg).
+        applicationId = (project.findProperty("APPLICATION_ID") ?: project.property("APP_ID")).toString()
         minSdk = project.libs.versions.app.build.minimumSDK.get().toInt()
         targetSdk = project.libs.versions.app.build.targetSDK.get().toInt()
         versionName = project.property("VERSION_NAME").toString()
