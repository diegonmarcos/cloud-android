     private var screenOnWakeLock: PowerManager.WakeLock? = null
     private var callDuration = 0
@@ -589,6 +598,19 @@ class CallActivity : SimpleActivity() {
                 callerNumber.beGone()
             }
 
+            // Cloud Dialer (patch 0014): warn about suspected-spam numbers that
+            // screening let through (allow_all / spam filter off), so the user
+            // can decline before answering.
+            val spamRule = SpamMatcher.match(number, spamRules)
+            callerSpamWarning.beVisibleIf(spamRule != null)
+            if (spamRule != null) {
+                callerSpamWarning.text = if (spamRule.category.isEmpty()) {
+                    getString(R.string.suspected_spam)
+                } else {
+                    "${getString(R.string.suspected_spam)} · ${spamRule.category}"
+                }
+            }
