From a8e56d8de83095d862de2115a3f7ea8f85f6aab4 Mon Sep 17 00:00:00 2001
From: cloud-comms-engine <engine@diegonmarcos.com>
Date: Fri, 26 Jun 2026 22:38:17 +0200
Subject: [PATCH 04/14] Cloud Dialer: route contact-suggestion and recents taps
 through provider chooser

Dialpad contact-suggestion tap (primary number, falls back to multi-number flow when null)
and recents item/menu default call now go through startCallWithProviderChooser. Explicit
'call with SIM N' actions are left untouched (deliberate SIM selection).
---
 .../org/fossify/phone/activities/DialpadActivity.kt       | 8 +++++++-
 .../org/fossify/phone/adapters/RecentCallsAdapter.kt      | 3 ++-
 .../kotlin/org/fossify/phone/fragments/RecentsFragment.kt | 3 ++-
 3 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/app/src/main/kotlin/org/fossify/phone/activities/DialpadActivity.kt b/app/src/main/kotlin/org/fossify/phone/activities/DialpadActivity.kt
index c6dd23e7..35a3f373 100644
--- a/app/src/main/kotlin/org/fossify/phone/activities/DialpadActivity.kt
+++ b/app/src/main/kotlin/org/fossify/phone/activities/DialpadActivity.kt
@@ -340,7 +340,13 @@ class DialpadActivity : SimpleActivity() {
             recyclerView = binding.dialpadList,
             highlightText = text,
             itemClick = {
-                startCallWithConfirmationCheck(it as Contact)
+                val contact = it as Contact
+                val number = contact.getPrimaryNumber()
+                if (number != null) {
+                    startCallWithProviderChooser(number, contact.getNameToDisplay())
+                } else {
+                    startCallWithConfirmationCheck(contact)
+                }
                 clearInputWithDelay()
             },
             profileIconClick = {
diff --git a/app/src/main/kotlin/org/fossify/phone/adapters/RecentCallsAdapter.kt b/app/src/main/kotlin/org/fossify/phone/adapters/RecentCallsAdapter.kt
index 67c57460..f956d664 100644
--- a/app/src/main/kotlin/org/fossify/phone/adapters/RecentCallsAdapter.kt
+++ b/app/src/main/kotlin/org/fossify/phone/adapters/RecentCallsAdapter.kt
@@ -60,6 +60,7 @@ import org.fossify.phone.extensions.config
 import org.fossify.phone.extensions.getDayCode
 import org.fossify.phone.extensions.startAddContactIntent
 import org.fossify.phone.extensions.startCallWithConfirmationCheck
+import org.fossify.phone.extensions.startCallWithProviderChooser
 import org.fossify.phone.extensions.startContactDetailsIntent
 import org.fossify.phone.helpers.RecentsHelper
 import org.fossify.phone.interfaces.RefreshItemsListener
@@ -227,7 +228,7 @@ class RecentCallsAdapter(
         val phoneNumber = getSelectedPhoneNumber() ?: return
         val name = getSelectedName() ?: return
 
-        (activity as SimpleActivity).startCallWithConfirmationCheck(phoneNumber, name)
+        (activity as SimpleActivity).startCallWithProviderChooser(phoneNumber, name)
     }
 
     private fun removeDefaultSIM() {
diff --git a/app/src/main/kotlin/org/fossify/phone/fragments/RecentsFragment.kt b/app/src/main/kotlin/org/fossify/phone/fragments/RecentsFragment.kt
index 5f794565..ab5dad3a 100644
--- a/app/src/main/kotlin/org/fossify/phone/fragments/RecentsFragment.kt
+++ b/app/src/main/kotlin/org/fossify/phone/fragments/RecentsFragment.kt
@@ -25,6 +25,7 @@ import org.fossify.phone.extensions.config
 import org.fossify.phone.extensions.runAfterAnimations
 import org.fossify.phone.extensions.startAddContactIntent
 import org.fossify.phone.extensions.startCallWithConfirmationCheck
+import org.fossify.phone.extensions.startCallWithProviderChooser
 import org.fossify.phone.extensions.startContactDetailsIntent
 import org.fossify.phone.helpers.RecentsHelper
 import org.fossify.phone.interfaces.RefreshItemsListener
@@ -165,7 +166,7 @@ class RecentsFragment(
                     },
                     itemClick = {
                         val recentCall = it as RecentCall
-                        activity?.startCallWithConfirmationCheck(recentCall.phoneNumber, recentCall.name)
+                        activity?.startCallWithProviderChooser(recentCall.phoneNumber, recentCall.name)
                     },
                     profileIconClick = {
                         val recentCall = it as RecentCall
-- 
