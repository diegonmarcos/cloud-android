+    // Cloud Dialer: "Default call provider" — how outgoing calls are placed.
+    // "" = always show the provider chooser sheet; cellular = never ask;
+    // otherwise a provider id from assets/call_providers.json (only installed
+    // providers are offered). Value semantics live in Config.defaultCallProvider.
+    private fun setupDefaultCallProvider() {
+        binding.settingsDefaultCallProvider.text = getDefaultCallProviderText()
+        binding.settingsDefaultCallProviderHolder.setOnClickListener {
+            val providers = loadCallProviders(this).filter { isPackageInstalled(this, it.packageName) }
+            val items = arrayListOf(
+                RadioItem(0, getString(R.string.always_ask), ""),
+                RadioItem(1, getString(R.string.call_via_cellular), CALL_PROVIDER_CELLULAR),
+            )
+            providers.forEachIndexed { index, provider ->
+                items.add(RadioItem(index + 2, provider.label, provider.id))
+            }
+
+            val checkedId = items.firstOrNull { it.value == config.defaultCallProvider }?.id ?: 0
+            RadioGroupDialog(this@SettingsActivity, items, checkedId) {
+                config.defaultCallProvider = it as String
+                binding.settingsDefaultCallProvider.text = getDefaultCallProviderText()
+            }
+        }
+    }
+
+    private fun getDefaultCallProviderText(): String = when (val default = config.defaultCallProvider) {
+        "" -> getString(R.string.always_ask)
+        CALL_PROVIDER_CELLULAR -> getString(R.string.call_via_cellular)
+        else -> loadCallProviders(this).firstOrNull { it.id == default }?.label
+            ?: getString(R.string.always_ask)
+    }
