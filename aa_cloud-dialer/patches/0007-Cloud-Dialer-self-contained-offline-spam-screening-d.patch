+{
+  "_doc": "Cloud Dialer self-contained offline spam list. Grounded in the FOSS call-blocker model (SpamBlocker aj3423, Yet Another Call Blocker xynngh): each rule matches an incoming number by exact value, dialling prefix, or regex. Fully offline — no network, no server. The in-app updater (GHCR/WorkManager) ships newer versions of this asset with app updates. Keep entries conservative: false positives silently reject real calls. Numbers are E.164-ish (leading +, digits only after normalisation).",
+  "version": 1,
+  "rules": [
+    { "type": "prefix", "value": "+8809", "category": "premium-rate" },
+    { "type": "prefix", "value": "+889", "category": "premium-rate" },
+    { "type": "prefix", "value": "+37256", "category": "premium-rate" },
+    { "type": "regex", "value": "^\\+?1?900\\d{7}$", "category": "premium-rate-us-900" },
+    { "type": "regex", "value": "^\\+?44(9[08])\\d{7}$", "category": "premium-rate-uk" }
+  ]
+}
