From e5be512ce6c9c10c9a9f93b52d0b56a25d5c6065 Mon Sep 17 00:00:00 2001
From: Diego <me@diegonmarcos.com>
Date: Fri, 3 Jul 2026 15:04:22 +0300
Subject: [PATCH 08/12] Cloud-Dialer: remove commons anti-repackage 'fake app'
 dialog (false positive on our fork)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

commons' checkAppSideloading() flags any repackaged build and CACHES the verdict
forever in baseConfig.appSideloadingStatus — on-device it fired the
'You are using a fake version of the app… fossify.org' dialog because our
applicationId is com.diegonmarcos.comms.dialer by design (patch 0006).

- DialpadActivity: drop the only checkAppSideloading() call site.
- New App : FossifyApp (manifest application name) pins
  appSideloadingStatus = SIDELOADING_FALSE on start, healing devices that
  already persisted SIDELOADING_TRUE from earlier builds.
---
 app/src/main/AndroidManifest.xml              |  2 +-
 app/src/main/kotlin/org/fossify/phone/App.kt  | 23 +++++++++++++++++++
 .../phone/activities/DialpadActivity.kt       |  7 +++---
 3 files changed, 27 insertions(+), 5 deletions(-)
 create mode 100644 app/src/main/kotlin/org/fossify/phone/App.kt

diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index 33f90a0e..b976e0d2 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -40,7 +40,7 @@
     </queries>
 
     <application
-        android:name="org.fossify.commons.FossifyApp"
+        android:name="org.fossify.phone.App"
         android:allowBackup="true"
         android:appCategory="productivity"
         android:icon="@mipmap/ic_launcher"
diff --git a/app/src/main/kotlin/org/fossify/phone/App.kt b/app/src/main/kotlin/org/fossify/phone/App.kt
new file mode 100644
index 00000000..8a2e2b3d
--- /dev/null
+++ b/app/src/main/kotlin/org/fossify/phone/App.kt
@@ -0,0 +1,23 @@
+package org.fossify.phone
+
+import org.fossify.commons.FossifyApp
+import org.fossify.commons.extensions.baseConfig
+import org.fossify.commons.helpers.SIDELOADING_FALSE
+
+/**
+ * Cloud Dialer application class (extends commons' FossifyApp).
+ *
+ * Commons caches its anti-repackage verdict forever in
+ * [org.fossify.commons.helpers.BaseConfig.appSideloadingStatus]; devices that ran
+ * an earlier build may still hold SIDELOADING_TRUE and would keep showing the
+ * "fake version of the app" dialog even after the check's call site is removed.
+ * Pin the flag to FALSE on every start — this fork is intentionally repackaged
+ * (applicationId com.diegonmarcos.comms.dialer), so the verdict is a false
+ * positive by construction.
+ */
+class App : FossifyApp() {
+    override fun onCreate() {
+        super.onCreate()
+        baseConfig.appSideloadingStatus = SIDELOADING_FALSE
+    }
+}
diff --git a/app/src/main/kotlin/org/fossify/phone/activities/DialpadActivity.kt b/app/src/main/kotlin/org/fossify/phone/activities/DialpadActivity.kt
index 35a3f373..8c1efea0 100644
