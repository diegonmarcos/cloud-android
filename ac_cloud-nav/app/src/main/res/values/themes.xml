<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Forced DARK (not DayNight) — Cloud Nav is a dark-mode app: the map
         (dark/vector basemap) and the chrome (bars / nav / timeline / cards)
         are one cohesive dark surface, regardless of the system setting. -->
    <style name="Theme.CloudNav" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/nav_primary</item>
        <item name="colorOnPrimary">@color/nav_on_primary</item>
        <item name="colorPrimaryContainer">@color/nav_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/nav_on_primary_container</item>
        <item name="colorSecondary">@color/nav_secondary</item>
        <item name="colorSecondaryContainer">@color/nav_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/nav_on_secondary_container</item>

        <item name="android:colorBackground">@color/nav_surface</item>
        <item name="colorSurface">@color/nav_surface</item>
        <item name="colorSurfaceContainer">@color/nav_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/nav_surface_container_high</item>
        <item name="colorOnSurface">@color/nav_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/nav_on_surface_variant</item>
        <item name="colorOutline">@color/nav_outline</item>

        <item name="android:statusBarColor" tools:targetApi="lollipop">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="lollipop">true</item>
        <!-- Dark surface → LIGHT status/nav icons. -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
