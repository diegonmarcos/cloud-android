<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Loopback only: the terminal is another app on this device. Nothing is
         contacted off the phone, and there is no cleartext exception because
         ssh is not http. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Our Termux's exec service. Declared by the terminal at signature
         level, so the system grants it silently to an APK signed with the
         constellation key and to nothing else — there is no runtime request
         and no dialog. -->
    <uses-permission android:name="com.termux.permission.CLOUD_EXEC" />

    <!-- WITHOUT THIS THE BIND SILENTLY FAILS.
         Since Android 11 an app cannot see another package unless it declares
         it, and the failure is not an error: resolveService returns null and
         bindService returns false, exactly as they would if Termux were not
         installed. That is the same indistinguishable-failure trap the ssh
         path fell into, so the query is spelled out rather than inferred. -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="com.termux.nix" />
    </queries>

    <application
        android:label="Watchdog"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Watchdog">
        <activity
            android:name="com.diegonmarcos.watchdog.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
