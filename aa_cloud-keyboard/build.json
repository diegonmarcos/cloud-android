{
  "name": "cloud-keyboard",
  "description": "Cloud Keyboard — HeliBoard IME with on-device translation, voice input, and bundled sticker packs. Standalone constellation APK.",
  "category": "keyboard",
  "toolchain": {
    "agp": "8.13.2",
    "gradle": "8.14",
    "kotlin": "2.3.20",
    "compile_sdk": 36,
    "jdk": "17"
  },
  "modules": {
    "_doc": "Keyboard libs are shared from ../ea_cloud-superapp/libs/ via relative project references in settings.gradle.",
    "app": {
      "type": "application",
      "depends_on": ["libs:keyboard", "libs:media", "libs:translate", "libs:voice"],
      "comment": "Thin application shell. All IME components (LatinIME, SpellChecker, Settings, sticker panel, translate, voice) come from the shared keyboard libs via manifest merge."
    }
  },
  "keyboard_media": {
    "_doc": "Same block as ea_cloud-superapp — shared vault secret. build.sh sops-decrypts vault_secrets → TENOR_API_KEY/GIPHY_API_KEY env vars → Gradle BuildConfig → MediaRuntime.configure().",
    "vault_secrets": "A0_keys/providers/keyboard-media/secrets.yaml",
    "enabled": true,
    "sticker": { "enabled": true },
    "gif": {
      "provider": "giphy",
      "limit": 30,
      "giphy": {
        "base_url": "https://api.giphy.com/v1/gifs",
        "categories": [
          { "id": "trending",  "label": "Trending",   "query": ""         },
          { "id": "reactions", "label": "Reactions",  "query": "reaction" },
          { "id": "love",      "label": "Love",       "query": "love"     },
          { "id": "happy",     "label": "Happy",      "query": "happy"    },
          { "id": "sad",       "label": "Sad",        "query": "sad"      },
          { "id": "celebrate", "label": "Celebrate",  "query": "celebrate"}
        ]
      }
    }
  },
  "release": {
    "artifact": {
      "debug": "Cloud-Keyboard.apk",
      "release": "Cloud-Keyboard-release.apk"
    },
    "ghcr": {
      "enabled": true,
      "registry": "ghcr.io",
      "namespace": "diegonmarcos",
      "image": "cloud-keyboard",
      "media_type": "application/vnd.android.package-archive",
      "tags": ["latest", "sha-{sha}", "v{version_name}"]
    },
    "gh_release": {
      "enabled": true,
      "rolling_tag": "latest",
      "tag_pattern": "ea_cloud-keyboard-v*",
      "asset_name": "Cloud-Keyboard.apk",
      "draft": false,
      "prerelease": false,
      "generate_release_notes": false
    }
  }
}
