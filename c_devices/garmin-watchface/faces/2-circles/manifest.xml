<?xml version="1.0" encoding="UTF-8"?>
<!--
  "2 Circles" watch-face design — Connect IQ manifest.
  id (uuid) is the stable CIQ app identity (mirrors faces/2-circles/design.json::uuid).
  type=watchface, no permissions, no settings (faithful to the original).
  Product target is the canonical device from ../../build.json::devices.targets
  (fenix8pro47mm = fenix 8 Pro 47/51mm/MicroLED, 454x454 round). Add more <iq:product>
  lines here to widen device support — keep them in sync with build.json::devices.
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="TwoCirclesApp"
        id="0474dda677ae41e397b6884865fcdb2f"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0"
        name="@Strings.AppName"
        type="watchface">
        <iq:products>
            <iq:product id="fenix8pro47mm"/>
        </iq:products>
        <iq:permissions/>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
