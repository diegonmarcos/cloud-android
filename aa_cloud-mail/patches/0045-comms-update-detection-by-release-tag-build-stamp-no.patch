From 9c68dd03b230be477c96d3fe1959114f7a003436 Mon Sep 17 00:00:00 2001
From: Diego <me@diegonmarcos.com>
Date: Wed, 8 Jul 2026 13:13:41 +0300
Subject: [PATCH] comms: update detection by release-tag build stamp, not
 published_at
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Every CI APK baked COMMS_BUILD_TIMESTAMP="dev" because the workflow never
exported the env var — the engine's $ENV fallback — so the updater's first
guard ('dev' = local build, skip) short-circuited to 'up to date' on every
installed build. Detection was permanently dead.

Comparing against published_at would also self-loop: the release is published
minutes AFTER the build, so every app would see its own release as newer.
CI now computes ONE stamp (YYYYMMDD.HHMMSS) used both as the baked
COMMS_BUILD_TIMESTAMP and the release-tag suffix; the app parses the stamp
after the tag's last '-' and compares lexicographically — an APK exactly
equals its own release.
---
 .../eu/faircode/email/CommsUpdateWorker.java  | 30 +++++++++++--------
 .../email/FragmentOptionsCommsAbout.java      |  6 ++--
 2 files changed, 20 insertions(+), 16 deletions(-)

diff --git a/app/src/main/java/eu/faircode/email/CommsUpdateWorker.java b/app/src/main/java/eu/faircode/email/CommsUpdateWorker.java
index 563e62a0b9..3771be2acf 100644
--- a/app/src/main/java/eu/faircode/email/CommsUpdateWorker.java
+++ b/app/src/main/java/eu/faircode/email/CommsUpdateWorker.java
@@ -21,8 +21,10 @@ package eu.faircode.email;
 
 // comms: self-updater — checks the GitHub Releases API for a new Cloud Mail
 // build every 6h and on every app open (throttled to 1h). Detects updates by
-// comparing the release published_at ISO-8601 timestamp against
-// BuildConfig.COMMS_BUILD_TIMESTAMP baked into the APK at CI time.
+// comparing the build stamp embedded in the release TAG (cloud-comms-mail-
+// YYYYMMDD.HHMMSS) against BuildConfig.COMMS_BUILD_TIMESTAMP — CI computes ONE
+// BUILD_DATE and uses it for both, so an APK exactly equals its own release
+// (published_at would be minutes later than the build → self-update loop).
 // Downloads directly from the release asset URL — no GHCR token needed.
 //
 // Wire: ApplicationEx calls init(this) after WorkerAutoUpdate.init(this).
@@ -79,10 +81,10 @@ public class CommsUpdateWorker extends Worker {
 
     /** Metadata returned by the GitHub Releases API for the latest release. */
     static class ReleaseMeta {
-        final String publishedAt;  // ISO-8601, e.g. "2026-07-04T12:00:00Z"
+        final String buildStamp;   // YYYYMMDD.HHMMSS from the tag — same string CI bakes into COMMS_BUILD_TIMESTAMP
         final String downloadUrl;  // browser_download_url of the matching APK asset
-        ReleaseMeta(String publishedAt, String downloadUrl) {
-            this.publishedAt = publishedAt;
+        ReleaseMeta(String buildStamp, String downloadUrl) {
+            this.buildStamp = buildStamp;
             this.downloadUrl = downloadUrl;
         }
     }
@@ -94,15 +96,15 @@ public class CommsUpdateWorker extends Worker {
         try {
             Log.i(TAG + " checking GitHub Releases for update");
             ReleaseMeta rel = fetchLatestRelease();
-            // ISO-8601 strings sort lexicographically in the same order as time.
+            // YYYYMMDD.HHMMSS sorts lexicographically in time order.
             // BuildConfig.COMMS_BUILD_TIMESTAMP == "dev" when built locally — skip.
             String installed = BuildConfig.COMMS_BUILD_TIMESTAMP;
-            if ("dev".equals(installed) || rel.publishedAt.compareTo(installed) <= 0) {
+            if ("dev".equals(installed) || rel.buildStamp.compareTo(installed) <= 0) {
                 Log.i(TAG + " up to date (installed=" + installed
-                        + " remote=" + rel.publishedAt + ")");
+                        + " remote=" + rel.buildStamp + ")");
                 return Result.success();
             }
-            Log.i(TAG + " update available: published=" + rel.publishedAt
+            Log.i(TAG + " update available: remote=" + rel.buildStamp
                     + " > installed=" + installed);
             notifyUpdate(ctx);
             return Result.success();
@@ -115,7 +117,7 @@ public class CommsUpdateWorker extends Worker {
     // ── GitHub Releases helpers — package-private for FragmentOptionsCommsAbout ──
 
     /**
-     * Fetches the latest GitHub Release and returns its publish timestamp + APK asset URL.
+     * Fetches the latest GitHub Release and returns its tag build stamp + APK asset URL.
      * Public repo — no auth needed. Throws if the asset named
      * BuildConfig.COMMS_RELEASE_ASSET_NAME is absent from the release.
      */
@@ -132,7 +134,9 @@ public class CommsUpdateWorker extends Worker {
             if (c.getResponseCode() != 200)
                 throw new IOException("GitHub releases HTTP " + c.getResponseCode());
             JSONObject rel = new JSONObject(slurp(c.getInputStream()));
-            String publishedAt = rel.getString("published_at");
+            // tag = cloud-comms-<fork>-YYYYMMDD.HHMMSS → stamp after last '-'
+            String tag = rel.getString("tag_name");
+            String buildStamp = tag.substring(tag.lastIndexOf('-') + 1);
             JSONArray assets = rel.getJSONArray("assets");
             String downloadUrl = null;
             for (int i = 0; i < assets.length(); i++) {
@@ -144,8 +148,8 @@ public class CommsUpdateWorker extends Worker {
             }
             if (downloadUrl == null)
                 throw new IOException("asset '" + BuildConfig.COMMS_RELEASE_ASSET_NAME
-                        + "' not found in release " + publishedAt);
-            return new ReleaseMeta(publishedAt, downloadUrl);
+                        + "' not found in release " + tag);
+            return new ReleaseMeta(buildStamp, downloadUrl);
         } finally {
             c.disconnect();
         }
diff --git a/app/src/main/java/eu/faircode/email/FragmentOptionsCommsAbout.java b/app/src/main/java/eu/faircode/email/FragmentOptionsCommsAbout.java
index 6850e780c9..004dfa2212 100644
--- a/app/src/main/java/eu/faircode/email/FragmentOptionsCommsAbout.java
+++ b/app/src/main/java/eu/faircode/email/FragmentOptionsCommsAbout.java
@@ -80,10 +80,10 @@ public class FragmentOptionsCommsAbout extends FragmentBase {
             @Override
             protected File onExecute(Context ctx, Bundle args) throws Throwable {
                 CommsUpdateWorker.ReleaseMeta rel = CommsUpdateWorker.fetchLatestRelease();
-                // Same comparison as CommsUpdateWorker.doWork: ISO-8601 sorts
-                // lexicographically; "dev" = local build, treat as up to date.
+                // Same comparison as CommsUpdateWorker.doWork: tag build stamps
+                // (YYYYMMDD.HHMMSS) sort lexicographically; "dev" = local build.
                 String installed = BuildConfig.COMMS_BUILD_TIMESTAMP;
-                if ("dev".equals(installed) || rel.publishedAt.compareTo(installed) <= 0)
+                if ("dev".equals(installed) || rel.buildStamp.compareTo(installed) <= 0)
                     return null; // null = up to date
 
                 File dest = new File(ctx.getCacheDir(), "updates/cloud-mail-update.apk");
-- 
2.44.2

