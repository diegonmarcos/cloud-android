From 90c23698cfbda0c91a8458476a01a2dfab4be0cc Mon Sep 17 00:00:00 2001
From: cloud-comms-engine <engine@diegonmarcos.com>
Date: Tue, 23 Jun 2026 14:37:19 +0300
Subject: [PATCH] comms: add TYPE_JMAP + TYPE_RSS account protocol constants

Schema-safe: 'protocol' reuses the existing integer 'pop' column, so new
protocol values need no DB migration. Foundation for the JMAP transport
and RSS-reader patches that follow.
---
 app/src/main/java/eu/faircode/email/EntityAccount.java | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/app/src/main/java/eu/faircode/email/EntityAccount.java b/app/src/main/java/eu/faircode/email/EntityAccount.java
index ad1a700d17..c722a710e4 100644
--- a/app/src/main/java/eu/faircode/email/EntityAccount.java
+++ b/app/src/main/java/eu/faircode/email/EntityAccount.java
@@ -63,6 +63,8 @@ public class EntityAccount extends EntityOrder implements Serializable {
 
     static final int TYPE_IMAP = 0;
     static final int TYPE_POP = 1;
+    static final int TYPE_JMAP = 2; // comms: native JMAP transport
+    static final int TYPE_RSS = 3;  // comms: synthetic local account hosting RSS feed folders
 
     @PrimaryKey(autoGenerate = true)
     public Long id;
