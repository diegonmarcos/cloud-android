Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 .../java/eu/faircode/email/EmailService.java  | 31 +++++++++++++++++++
 .../java/eu/faircode/email/JmapService.java   | 13 ++++++--
 2 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/app/src/main/java/eu/faircode/email/EmailService.java b/app/src/main/java/eu/faircode/email/EmailService.java
index cc0f45d127..048bb304b1 100644
--- a/app/src/main/java/eu/faircode/email/EmailService.java
+++ b/app/src/main/java/eu/faircode/email/EmailService.java
@@ -116,6 +116,7 @@ public class EmailService implements AutoCloseable {
     private Properties properties;
     private Session isession;
     private Service iservice;
+    private JmapService jmapService; // comms: parallel JMAP path; iservice stays null for JMAP accounts
     private StoreListener listener;
     private ServiceAuthenticator authenticator;
     private RingBuffer<String> breadcrumbs;
@@ -975,6 +976,17 @@ public class EmailService implements AutoCloseable {
                 } else
                     throw ex;
             }
+        } else if ("jmap".equals(protocol)) {
+            // comms batch 2: JMAP does not fit Jakarta's Store/Transport model,
+            // so it runs on a parallel field. iservice intentionally stays null;
+            // nothing after this branch dereferences iservice for JMAP.
+            // The password lives in the authenticator (set before connect());
+            // pull it back out here to hand to the JMAP client.
+            String jpassword = authenticator == null ? null
+                    : authenticator.getPasswordAuthentication().getPassword();
+            jmapService = new JmapService(context, host, port, user);
+            jmapService.connect(jpassword);
+
         } else
             throw new NoSuchProviderException(protocol);
     }
@@ -1038,7 +1050,15 @@ public class EmailService implements AutoCloseable {
         return (SMTPTransport) iservice;
     }
 
+    JmapService getJmapService() {
+        return jmapService;
+    }
+
     Long getMaxSize() throws MessagingException {
+        // comms: JMAP has no Jakarta Store/Transport; no SIZE extension here
+        if (jmapService != null)
+            return null;
+
         // https://support.google.com/mail/answer/6584#limit
 
         String size;
@@ -1063,6 +1083,10 @@ public class EmailService implements AutoCloseable {
     List<String> getCapabilities() throws MessagingException {
         List<String> result = new ArrayList<>();
 
+        // comms: JMAP capabilities resolved from the session in a later batch
+        if (jmapService != null)
+            return result;
+
         // https://www.iana.org/assignments/imap-capabilities/imap-capabilities.xhtml
 
         Map<String, String> capabilities;
@@ -1082,6 +1106,9 @@ public class EmailService implements AutoCloseable {
     }
 
     boolean hasCapability(String capability) throws MessagingException {
+        // comms: JMAP capability/IDLE handling lands in a later batch
+        if (jmapService != null)
+            return false;
         Store store = getStore();
         if (store instanceof IMAPStore)
             return ((IMAPStore) getStore()).hasCapability(capability);
@@ -1101,6 +1128,10 @@ public class EmailService implements AutoCloseable {
         try {
             if (iservice != null && iservice.isConnected())
                 iservice.close();
+            if (jmapService != null) {
+                jmapService.close();
+                jmapService = null;
+            }
             if (authenticator != null)
                 authenticator = null;
         } finally {
diff --git a/app/src/main/java/eu/faircode/email/JmapService.java b/app/src/main/java/eu/faircode/email/JmapService.java
index 05d16ce83d..c26275842d 100644
--- a/app/src/main/java/eu/faircode/email/JmapService.java
+++ b/app/src/main/java/eu/faircode/email/JmapService.java
@@ -39,10 +39,17 @@ public class JmapService {
     private JmapClient client;
 
     JmapService(Context context, EntityAccount account) {
+        this(context, account.host, account.port, account.user);
+    }
+
+    // comms batch 2: invoked from EmailService.connect()'s protocol dispatch,
+    // where only the resolved host/port/user are in scope (not the
+    // EntityAccount). The password is supplied separately to connect().
+    JmapService(Context context, String host, Integer port, String user) {
         this.context = context.getApplicationContext();
-        this.host = account.host;
-        this.port = (account.port == null ? 443 : account.port);
-        this.user = account.user;
+        this.host = host;
+        this.port = (port == null ? 443 : port);
+        this.user = user;
     }
 
     // Open a JMAP client for the account and validate it by resolving the
