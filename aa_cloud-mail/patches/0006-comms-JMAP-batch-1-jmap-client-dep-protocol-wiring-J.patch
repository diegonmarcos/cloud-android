+import android.content.Context;
+
+import javax.mail.MessagingException;
+
+import okhttp3.HttpUrl;
+import rs.ltt.jmap.client.JmapClient;
+import rs.ltt.jmap.client.session.Session;
+
+// comms: thin JMAP connection helper wrapping rs.ltt.jmap.client.JmapClient.
+// Batch 1 — connection + session validation only. NOT yet wired into
+// EmailService.connect(); sync/ops/send/UI land in later batches.
+public class JmapService {
+    private final Context context;
+    private final String host;
+    private final int port;
+    private final String user;
+
+    private JmapClient client;
+
+    JmapService(Context context, EntityAccount account) {
+        this.context = context.getApplicationContext();
+        this.host = account.host;
+        this.port = (account.port == null ? 443 : account.port);
+        this.user = account.user;
+    }
+
+    // Open a JMAP client for the account and validate it by resolving the
+    // session resource. Blocks until the session future completes; any failure
+    // is surfaced as a javax.mail.MessagingException so callers can treat JMAP
+    // connection errors uniformly with the IMAP/POP paths.
+    void connect(String password) throws MessagingException {
+        // Standard JMAP autodiscovery endpoint (RFC 8620 §2.2).
+        String sessionResourceUrl = "https://" + host + ":" + port + "/.well-known/jmap";
+        try {
+            HttpUrl sessionResource = HttpUrl.get(sessionResourceUrl);
+            client = new JmapClient(user, password, sessionResource);
+            // Resolve the session to confirm credentials + reachability.
+            Session session = client.getSession().get();
+            if (session == null)
+                throw new MessagingException("JMAP session unavailable: " + sessionResourceUrl);
+            // TODO(batch2): inspect session capabilities / primary accounts here.
+        } catch (MessagingException ex) {
+            close();
+            throw ex;
+        } catch (Throwable ex) {
+            close();
+            throw new MessagingException("JMAP connect failed: " + sessionResourceUrl, ex);
+        }
+    }
+
+    JmapClient getClient() {
+        return client;
+    }
+
+    void close() {
+        try {
+            if (client != null)
+                client.close();
+        } catch (Throwable ignored) {
+        } finally {
+            client = null;
+        }
+    }
+}
