     <string name="title_comms_jmap_added" translatable="false">JMAP account added</string>
+    <string name="title_comms_jmap_updated" translatable="false">JMAP account updated</string>
     <string name="title_comms_rss_added" translatable="false">RSS feed added</string>
 
     <string name="hint_comms_display_name" translatable="false">Display name (optional)</string>
