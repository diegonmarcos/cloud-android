From e3f2c32dbc49160fae8000b6ba522ebf08783773 Mon Sep 17 00:00:00 2001
From: Diego Nepomuceno Marcos <me@diegonmarcos.com>
Date: Fri, 26 Jun 2026 16:31:00 +0200
Subject: [PATCH] =?UTF-8?q?comms:=20fix=20JMAP=20config=20crash=20?=
 =?UTF-8?q?=E2=80=94=20handle=20TYPE=5FJMAP/RSS=20in=20onEditAccount=20+?=
 =?UTF-8?q?=20edit=20mode?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ActivitySetup.onEditAccount() threw IllegalArgumentException for protocol=2
(TYPE_JMAP) and protocol=3 (TYPE_RSS) because the switch had no matching case.

Fix:
- TYPE_JMAP: show FragmentDialogJmap (which now supports edit mode) instead of
  trying to open the IMAP-centric FragmentAccount.
- TYPE_RSS: return early — synthetic local account, nothing to configure.

FragmentDialogJmap edit mode (args.getLong("id") >= 0):
- Pre-fills name/user/host/port from DB on open; email from first identity.
- On OK: updates existing account+identities instead of inserting.
  Password field empty → keep existing password (no silent wipe).
- Toast says "JMAP account updated" vs "JMAP account added".
---
 .../java/eu/faircode/email/ActivitySetup.java |  8 ++
 .../eu/faircode/email/FragmentDialogJmap.java | 89 +++++++++++++++++--
 app/src/main/res/values/strings_comms.xml     |  1 +
 3 files changed, 89 insertions(+), 9 deletions(-)

diff --git a/app/src/main/java/eu/faircode/email/ActivitySetup.java b/app/src/main/java/eu/faircode/email/ActivitySetup.java
index b80d40abae..0e01cbbf3a 100644
--- a/app/src/main/java/eu/faircode/email/ActivitySetup.java
+++ b/app/src/main/java/eu/faircode/email/ActivitySetup.java
@@ -737,6 +737,14 @@ public class ActivitySetup extends ActivityBase implements FragmentManager.OnBac
             case EntityAccount.TYPE_POP:
                 fragment = new FragmentPop();
                 break;
+            case EntityAccount.TYPE_JMAP: { // comms: show edit dialog instead of IMAP screen
+                FragmentDialogJmap dlg = new FragmentDialogJmap();
+                dlg.setArguments(intent.getExtras() != null ? intent.getExtras() : new Bundle());
+                dlg.show(getSupportFragmentManager(), "comms:jmap-edit");
+                return;
+            }
+            case EntityAccount.TYPE_RSS: // comms: synthetic local account, nothing to configure
+                return;
             default:
                 throw new IllegalArgumentException("Unknown protocol=" + protocol);
         }
diff --git a/app/src/main/java/eu/faircode/email/FragmentDialogJmap.java b/app/src/main/java/eu/faircode/email/FragmentDialogJmap.java
index 270a1fc944..bf9680b3af 100644
--- a/app/src/main/java/eu/faircode/email/FragmentDialogJmap.java
+++ b/app/src/main/java/eu/faircode/email/FragmentDialogJmap.java
@@ -32,9 +32,12 @@ import androidx.annotation.NonNull;
 import androidx.annotation.Nullable;
 import androidx.appcompat.app.AlertDialog;
 
+import java.util.List;
+
 // comms (my-features): interactive "JMAP account" config window. Collects the same
 // fields the JSON provisioner writes, then delegates to CommsAccounts.createJmapAccount
 // (with the password filled). Host/port prefill the cloud defaults (jmap.diegonmarcos.com:443).
+// Edit mode: pass "id" (account row id) in args → loads existing values, updates on OK.
 public class FragmentDialogJmap extends FragmentDialogBase {
     @NonNull
     @Override
@@ -48,6 +51,43 @@ public class FragmentDialogJmap extends FragmentDialogBase {
         final EditText etHost = dview.findViewById(R.id.etHost);
         final EditText etPort = dview.findViewById(R.id.etPort);
 
+        final long accountId = getArguments() != null ? getArguments().getLong("id", -1) : -1;
+        final boolean editing = accountId >= 0;
+
+        // Edit mode: load existing account values into fields
+        if (editing) {
+            new SimpleTask<EntityAccount>() {
+                @Override
+                protected EntityAccount onExecute(Context context, Bundle args) {
+                    return DB.getInstance(context).account().getAccount(args.getLong("id"));
+                }
+                @Override
+                protected void onExecuted(Bundle args, EntityAccount account) {
+                    if (account == null) return;
+                    if (!TextUtils.isEmpty(account.name)) etName.setText(account.name);
+                    if (!TextUtils.isEmpty(account.user)) etUser.setText(account.user);
+                    if (!TextUtils.isEmpty(account.host)) etHost.setText(account.host);
+                    etPort.setText(String.valueOf(account.port));
+                }
+                @Override
+                protected void onException(Bundle args, Throwable ex) { /* non-fatal pre-fill */ }
+            }.execute(this, getArguments(), "comms:jmap-load");
+
+            new SimpleTask<String>() {
+                @Override
+                protected String onExecute(Context context, Bundle args) {
+                    List<EntityIdentity> ids = DB.getInstance(context).identity().getIdentities(args.getLong("id"));
+                    return (ids != null && !ids.isEmpty()) ? ids.get(0).email : null;
+                }
+                @Override
+                protected void onExecuted(Bundle args, String email) {
+                    if (email != null) etEmail.setText(email);
+                }
+                @Override
+                protected void onException(Bundle args, Throwable ex) { /* non-fatal pre-fill */ }
+            }.execute(this, getArguments(), "comms:jmap-load-identity");
+        }
+
         return new AlertDialog.Builder(context)
                 .setView(dview)
                 .setPositiveButton(android.R.string.ok, (dialog, which) -> {
@@ -58,6 +98,7 @@ public class FragmentDialogJmap extends FragmentDialogBase {
                     args.putString("password", etPassword.getText().toString());
                     args.putString("host", etHost.getText().toString().trim());
                     args.putString("port", etPort.getText().toString().trim());
+                    args.putLong("accountId", accountId);
 
                     new SimpleTask<Void>() {
                         @Override
@@ -68,28 +109,58 @@ public class FragmentDialogJmap extends FragmentDialogBase {
                             if (TextUtils.isEmpty(host) || TextUtils.isEmpty(user))
                                 throw new IllegalArgumentException("JMAP host and username are required");
                             int port = TextUtils.isEmpty(sport) ? 443 : Integer.parseInt(sport);
+                            String name = args.getString("name");
+                            String email = args.getString("email");
+                            String password = args.getString("password");
+                            long aid = args.getLong("accountId", -1);
 
                             DB db = DB.getInstance(context);
                             try {
                                 db.beginTransaction();
-                                long id = CommsAccounts.createJmapAccount(db, null,
-                                        args.getString("name"), args.getString("email"),
-                                        user, args.getString("password"),
-                                        host, port, EmailService.ENCRYPTION_SSL, false);
-                                if (id < 0)
-                                    throw new IllegalArgumentException("JMAP account already exists");
+                                if (aid >= 0) {
+                                    EntityAccount account = db.account().getAccount(aid);
+                                    if (account != null) {
+                                        account.host = host;
+                                        account.port = port;
+                                        account.user = user;
+                                        if (!TextUtils.isEmpty(password)) account.password = password;
+                                        if (!TextUtils.isEmpty(name)) account.name = name;
+                                        db.account().updateAccount(account);
+                                        List<EntityIdentity> ids = db.identity().getIdentities(aid);
+                                        if (ids != null)
+                                            for (EntityIdentity id : ids) {
+                                                id.host = host;
+                                                id.port = port;
+                                                id.user = user;
+                                                if (!TextUtils.isEmpty(password)) id.password = password;
+                                                if (!TextUtils.isEmpty(name)) id.name = name;
+                                                if (!TextUtils.isEmpty(email)) id.email = email;
+                                                db.identity().updateIdentity(id);
+                                            }
+                                    }
+                                } else {
+                                    long id = CommsAccounts.createJmapAccount(db, null,
+                                            name, email, user, password,
+                                            host, port, EmailService.ENCRYPTION_SSL, false);
+                                    if (id < 0)
+                                        throw new IllegalArgumentException("JMAP account already exists");
+                                }
                                 db.setTransactionSuccessful();
                             } finally {
                                 db.endTransaction();
                             }
 
-                            ServiceSynchronize.eval(context, "jmap account added");
+                            ServiceSynchronize.eval(context,
+                                    aid >= 0 ? "jmap account updated" : "jmap account added");
                             return null;
                         }
 
                         @Override
                         protected void onExecuted(Bundle args, Void data) {
-                            ToastEx.makeText(context, R.string.title_comms_jmap_added, Toast.LENGTH_LONG).show();
+                            int resId = args.getLong("accountId", -1) >= 0
+                                    ? R.string.title_comms_jmap_updated
+                                    : R.string.title_comms_jmap_added;
+                            ToastEx.makeText(context, resId, Toast.LENGTH_LONG).show();
                         }
 
                         @Override
@@ -98,7 +169,7 @@ public class FragmentDialogJmap extends FragmentDialogBase {
                                 Log.unexpectedError(getParentFragmentManager(), ex);
                             } catch (Throwable ignored) { }
                         }
-                    }.execute(FragmentDialogJmap.this, args, "comms:jmap-create");
+                    }.execute(FragmentDialogJmap.this, args, "comms:jmap-save");
                 })
                 .setNegativeButton(android.R.string.cancel, null)
                 .create();
