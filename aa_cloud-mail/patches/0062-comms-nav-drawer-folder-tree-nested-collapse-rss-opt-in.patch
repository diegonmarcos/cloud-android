@@ -197,7 +199,14 @@ public class AdapterNavAccountFolder extends RecyclerView.Adapter<AdapterNavAcco
                 tvItemExtra.setVisibility(nav_count && expanded ? View.VISIBLE : View.GONE);
             }
 
-            ivExtra.setVisibility(View.GONE);
