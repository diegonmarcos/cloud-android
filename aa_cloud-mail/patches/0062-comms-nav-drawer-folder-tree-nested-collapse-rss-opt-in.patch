+                return;
+            }
+
             LocalBroadcastManager lbm = LocalBroadcastManager.getInstance(context);
 
             if (account.folderName != null)
@@ -334,6 +368,34 @@ public class AdapterNavAccountFolder extends RecyclerView.Adapter<AdapterNavAcco
                     accounts.add(item);
         }
 
+        // comms: name-based folder tree — indent by ancestor count, chevron on
+        // parents, hide subtrees of collapsed ancestors (folder.collapsed).
+        // Separator defaults to '/' for local (RSS) folders that have none.
+        List<TupleAccountFolder> tree = new ArrayList<>();
+        for (TupleAccountFolder item : accounts) {
+            item.folderLevel = 0;
+            item.folderHasChildren = false;
+            if (item.folderName == null) {
+                tree.add(item);
+                continue;
+            }
+            char sep = (item.folderSeparator == null ? '/' : item.folderSeparator);
+            boolean hidden = false;
+            for (TupleAccountFolder other : accounts) {
+                if (other == item || other.folderName == null || !Objects.equals(other.id, item.id))
+                    continue;
+                if (item.folderName.startsWith(other.folderName + sep)) {
+                    item.folderLevel++;
+                    if (Boolean.TRUE.equals(other.folderCollapsed))
+                        hidden = true;
+                } else if (other.folderName.startsWith(item.folderName + sep))
+                    item.folderHasChildren = true;
+            }
+            if (!hidden)
+                tree.add(item);
+        }
+        accounts = tree;
+
         DiffUtil.DiffResult diff = DiffUtil.calculateDiff(new DiffCallback(items, accounts), false);
 
         this.expanded = expanded;
@@ -427,6 +489,9 @@ public class AdapterNavAccountFolder extends RecyclerView.Adapter<AdapterNavAcco
                     Objects.equals(a1.last_connected, a2.last_connected) &&
                     Objects.equals(a1.error, a2.error) &&
                     // Folder
+                    Objects.equals(a1.folderCollapsed, a2.folderCollapsed) &&
+                    a1.folderLevel == a2.folderLevel &&
+                    a1.folderHasChildren == a2.folderHasChildren &&
                     a1.equals(a2);
         }
     }
