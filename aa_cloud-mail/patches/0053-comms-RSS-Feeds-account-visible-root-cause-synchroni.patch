diff --git a/app/src/main/java/eu/faircode/email/CommsAccounts.java b/app/src/main/java/eu/faircode/email/CommsAccounts.java
index 816045e1e6..3920b13f2e 100644
--- a/app/src/main/java/eu/faircode/email/CommsAccounts.java
+++ b/app/src/main/java/eu/faircode/email/CommsAccounts.java
@@ -123,6 +123,26 @@ public class CommsAccounts {
                     ensureJmapFolders(db, account.id);
     }
 
+    // One-shot startup repair (ApplicationEx): pre-0053 installs created the
+    // synthetic Feeds account with synchronize=false, so it (and every feed) was
+    // invisible in the drawer/folder list. Flip it on retroactively + drop any
+    // stale ops that accumulated on its folders while it was mis-flagged (those
+    // would otherwise try to run against the hostless account). The log line is
+    // a stable marker for the dex-level tester.
+    static void repairRssAccount(DB db) {
+        EntityAccount rss = db.account().getAccountByUUID(RSS_ACCOUNT_UUID);
+        if (rss == null)
+            return;
+        if (!rss.synchronize)
+            db.account().setAccountSynchronize(rss.id, true);
+        List<EntityFolder> folders = db.folder().getFolders(rss.id, false, false);
+        if (folders != null)
+            for (EntityFolder f : folders)
+                db.operation().deleteOperations(f.id, null);
+        Log.i("comms:rss-repair Feeds account synchronize=true folders="
+                + (folders == null ? 0 : folders.size()));
+    }
+
     // Synthetic local "Feeds" account that owns every RSS folder. Created on first use.
     static EntityAccount ensureRssAccount(DB db) {
         EntityAccount rss = db.account().getAccountByUUID(RSS_ACCOUNT_UUID);
@@ -139,7 +159,16 @@ public class CommsAccounts {
         rss.user = "";
         rss.password = "";
         rss.name = "Feeds";
-        rss.synchronize = false;
+        // synchronize MUST be true or the Feeds account (and all its feed
+        // folders) is invisible: every folder/drawer query filters on
+        // account.synchronize (DaoFolder.liveFolders + ~10 siblings, DaoAccount
+        // drawer). The sync ENGINES never touch it anyway — ServiceSynchronize
+        // gates each account on SUM(folder.synchronize)>0 and feed folders keep
+        // synchronize=false, so monitorAccount never starts an IMAP connect to
+        // this hostless account (see also the TYPE_RSS guard in monitorAccount
+        // and the RSS op short-circuits in EntityOperation). Polling is
+        // WorkerFeedSync, entirely separate.
+        rss.synchronize = true;
         rss.primary = false;
         rss.poll_interval = EntityAccount.DEFAULT_POLL_INTERVAL;
         rss.created = System.currentTimeMillis();
diff --git a/app/src/main/java/eu/faircode/email/EntityOperation.java b/app/src/main/java/eu/faircode/email/EntityOperation.java
index 3d6f6ebc2f..a80d6e403e 100644
--- a/app/src/main/java/eu/faircode/email/EntityOperation.java
+++ b/app/src/main/java/eu/faircode/email/EntityOperation.java
@@ -623,6 +623,11 @@ public class EntityOperation {
         if (inlinePOP3(context, account, folder, message, name, jargs))
             return;
 
+        // comms: RSS feed folders are local read-only — never queue a server op
+        // for the hostless Feeds account (it would try to connect to host="").
+        if (inlineRSS(context, account, folder, message, name, jargs))
+            return;
+
         EntityOperation op = new EntityOperation();
         op.account = account;
         op.folder = folder;
@@ -788,6 +793,47 @@ public class EntityOperation {
         return false;
     }
 
+    // comms: intercept message-level ops for the synthetic RSS Feeds account —
+    // its folders are local read-only, there is no server to run ops against.
+    // Mirrors inlinePOP3: state changes are already written by the caller, so we
+    // just drop the op (SEEN/FLAG/…) or do the local move/delete and return true.
+    private static boolean inlineRSS(Context context, Long account, long folder, Long message, String name, JSONArray jargs) {
+        if (account == null || message == null)
+            return false;
+
+        DB db = DB.getInstance(context);
+        EntityAccount a = db.account().getAccount(account);
+        if (a == null || a.protocol != EntityAccount.TYPE_RSS)
+            return false;
+
+        if (MOVE.equals(name)) {
+            try {
+                long target = jargs.getLong(0);
+                EntityMessage m = db.message().getMessage(message);
+                if (m != null && m.folder != target) {
+                    m.folder = target;
+                    m.ui_hide = false;
+                    db.message().updateMessage(m);
+                }
+            } catch (JSONException ex) {
+                Log.e(ex);
+            }
+            return true;
+        }
+
+        if (DELETE.equals(name)) {
+            EntityMessage m = db.message().getMessage(message);
+            if (m != null)
+                db.message().deleteMessage(m.id);
+            return true;
+        }
+
+        // SEEN / FLAG / ANSWERED / KEYWORD / ADD / REPORT / … — caller already
+        // updated the DB row; nothing to sync. Drop every remaining op.
+        Log.i("RSS: skipping op=" + name);
+        return true;
+    }
+
     static void poll(Context context, long fid) throws JSONException {
         DB db = DB.getInstance(context);
 
@@ -826,6 +872,14 @@ public class EntityOperation {
         if (folder == null)
             return force;
 
+        // comms: pull-to-refresh (and every other caller) funnels through here.
+        // An RSS feed folder has no server SYNC — kick the feed poller instead
+        // of queuing a SYNC op that would run against the hostless Feeds account.
+        if (folder.feed_url != null) {
+            WorkerFeedSync.oneShot(context);
+            return force;
+        }
+
         if (foreground) {
             long now = new Date().getTime();
             if (folder.last_sync_foreground != null &&
diff --git a/app/src/main/java/eu/faircode/email/ServiceSynchronize.java b/app/src/main/java/eu/faircode/email/ServiceSynchronize.java
index eebd6db3dd..50e0db555f 100644
--- a/app/src/main/java/eu/faircode/email/ServiceSynchronize.java
+++ b/app/src/main/java/eu/faircode/email/ServiceSynchronize.java
@@ -1632,6 +1632,14 @@ public class ServiceSynchronize extends ServiceBase implements SharedPreferences
             return;
         }
 
+        // comms: the synthetic RSS Feeds account is hostless — it must never
+        // reach the IMAP monitor (host="" → connect failure loop). It normally
+        // can't (SUM(folder.synchronize)>0 gate excludes it), but guard here so
+        // a stray sync-flagged feed folder can never start a real connection.
+        // Polling is WorkerFeedSync, entirely separate.
+        if (account.protocol == EntityAccount.TYPE_RSS)
+            return;
+
         final PowerManager pm = Helper.getSystemService(this, PowerManager.class);
         final PowerManager.WakeLock wlAccount = pm.newWakeLock(
                 PowerManager.PARTIAL_WAKE_LOCK, BuildConfig.APPLICATION_ID + ":account." + account.id);
diff --git a/app/src/main/java/eu/faircode/email/WorkerFeedSync.java b/app/src/main/java/eu/faircode/email/WorkerFeedSync.java
index 09012b5d7a..adba66068d 100644
--- a/app/src/main/java/eu/faircode/email/WorkerFeedSync.java
+++ b/app/src/main/java/eu/faircode/email/WorkerFeedSync.java
@@ -27,6 +27,8 @@ import android.content.SharedPreferences;
 import androidx.annotation.NonNull;
 import androidx.preference.PreferenceManager;
 import androidx.work.ExistingPeriodicWorkPolicy;
+import androidx.work.ExistingWorkPolicy;
+import androidx.work.OneTimeWorkRequest;
 import androidx.work.PeriodicWorkRequest;
 import androidx.work.WorkManager;
 import androidx.work.Worker;
@@ -211,4 +213,19 @@ public class WorkerFeedSync extends Worker {
     private static String getName() {
         return WorkerFeedSync.class.getSimpleName();
     }
+
+    // comms: immediate one-shot feed poll. Used by pull-to-refresh on a feed
+    // folder (EntityOperation.sync short-circuit) and by the Cloud Feeds dialog
+    // after (re)provisioning the channel tree, so content appears at once
+    // instead of waiting for the next 6h periodic tick. KEEP: rapid triggers
+    // coalesce into the one running poll.
+    static void oneShot(Context context) {
+        try {
+            OneTimeWorkRequest request = new OneTimeWorkRequest.Builder(WorkerFeedSync.class).build();
+            WorkManager.getInstance(context)
+                    .enqueueUniqueWork(getName() + "Now", ExistingWorkPolicy.KEEP, request);
+        } catch (Throwable ex) {
+            Log.w(ex);
+        }
+    }
 }
