+import android.content.Context;
+import android.os.Bundle;
+import android.text.TextUtils;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.RadioGroup;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.google.android.material.textfield.TextInputEditText;
+
+import java.util.List;
+
+// comms (my-features): full-screen JMAP account editor — mirrors FragmentAccount/FragmentPop
+// for TYPE_JMAP accounts. Handles both create (no "id" arg) and edit ("id" = account row id).
+// Password field uses Material TextInputLayout endIconMode=password_toggle (eye icon).
+// On save: creates standard JMAP folders (INBOX/Sent/Drafts/Trash/Junk) via CommsAccounts
+// so FairEmail never shows "folder missing" errors.
+public class FragmentJmapAccount extends FragmentBase {
+
+    private EditText etName, etEmail, etUser, etHost, etPort;
+    private TextInputEditText etPassword;
+    private RadioGroup rgEncryption;
+    private Button btnSave;
+    private long accountId = -1;
+
+    @Override
+    @Nullable
+    public View onCreateView(@NonNull LayoutInflater inflater, @Nullable ViewGroup container,
+                             @Nullable Bundle savedInstanceState) {
+        return inflater.inflate(R.layout.fragment_jmap_account, container, false);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+
+        etName = view.findViewById(R.id.etName);
+        etEmail = view.findViewById(R.id.etEmail);
+        etUser = view.findViewById(R.id.etUser);
+        etPassword = view.findViewById(R.id.etPassword);
+        etHost = view.findViewById(R.id.etHost);
+        etPort = view.findViewById(R.id.etPort);
+        rgEncryption = view.findViewById(R.id.rgEncryption);
+        btnSave = view.findViewById(R.id.btnSave);
+
+        Bundle args = getArguments();
+        accountId = (args != null) ? args.getLong("id", -1) : -1;
+
+        if (accountId >= 0) {
+            // Edit mode — load existing values from DB
+            new SimpleTask<Object[]>() {
+                @Override
+                protected Object[] onExecute(Context context, Bundle args) {
+                    DB db = DB.getInstance(context);
+                    EntityAccount account = db.account().getAccount(args.getLong("id"));
+                    List<EntityIdentity> ids = (account != null)
+                            ? db.identity().getIdentities(account.id) : null;
+                    String email = (ids != null && !ids.isEmpty()) ? ids.get(0).email : null;
+                    return new Object[]{account, email};
+                }
+
+                @Override
+                protected void onExecuted(Bundle args, Object[] result) {
+                    EntityAccount account = (EntityAccount) result[0];
+                    String email = (String) result[1];
+                    if (account == null) return;
+                    if (!TextUtils.isEmpty(account.name)) etName.setText(account.name);
+                    if (!TextUtils.isEmpty(account.user)) etUser.setText(account.user);
+                    if (!TextUtils.isEmpty(account.host)) etHost.setText(account.host);
+                    etPort.setText(String.valueOf(account.port));
+                    if (!TextUtils.isEmpty(account.password)) etPassword.setText(account.password);
+                    if (!TextUtils.isEmpty(email)) etEmail.setText(email);
+                    if (account.encryption == EmailService.ENCRYPTION_STARTTLS)
+                        rgEncryption.check(R.id.radio_starttls);
+                    else if (account.encryption == EmailService.ENCRYPTION_NONE)
+                        rgEncryption.check(R.id.radio_none);
+                    else
+                        rgEncryption.check(R.id.radio_ssl);
+                }
+
+                @Override
+                protected void onException(Bundle args, Throwable ex) { /* non-fatal prefill */ }
+            }.execute(this, getArguments(), "comms:jmap-load");
+        }
+
+        btnSave.setOnClickListener(v -> save());
+    }
+
+    private void save() {
+        String host = etHost.getText().toString().trim();
+        String user = etUser.getText().toString().trim();
+        if (TextUtils.isEmpty(host) || TextUtils.isEmpty(user)) {
+            ToastEx.makeText(getContext(), R.string.title_comms_jmap_host_user_required, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        String portStr = etPort.getText().toString().trim();
+        int port = TextUtils.isEmpty(portStr) ? 443 : Integer.parseInt(portStr);
+        CharSequence pwSeq = etPassword.getText();
+        String password = (pwSeq != null) ? pwSeq.toString() : "";
+
+        int encId = rgEncryption.getCheckedRadioButtonId();
+        int encryption;
+        if (encId == R.id.radio_starttls) encryption = EmailService.ENCRYPTION_STARTTLS;
+        else if (encId == R.id.radio_none) encryption = EmailService.ENCRYPTION_NONE;
+        else encryption = EmailService.ENCRYPTION_SSL;
+
+        Bundle args = new Bundle();
+        args.putString("name", etName.getText().toString().trim());
+        args.putString("email", etEmail.getText().toString().trim());
+        args.putString("user", user);
+        args.putString("password", password);
+        args.putString("host", host);
+        args.putInt("port", port);
+        args.putInt("encryption", encryption);
+        args.putLong("accountId", accountId);
+
+        btnSave.setEnabled(false);
+
+        new SimpleTask<Void>() {
+            @Override
+            protected Void onExecute(Context context, Bundle args) throws Throwable {
+                String host = args.getString("host");
+                String user = args.getString("user");
+                String password = args.getString("password");
+                int port = args.getInt("port", 443);
+                int encryption = args.getInt("encryption", EmailService.ENCRYPTION_SSL);
+                String name = args.getString("name");
+                String email = args.getString("email");
+                long aid = args.getLong("accountId", -1);
+
+                DB db = DB.getInstance(context);
+                try {
+                    db.beginTransaction();
+                    if (aid >= 0) {
+                        // Update existing account
+                        EntityAccount account = db.account().getAccount(aid);
+                        if (account != null) {
+                            account.host = host;
+                            account.port = port;
+                            account.encryption = encryption;
+                            account.user = user;
+                            if (!TextUtils.isEmpty(password)) account.password = password;
+                            if (!TextUtils.isEmpty(name)) account.name = name;
+                            db.account().updateAccount(account);
+                            List<EntityIdentity> ids = db.identity().getIdentities(aid);
+                            if (ids != null)
+                                for (EntityIdentity id : ids) {
+                                    id.host = host;
+                                    id.port = port;
+                                    id.encryption = encryption;
+                                    id.user = user;
+                                    if (!TextUtils.isEmpty(password)) id.password = password;
+                                    if (!TextUtils.isEmpty(name)) id.name = name;
+                                    if (!TextUtils.isEmpty(email)) id.email = email;
+                                    db.identity().updateIdentity(id);
+                                }
+                        }
+                        CommsAccounts.ensureJmapFolders(db, aid);
+                    } else {
+                        // Create new account (ensureJmapFolders called inside)
+                        long id = CommsAccounts.createJmapAccount(db, null,
+                                name, email, user, password, host, port, encryption, false);
+                        if (id < 0)
+                            throw new IllegalArgumentException(context.getString(
+                                    R.string.title_comms_jmap_exists));
+                    }
+                    db.setTransactionSuccessful();
+                } finally {
+                    db.endTransaction();
+                }
+                ServiceSynchronize.eval(context,
+                        aid >= 0 ? "jmap account updated" : "jmap account added");
+                return null;
+            }
+
+            @Override
+            protected void onExecuted(Bundle args, Void data) {
+                int resId = args.getLong("accountId", -1) >= 0
+                        ? R.string.title_comms_jmap_updated
+                        : R.string.title_comms_jmap_added;
+                ToastEx.makeText(getContext(), resId, Toast.LENGTH_LONG).show();
+                if (getParentFragmentManager().getBackStackEntryCount() > 0)
+                    getParentFragmentManager().popBackStack();
+            }
+
+            @Override
+            protected void onException(Bundle args, Throwable ex) {
+                btnSave.setEnabled(true);
+                try {
+                    Log.unexpectedError(getParentFragmentManager(), ex);
+                } catch (Throwable ignored) { }
+            }
+        }.execute(this, args, "comms:jmap-save");
+    }
+}
