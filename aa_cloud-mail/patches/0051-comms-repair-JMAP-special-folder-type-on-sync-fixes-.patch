From b2380feb593acba03cb641ca671a1bda374c8a58 Mon Sep 17 00:00:00 2001
From: Diego <me@diegonmarcos.com>
Date: Wed, 8 Jul 2026 20:35:00 +0300
Subject: [PATCH] comms: repair JMAP special-folder type on sync (fixes 'no
 sent folder')
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The mailbox upsert only repaired synchronize on existing folders, never the
type. Folders synced by pre-role builds stayed generic USER, so the account
showed 'no sent folder selected' / 'drafts folder required' and sends could
not stash a copy. Stalwart's special folders are named 'Sent Items' /
'Deleted Items' / 'Junk Mail' (no name match possible) — the JMAP role is the
only signal, and roleToType already maps it. Now upgrade an existing folder's
type from the server role when it differs (never downgrade to USER on a null
role, preserving manual assignments).
---
 .../main/java/eu/faircode/email/JmapSync.java | 22 +++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/app/src/main/java/eu/faircode/email/JmapSync.java b/app/src/main/java/eu/faircode/email/JmapSync.java
index 716fe38dd9..130bac0043 100644
--- a/app/src/main/java/eu/faircode/email/JmapSync.java
+++ b/app/src/main/java/eu/faircode/email/JmapSync.java
@@ -156,10 +156,24 @@ public class JmapSync {
                 folder.selectable = true;
                 folder.id = db.folder().insertFolder(folder);
                 EntityLog.log(context, "JMAP created folder=" + name + " type=" + type);
-            } else if (!repaired && !Boolean.TRUE.equals(folder.synchronize)) {
-                db.folder().setFolderSynchronize(folder.id, true);
-                folder.synchronize = true;
-                EntityLog.log(context, "JMAP repaired sync folder=" + name);
+            } else {
+                if (!repaired && !Boolean.TRUE.equals(folder.synchronize)) {
+                    db.folder().setFolderSynchronize(folder.id, true);
+                    folder.synchronize = true;
+                    EntityLog.log(context, "JMAP repaired sync folder=" + name);
+                }
+                // Repair the special-folder TYPE from the server role. Folders
+                // synced by pre-role builds were stored as generic USER folders,
+                // so the account showed "no sent folder / drafts required" and
+                // sending could not stash a copy. Upgrade only when the server
+                // assigns a concrete role (non-USER) that differs — never
+                // downgrade a user's manual assignment to USER on a null role.
+                if (!EntityFolder.USER.equals(type) && !type.equals(folder.type)) {
+                    db.folder().setFolderType(folder.id, type);
+                    EntityLog.log(context, "JMAP repaired type folder=" + name
+                            + " " + folder.type + "→" + type);
+                    folder.type = type;
+                }
             }
             folderToMailbox.put(folder.id, mb.getId());
             mailboxToFolder.put(mb.getId(), folder.id);
-- 
