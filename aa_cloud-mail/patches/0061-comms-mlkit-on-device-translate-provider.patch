diff --git a/app/src/main/java/eu/faircode/email/MLKitTranslate.java b/app/src/main/java/eu/faircode/email/MLKitTranslate.java
new file mode 100644
index 0000000000..414331567a
--- /dev/null
+++ b/app/src/main/java/eu/faircode/email/MLKitTranslate.java
@@ -0,0 +1,124 @@
+package eu.faircode.email;
+
