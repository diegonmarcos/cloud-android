+        // comms: Gmail-style — tapping the paperclip / count in the collapsed list
+        // row opens the message's attachment directly (the rest of the row still
+        // toggles the message). Picks the first real (non-inline) attachment, else
+        // the first; reuses FairEmail's own open (Helper.share) / download flow.
+        // ponytail: single-attachment case opens directly; with several it opens the
+        // first — the others stay reachable by opening the message. Upgrade to a
+        // chooser if multi-attachment direct-pick is ever wanted.
+        private void onOpenAttachment(TupleMessageEx message) {
+            Bundle args = new Bundle();
+            args.putLong("id", message.id);
+
+            new SimpleTask<EntityAttachment>() {
+                @Override
+                protected EntityAttachment onExecute(Context context, Bundle args) {
+                    long id = args.getLong("id");
+
+                    DB db = DB.getInstance(context);
+                    List<EntityAttachment> attachments = db.attachment().getAttachments(id);
+
+                    EntityAttachment target = null;
+                    for (EntityAttachment a : attachments)
+                        if (a != null && !a.isInline()) {
+                            target = a;
+                            break;
+                        }
+                    if (target == null && !attachments.isEmpty())
+                        target = attachments.get(0);
+
+                    return target;
+                }
+
+                @Override
+                protected void onExecuted(Bundle args, EntityAttachment attachment) {
+                    if (attachment == null)
+                        return;
+                    if (attachment.available) {
+                        String title = (attachment.name == null ? attachment.cid : attachment.name);
+                        Helper.share(context, attachment.getFile(context), attachment.getMimeType(), title);
+                    } else if (attachment.progress == null)
+                        onDownloadAttachment(attachment);
+                }
+
+                @Override
+                protected void onException(Bundle args, Throwable ex) {
+                    Log.unexpectedError(parentFragment.getParentFragmentManager(), ex);
+                }
+            }.execute(context, owner, args, "message:attachment:open");
+        }
+
+        // comms: queue an on-demand download for a not-yet-fetched attachment,
+        // mirroring AdapterAttachment.onDownload (tap again to open once available).
+        private void onDownloadAttachment(EntityAttachment attachment) {
+            Bundle args = new Bundle();
+            args.putLong("id", attachment.id);
+            args.putLong("message", attachment.message);
+
+            new SimpleTask<Void>() {
+                @Override
+                protected Void onExecute(Context context, Bundle args) {
+                    long id = args.getLong("id");
+                    long mid = args.getLong("message");
+
+                    DB db = DB.getInstance(context);
+                    try {
+                        db.beginTransaction();
+
+                        EntityMessage message = db.message().getMessage(mid);
+                        if (message == null)
+                            return null;
+
+                        EntityAttachment attachment = db.attachment().getAttachment(id);
+                        if (attachment == null || attachment.progress != null || attachment.available)
+                            return null;
+
+                        EntityOperation.queue(context, message, EntityOperation.ATTACHMENT, id);
+
+                        db.setTransactionSuccessful();
+                    } finally {
+                        db.endTransaction();
+                    }
+
+                    ServiceSynchronize.eval(context, "attachment");
+
+                    return null;
+                }
+
+                @Override
+                protected void onException(Bundle args, Throwable ex) {
+                    Log.unexpectedError(parentFragment.getParentFragmentManager(), ex);
+                }
+            }.execute(context, owner, args, "message:attachment:download");
+        }
+
