From 94b46e793547db10552a67e55a5a00d1e3cc0d77 Mon Sep 17 00:00:00 2001
From: Diego Nepomuceno Marcos <me@diegonmarcos.com>
Date: Thu, 25 Jun 2026 22:31:38 +0200
Subject: [PATCH] =?UTF-8?q?comms:=20fix=20JMAP-account-created=20crash=20?=
 =?UTF-8?q?=E2=80=94=20skip=20sync=20+=20safe=20onException?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Two bugs fixed:
1. ServiceSynchronize.monitorAccount() now returns early for TYPE_JMAP
   accounts (sync not yet implemented). Without this, eval() after account
   creation immediately triggered an IMAP connect attempt on the JMAP
   server which fails (wrong protocol / mesh down) and shows an error dialog.
2. FragmentDialogJmap/Rss onException: wrap getParentFragmentManager() in
   try-catch — throws IllegalStateException when the dialog is detached
   (positive-button dismiss races the SimpleTask callback).
---
 app/src/main/java/eu/faircode/email/FragmentDialogJmap.java | 4 +++-
 app/src/main/java/eu/faircode/email/FragmentDialogRss.java  | 4 +++-
 app/src/main/java/eu/faircode/email/ServiceSynchronize.java | 4 ++++
 3 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/app/src/main/java/eu/faircode/email/FragmentDialogJmap.java b/app/src/main/java/eu/faircode/email/FragmentDialogJmap.java
index 7b7863882b..270a1fc944 100644
--- a/app/src/main/java/eu/faircode/email/FragmentDialogJmap.java
+++ b/app/src/main/java/eu/faircode/email/FragmentDialogJmap.java
@@ -94,7 +94,9 @@ public class FragmentDialogJmap extends FragmentDialogBase {
 
                         @Override
                         protected void onException(Bundle args, Throwable ex) {
-                            Log.unexpectedError(getParentFragmentManager(), ex);
+                            try {
+                                Log.unexpectedError(getParentFragmentManager(), ex);
+                            } catch (Throwable ignored) { }
                         }
                     }.execute(FragmentDialogJmap.this, args, "comms:jmap-create");
                 })
diff --git a/app/src/main/java/eu/faircode/email/FragmentDialogRss.java b/app/src/main/java/eu/faircode/email/FragmentDialogRss.java
index 874cfa95a2..5fd39b9d39 100644
--- a/app/src/main/java/eu/faircode/email/FragmentDialogRss.java
+++ b/app/src/main/java/eu/faircode/email/FragmentDialogRss.java
@@ -80,7 +80,9 @@ public class FragmentDialogRss extends FragmentDialogBase {
 
                         @Override
                         protected void onException(Bundle args, Throwable ex) {
-                            Log.unexpectedError(getParentFragmentManager(), ex);
+                            try {
+                                Log.unexpectedError(getParentFragmentManager(), ex);
+                            } catch (Throwable ignored) { }
                         }
                     }.execute(FragmentDialogRss.this, args, "comms:rss-create");
                 })
diff --git a/app/src/main/java/eu/faircode/email/ServiceSynchronize.java b/app/src/main/java/eu/faircode/email/ServiceSynchronize.java
index 82614138bc..05baf4dda6 100644
--- a/app/src/main/java/eu/faircode/email/ServiceSynchronize.java
+++ b/app/src/main/java/eu/faircode/email/ServiceSynchronize.java
@@ -1623,6 +1623,10 @@ public class ServiceSynchronize extends ServiceBase implements SharedPreferences
     private void monitorAccount(
             final EntityAccount account, final Core.State state,
             final boolean sync, final boolean force) throws NoSuchProviderException {
+        // comms: JMAP sync path not yet implemented (batch 3+); skip to avoid erroneous IMAP connect
+        if (account.protocol == EntityAccount.TYPE_JMAP)
+            return;
+
         final PowerManager pm = Helper.getSystemService(this, PowerManager.class);
         final PowerManager.WakeLock wlAccount = pm.newWakeLock(
                 PowerManager.PARTIAL_WAKE_LOCK, BuildConfig.APPLICATION_ID + ":account." + account.id);
-- 
2.50.1

