From dae03e9794652b584242797cac7c0247784c5e48 Mon Sep 17 00:00:00 2001
From: Diego <me@diegonmarcos.com>
Date: Wed, 8 Jul 2026 12:37:11 +0300
Subject: [PATCH] =?UTF-8?q?comms:=20fix=20silent=20JMAP=20no-sync=20?=
 =?UTF-8?q?=E2=80=94=20folders=20were=20provisioned=20synchronize=3Dfalse?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Root cause: CommsAccounts.ensureJmapFolders still carried the pre-batch-3
stub 'synchronize=false until JMAP batch 3 is implemented'. With every
folder unsynchronized, DaoAccount.liveAccountState computes
SUM(folder.synchronize)=0, TupleAccountState.isEnabled requires folders>0,
so ServiceSynchronize never starts the JMAP monitor thread at all —
no connection, no fetch, no error. Folders shown in the UI were just the
five provisioned rows, never a server fetch.

- ensureJmapFolders: create standard folders via EntityFolder(name, type)
  (setProperties: synchronize=true, unified/notify inbox) and repair
  existing folders stuck at synchronize=false
- JmapSync folder upsert: drop the synchronize=INBOX-only override that
  re-introduced the same all-false state for server-discovered folders
- ApplicationEx.onCreate: one-shot pref-gated repairJmapFolders + eval so
  existing installs self-heal on next launch without re-adding the account
---
 .../java/eu/faircode/email/ApplicationEx.java | 17 ++++++++++
 .../java/eu/faircode/email/CommsAccounts.java | 34 ++++++++++++++-----
 .../main/java/eu/faircode/email/JmapSync.java |  6 ++--
 3 files changed, 46 insertions(+), 11 deletions(-)

diff --git a/app/src/main/java/eu/faircode/email/ApplicationEx.java b/app/src/main/java/eu/faircode/email/ApplicationEx.java
index a0edd1a653..d5adb71d1d 100644
--- a/app/src/main/java/eu/faircode/email/ApplicationEx.java
+++ b/app/src/main/java/eu/faircode/email/ApplicationEx.java
@@ -279,6 +279,23 @@ public class ApplicationEx extends Application
 
         upgrade(this);
 
+        // comms: one-shot repair — JMAP folders provisioned by pre-sync builds had
+        // synchronize=false, which silently kept the account monitor from starting.
+        if (!prefs.getBoolean("jmap_folder_repair", false)) {
+            prefs.edit().putBoolean("jmap_folder_repair", true).apply();
+            Helper.getSerialExecutor().submit(new Runnable() {
+                @Override
+                public void run() {
+                    try {
+                        CommsAccounts.repairJmapFolders(DB.getInstance(ApplicationEx.this));
+                        ServiceSynchronize.eval(ApplicationEx.this, "jmap folder repair");
+                    } catch (Throwable ex) {
+                        Log.e(ex);
+                    }
+                }
+            });
+        }
+
         try {
             boolean tcp_keep_alive = prefs.getBoolean("tcp_keep_alive", false);
             if (tcp_keep_alive)
diff --git a/app/src/main/java/eu/faircode/email/CommsAccounts.java b/app/src/main/java/eu/faircode/email/CommsAccounts.java
index ddc8f7967e..816045e1e6 100644
--- a/app/src/main/java/eu/faircode/email/CommsAccounts.java
+++ b/app/src/main/java/eu/faircode/email/CommsAccounts.java
@@ -80,8 +80,12 @@ public class CommsAccounts {
     }
 
     // Create the standard JMAP folder set for an account if they don't exist yet.
-    // Called on create AND on edit so existing accounts get folders retroactively.
-    // synchronize=false until JMAP batch 3 (full fetch) is implemented.
+    // Called on create, on edit AND once at app start (repairJmapFolders) so
+    // existing accounts get folders — and folder settings — retroactively.
+    // synchronize MUST be true: ServiceSynchronize gates the whole account on
+    // SUM(folder.synchronize) > 0 — all-false means the JMAP monitor never
+    // starts, silently (no connection, no error). That was the pre-batch-3
+    // stub behaviour left behind by accident.
     static void ensureJmapFolders(DB db, long accountId) {
         String[][] types = {
             {EntityFolder.INBOX,  "Inbox"},
@@ -91,22 +95,34 @@ public class CommsAccounts {
             {EntityFolder.JUNK,   "Junk"},
         };
         for (String[] pair : types) {
-            if (db.folder().getFolderByType(accountId, pair[0]) != null)
+            EntityFolder existing = db.folder().getFolderByType(accountId, pair[0]);
+            if (existing != null) {
+                if (!existing.synchronize)
+                    db.folder().setFolderSynchronize(existing.id, true);
                 continue;
-            EntityFolder folder = new EntityFolder();
+            }
+            // setProperties() via this constructor: synchronize=true for system
+            // folders, unified+notify for inbox, sync/keep windows.
+            EntityFolder folder = new EntityFolder(pair[1], pair[0]);
             folder.account = accountId;
-            folder.name = pair[1];
-            folder.type = pair[0];
-            folder.synchronize = false;
+            folder.poll = true; // JMAP is polled, never IDLE
             folder.local = false;
             folder.subscribed = true;
             folder.selectable = true;
-            folder.sync_days = EntityFolder.DEFAULT_SYNC;
-            folder.keep_days = EntityFolder.DEFAULT_KEEP;
             db.folder().insertFolder(folder);
         }
     }
 
+    // One-shot startup repair (ApplicationEx): flip synchronize back on for
+    // JMAP folders provisioned by pre-sync builds.
+    static void repairJmapFolders(DB db) {
+        List<EntityAccount> accounts = db.account().getAccounts();
+        if (accounts != null)
+            for (EntityAccount account : accounts)
+                if (account.protocol == EntityAccount.TYPE_JMAP)
+                    ensureJmapFolders(db, account.id);
+    }
+
     // Synthetic local "Feeds" account that owns every RSS folder. Created on first use.
     static EntityAccount ensureRssAccount(DB db) {
         EntityAccount rss = db.account().getAccountByUUID(RSS_ACCOUNT_UUID);
diff --git a/app/src/main/java/eu/faircode/email/JmapSync.java b/app/src/main/java/eu/faircode/email/JmapSync.java
index a076208daa..1dc6e8ca62 100644
--- a/app/src/main/java/eu/faircode/email/JmapSync.java
+++ b/app/src/main/java/eu/faircode/email/JmapSync.java
@@ -133,10 +133,12 @@ public class JmapSync {
             String type = JmapService.roleToType(mb.getRole());
             EntityFolder folder = db.folder().getFolderByName(account.id, name);
             if (folder == null) {
+                // EntityFolder(name, type) ran setProperties(): synchronize=true
+                // for system folders (user folders stay off), unified inbox etc.
+                // Do NOT override synchronize — all-false folders stop
+                // ServiceSynchronize from ever starting this account's monitor.
                 folder = new EntityFolder(name, type);
                 folder.account = account.id;
-                folder.type = type;
-                folder.synchronize = EntityFolder.INBOX.equals(type);
                 folder.subscribed = true;
                 folder.poll = true; // JMAP is polled, never IDLE
                 folder.download = true;
