From 5a4a19d3402be0d175a161ea89ae46bb926f9e67 Mon Sep 17 00:00:00 2001
From: Diego <me@diegonmarcos.com>
Date: Wed, 8 Jul 2026 13:03:21 +0300
Subject: [PATCH] comms: About shows real update channel + baked build
 timestamp

The layout hardcoded the retired GHCR channel string, so About
misidentified which build/channel was installed. Channel text now
derives from BuildConfig.COMMS_GH_OWNER/REPO (same coords the updater
queries) and the version line appends COMMS_BUILD_TIMESTAMP so the
installed build is identifiable at a glance.
---
 .../eu/faircode/email/FragmentOptionsCommsAbout.java   | 10 +++++++++-
 .../main/res/layout/fragment_options_comms_about.xml   |  1 -
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/app/src/main/java/eu/faircode/email/FragmentOptionsCommsAbout.java b/app/src/main/java/eu/faircode/email/FragmentOptionsCommsAbout.java
index 7af9064b6a..6850e780c9 100644
--- a/app/src/main/java/eu/faircode/email/FragmentOptionsCommsAbout.java
+++ b/app/src/main/java/eu/faircode/email/FragmentOptionsCommsAbout.java
@@ -57,7 +57,15 @@ public class FragmentOptionsCommsAbout extends FragmentBase {
         super.onViewCreated(view, savedInstanceState);
 
         TextView tvVersion = view.findViewById(R.id.comms_tv_version);
-        tvVersion.setText(BuildConfig.VERSION_NAME);
+        tvVersion.setText(BuildConfig.VERSION_NAME
+                + " · build " + BuildConfig.COMMS_BUILD_TIMESTAMP);
+
+        // comms: channel label derived from the SAME BuildConfig coords the
+        // updater queries — the layout used to hardcode the retired GHCR
+        // channel, which misidentified installed builds.
+        TextView tvChannel = view.findViewById(R.id.comms_tv_channel);
+        tvChannel.setText("github.com/" + BuildConfig.COMMS_GH_OWNER
+                + "/" + BuildConfig.COMMS_GH_REPO + "/releases");
 
         Button btnCheck = view.findViewById(R.id.comms_btn_check_update);
         btnCheck.setOnClickListener(v -> checkAndInstall(btnCheck));
diff --git a/app/src/main/res/layout/fragment_options_comms_about.xml b/app/src/main/res/layout/fragment_options_comms_about.xml
index 1f32ce35b2..568b0e87a7 100644
--- a/app/src/main/res/layout/fragment_options_comms_about.xml
+++ b/app/src/main/res/layout/fragment_options_comms_about.xml
@@ -64,7 +64,6 @@
             android:layout_height="wrap_content"
             android:layout_marginStart="3dp"
             android:layout_marginTop="2dp"
-            android:text="ghcr.io/diegonmarcos/cloud-comms-mail:latest"
             android:textAppearance="@style/TextAppearance.AppCompat.Small"
             android:fontFamily="monospace"
             android:textColor="?android:attr/textColorPrimary"
-- 
