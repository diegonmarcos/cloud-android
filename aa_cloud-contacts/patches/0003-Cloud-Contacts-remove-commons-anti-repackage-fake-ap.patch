From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Diego Nepomuceno Marcos <me@diegonmarcos.com>
Date: Tue, 18 Aug 2026 15:35:17 +0200
Subject: [PATCH 3/4] Cloud Contacts: remove commons anti-repackage 'fake app'
 dialog (false positive on our fork)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

commons' checkAppSideloading() flags any repackaged build and CACHES the verdict
forever in baseConfig.appSideloadingStatus — it would fire the 'You are using a
fake version of the app… fossify.org' dialog because our applicationId is
com.diegonmarcos.comms.contacts by design (previous patch).

- View/Edit/InsertOrEdit contact activities: drop the checkAppSideloading() call sites.
- New App class (manifest application name) pins appSideloadingStatus =
  SIDELOADING_FALSE on start, healing devices that already persisted
  SIDELOADING_TRUE from earlier builds.
---
 app/src/main/AndroidManifest.xml              |  2 +-
 .../main/kotlin/org/fossify/contacts/App.kt   | 23 +++++++++++++++++++
 .../activities/EditContactActivity.kt         |  6 ++---
 .../activities/InsertOrEditContactActivity.kt |  5 ++--
 .../activities/ViewContactActivity.kt         |  6 ++---
 5 files changed, 31 insertions(+), 11 deletions(-)
 create mode 100644 app/src/main/kotlin/org/fossify/contacts/App.kt

diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index a13d169a..d504c6b7 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -34,7 +34,7 @@
     </queries>
 
     <application
-        android:name="org.fossify.commons.FossifyApp"
+        android:name="org.fossify.contacts.App"
         android:allowBackup="true"
         android:appCategory="social"
         android:icon="@mipmap/ic_launcher"
diff --git a/app/src/main/kotlin/org/fossify/contacts/App.kt b/app/src/main/kotlin/org/fossify/contacts/App.kt
new file mode 100644
index 00000000..7c364acc
--- /dev/null
+++ b/app/src/main/kotlin/org/fossify/contacts/App.kt
@@ -0,0 +1,23 @@
+package org.fossify.contacts
+
+import org.fossify.commons.FossifyApp
+import org.fossify.commons.extensions.baseConfig
+import org.fossify.commons.helpers.SIDELOADING_FALSE
+
+/**
+ * Cloud Contacts application class (extends commons' FossifyApp).
+ *
+ * Commons caches its anti-repackage verdict forever in
+ * [org.fossify.commons.helpers.BaseConfig.appSideloadingStatus]; devices that ran
+ * an earlier build may still hold SIDELOADING_TRUE and would keep showing the
+ * "fake version of the app" dialog even after the check's call sites are removed.
+ * Pin the flag to FALSE on every start — this fork is intentionally repackaged
+ * (applicationId com.diegonmarcos.comms.contacts), so the verdict is a false
+ * positive by construction.
+ */
+class App : FossifyApp() {
+    override fun onCreate() {
+        super.onCreate()
+        baseConfig.appSideloadingStatus = SIDELOADING_FALSE
+    }
+}
diff --git a/app/src/main/kotlin/org/fossify/contacts/activities/EditContactActivity.kt b/app/src/main/kotlin/org/fossify/contacts/activities/EditContactActivity.kt
index 843a1dc8..901d4f76 100644
--- a/app/src/main/kotlin/org/fossify/contacts/activities/EditContactActivity.kt
+++ b/app/src/main/kotlin/org/fossify/contacts/activities/EditContactActivity.kt
@@ -34,7 +34,6 @@ import org.fossify.commons.extensions.beGone
 import org.fossify.commons.extensions.beInvisible
 import org.fossify.commons.extensions.beVisible
 import org.fossify.commons.extensions.beVisibleIf
-import org.fossify.commons.extensions.checkAppSideloading
 import org.fossify.commons.extensions.getCachePhoto
 import org.fossify.commons.extensions.getContactPublicUri
 import org.fossify.commons.extensions.getContactUriRawId
@@ -165,9 +164,8 @@ class EditContactActivity : ContactActivity() {
         super.onCreate(savedInstanceState)
         setContentView(binding.root)
 
-        if (checkAppSideloading()) {
-            return
-        }
+        // Cloud Contacts: upstream's checkAppSideloading() anti-repackage tripwire is
+        // removed — intentional fork, see App.kt.
 
         setupEdgeToEdge(
             padBottomImeAndSystem = listOf(binding.contactScrollview)
diff --git a/app/src/main/kotlin/org/fossify/contacts/activities/InsertOrEditContactActivity.kt b/app/src/main/kotlin/org/fossify/contacts/activities/InsertOrEditContactActivity.kt
index e634a3e8..9c89fc66 100644
