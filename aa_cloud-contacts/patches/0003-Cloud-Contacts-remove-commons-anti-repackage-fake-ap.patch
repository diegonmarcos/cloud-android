@@ -63,9 +63,8 @@ class InsertOrEditContactActivity : SimpleActivity(), RefreshContactsListener {
         binding.newContactHolder.beGoneIf(isSelectContactIntent)
         binding.selectContactLabel.beGoneIf(isSelectContactIntent)
 
-        if (checkAppSideloading()) {
-            return
-        }
+        // Cloud Contacts: upstream's checkAppSideloading() anti-repackage tripwire is
+        // removed — intentional fork, see App.kt.
 
         setupTabs()
 
diff --git a/app/src/main/kotlin/org/fossify/contacts/activities/ViewContactActivity.kt b/app/src/main/kotlin/org/fossify/contacts/activities/ViewContactActivity.kt
index d0a7cb70..90823631 100644
--- a/app/src/main/kotlin/org/fossify/contacts/activities/ViewContactActivity.kt
+++ b/app/src/main/kotlin/org/fossify/contacts/activities/ViewContactActivity.kt
@@ -50,9 +50,9 @@ class ViewContactActivity : ContactActivity() {
         super.onCreate(savedInstanceState)
         setContentView(binding.root)
 
-        if (checkAppSideloading()) {
-            return
-        }
+        // Cloud Contacts: upstream's checkAppSideloading() anti-repackage tripwire is
+        // removed — this IS an intentional fork (applicationId com.diegonmarcos.comms.contacts),
+        // so the "fake version of the app" dialog is a false positive by construction.
 
         setupEdgeToEdge(padBottomSystem = listOf(binding.contactScrollview))
 
