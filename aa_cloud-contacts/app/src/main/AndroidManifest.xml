<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Device contacts (local phone + synced accounts such as Gmail) — one of
         the merge sources. Requested at runtime; the app works without it
         (social imports only). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <queries>
        <package android:name="com.diegonmarcos.cloudcontacts" />
        <!-- Channel dispatch targets — the switchboard checks which
             constellation/social apps are installed to badge channels. -->
        <package android:name="com.diegonmarcos.comms.dialer" />
        <package android:name="com.diegonmarcos.comms.mail" />
        <package android:name="com.diegonmarcos.comms.chat" />
        <package android:name="com.diegonmarcos.comms.matrix" />
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.instagram.android" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudContacts"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CloudContacts">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.diegonmarcos.superapp.updater.PackageInstallerReceiver"
            android:exported="false" />
    </application>
</manifest>
