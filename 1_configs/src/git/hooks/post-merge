#!/usr/bin/env bash
# post-merge — sync submodules after pull/merge (non-blocking)
set -uo pipefail

if [ -t 2 ]; then
  printf '\033[33m\n┌─ git pull ─ tip ──────────────────────────────────────────────┐\n' >&2
  printf   '│ Prefer `git sync` — safer: auto-stash + rebase + submodules.  │\n' >&2
  printf   '└───────────────────────────────────────────────────────────────┘\033[0m\n' >&2
fi

git submodule update --init --recursive --rebase >/dev/null 2>&1 || true
exit 0
