#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════╗
# ║ pre-commit — block secrets from ever reaching a commit           ║
# ║                                                                  ║
# ║ Source: cloud-android/1_configs/src/git/hooks/pre-commit           ║
# ║ Deploy: build.sh workflow → 1_configs/dist/hooks/              ║
# ║ Active: via .gitconfig [core] hooksPath = 1_configs/dist/hooks ║
# ║                                                                  ║
# ║ KEEP IN SYNC with .gitignore patterns.                           ║
# ║ Catches secrets even after git add -f (gitignore bypass).        ║
# ╚══════════════════════════════════════════════════════════════════╝
set -uo pipefail

STAGED=$(git diff --cached --name-only)
[ -z "$STAGED" ] && exit 0

BLOCKED=""

# ── 1. gitignore-bypass detector ────────────────────────────────────
FORCED=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -e "$f" ] || continue
  if git check-ignore --no-index -q -- "$f" 2>/dev/null \
     && ! git cat-file -e "HEAD:$f" 2>/dev/null; then
    FORCED="${FORCED}${f}"$'\n'
  fi
done <<< "$STAGED"

if [ -n "$FORCED" ]; then
  echo "══════════════════════════════════════════════════" >&2
  echo "BLOCKED: gitignored files force-staged (git add -f)" >&2
  echo "══════════════════════════════════════════════════" >&2
  echo "$FORCED" | sort -u | sed '/^$/d' | sed 's/^/  /' >&2
  echo >&2
  echo "Fix: unstage with 'git reset HEAD <file>'." >&2
  BLOCKED=1
fi

# ── 2. path-based blocks ────────────────────────────────────────────
BAD_PATHS=$(echo "$STAGED" | grep -E '(^|/)(\.env|\.env\..+|.*\.key$|.*\.pem$|.*\.p12$|.*\.pfx$|.*\.jks$|.*\.keystore$|.*\.token$|.*credentials.*\.json$)' || true)
if [ -n "$BAD_PATHS" ]; then
  echo "════════════════════════════════════════════" >&2
  echo "BLOCKED: secret-pattern paths in commit" >&2
  echo "════════════════════════════════════════════" >&2
  echo "$BAD_PATHS" | sed 's/^/  /' >&2
  BLOCKED=1
fi

# ── 3. secrets.yaml content scan: must be sops-encrypted ────────────
SECRETS_YAML=$(echo "$STAGED" | grep -E '(^|/)(secrets\.yaml|secrets_backup\.yaml|jwks_key\.yaml)$' || true)
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "$f" ] || continue
  if ! grep -qE '(ENC\[AES256_GCM|sops:)' "$f"; then
    echo "════════════════════════════════════════════" >&2
    echo "BLOCKED: $f is not sops-encrypted" >&2
    echo "Fix: sops -e -i $f" >&2
    BLOCKED=1
  fi
done <<< "$SECRETS_YAML"

# ── 4. raw private keys in content ──────────────────────────────────
DIFF_CONTENT=$(git diff --cached --diff-filter=AM -U0 2>/dev/null || true)
if echo "$DIFF_CONTENT" | grep -qE 'BEGIN (RSA|OPENSSH|DSA|EC|PGP) PRIVATE KEY'; then
  echo "════════════════════════════════════════════" >&2
  echo "BLOCKED: raw private key material in diff" >&2
  echo "════════════════════════════════════════════" >&2
  BLOCKED=1
fi

# ── 5. Android keystore files ───────────────────────────────────────
KEYSTORE_FILES=$(echo "$STAGED" | grep -E '\.(jks|keystore|bks)$' | grep -v '\.example$' | grep -v '\.enc$' || true)
if [ -n "$KEYSTORE_FILES" ]; then
  echo "════════════════════════════════════════════" >&2
  echo "BLOCKED: raw Android keystore(s) in commit" >&2
  echo "Fix: sops-encrypt as <name>.keystore.enc" >&2
  echo "════════════════════════════════════════════" >&2
  echo "$KEYSTORE_FILES" | sed 's/^/  /' >&2
  BLOCKED=1
fi

[ -n "$BLOCKED" ] && exit 1
exit 0
