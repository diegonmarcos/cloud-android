<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme — browser chrome (address bar, tab strip) is dark-on-dark. -->
    <style name="Theme.CloudBrowser" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/nav_primary</item>
        <item name="colorOnPrimary">@color/nav_on_primary</item>
        <item name="colorPrimaryContainer">@color/nav_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/nav_on_primary_container</item>
        <item name="colorSecondary">@color/nav_secondary</item>
        <item name="colorSecondaryContainer">@color/nav_secondary_container</item>

        <item name="android:statusBarColor" tools:targetApi="lollipop">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="lollipop">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="lollipop">true</item>
    </style>
</resources>
