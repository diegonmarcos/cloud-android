<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET, and it must be declared HERE.
         Unlike ac_c3-watchdog, which is fed through a content provider and
         opens nothing outward, every panel in this app is a WebView onto a real
         cloud surface. A standalone app wrapper that forgets to re-declare this
         gets a blank WebView and no error worth reading — the trap
         ac_cloud-keyboard already walked into once. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="Morpheus"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Morpheus">
        <activity
            android:name="com.diegonmarcos.morpheus.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
