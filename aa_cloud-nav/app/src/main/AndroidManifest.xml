<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for tile fetch / reverse-geocode providers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- About page Wi-Fi section: SSID/BSSID need this AND ACCESS_FINE_LOCATION
         (Android 10+ scoped Wi-Fi info). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- About page Permissions section + tracker notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Self-update: download + install new APK from GHCR silently.
         UPDATE_PACKAGES_WITHOUT_USER_ACTION is THE permission that makes
         USER_ACTION_NOT_REQUIRED actually silent on Android 12+ (API 31). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Location perms + foreground-service-location are also declared by
         libs:maps (manifest-merged); listed here so the app manifest is
         self-describing for the maps map view + tracker. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:appCategory="maps"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudNav"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CloudNav">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Declares Cloud Nav as a maps app: Android offers it in the
                 "open with" chooser for any geo: location link (RFC 5870 +
                 Google's q= extension), handled by GeoUri → Places map. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TerrainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.CloudNav" />

        <activity
            android:name=".sky.ConstellationsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.CloudNav" />

        <activity
            android:name=".MilkyWayActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.CloudNav" />

        <receiver
            android:name="com.diegonmarcos.cloudnav.updater.PackageInstallerReceiver"
            android:exported="false" />
    </application>
</manifest>
