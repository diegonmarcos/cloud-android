<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for tile fetch / reverse-geocode providers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- About page Wi-Fi section: SSID/BSSID need this AND ACCESS_FINE_LOCATION
         (Android 10+ scoped Wi-Fi info). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- About page Permissions section + tracker notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Location perms + foreground-service-location are also declared by
         libs:maps (manifest-merged); listed here so the app manifest is
         self-describing for the maps map view + tracker. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudNav"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CloudNav">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
