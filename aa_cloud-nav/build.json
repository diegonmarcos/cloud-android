{
  "name": "cloud-nav",
  "description": "Diego's Cloud Nav — dedicated maps/navigation/tracker Android app. Single APK, gradle multi-module (app/ Google-Maps-style shell + libs/{core,maps}). MapLibre Native renderer, GPS tracker + Stop detection, multi-stop routing, driving navigation view, place-category browsing, and a timeline of visited places. Lifted out of Cloud SuperApp's libs:maps into its own focused app. Build via Nix devShell, one APK out.",
  "category": "android",
  "build": {
    "type": "gradle",
    "entry": "build.sh"
  },
  "android": {
    "application_id": "com.diegonmarcos.cloudnav",
    "compile_sdk": 35,
    "min_sdk": 26,
    "target_sdk": 34,
    "version_code": 1,
    "version_name": "0.1.0-dev",
    "_doc_abi_filters": "arm64-v8a only — MapLibre Native ships ~15-18MB of .so per ABI. Every Samsung Galaxy from S8 + every modern Pixel is arm64. Add armeabi-v7a/x86_64 here for 32-bit/emulator support; no Kotlin/gradle edits needed.",
    "abi_filters": [
      "arm64-v8a"
    ]
  },
  "emulator": {
    "_doc": "build.sh emulator boots an arm64 AVD for full-fidelity testing of the arm64-v8a APK. ABI/API must match flake.nix. avd_name created idempotently from system_image.",
    "avd_name": "cloudnav-arm64",
    "system_image": "system-images;android-34;google_apis;arm64-v8a",
    "device": "pixel_6",
    "boot_args": [
      "-no-snapshot-save",
      "-gpu",
      "swiftshader_indirect"
    ]
  },
  "toolchain": {
    "_doc": "Pinned for reproducibility — all derived in flake.nix. Bump here, rebuild devShell.",
    "agp": "8.7.3",
    "gradle": "8.10.2",
    "kotlin": "1.9.24",
    "jdk": "17"
  },
  "modules": {
    "_doc": "Single source of truth for the Gradle module graph. settings.gradle iterates this list. Adding a new feature module = one entry here + mkdir + minimal build.gradle.",
    "app": {
      "type": "application",
      "depends_on": [
        "libs:core",
        "libs:maps"
      ]
    },
    "libs:core": {
      "type": "library"
    },
    "libs:maps": {
      "type": "library"
    }
  },
  "ui": {
    "_doc_nav_tabs": "Bottom navigation tabs. Order = display order. id maps to a Fragment in MainActivity.fragmentForTab(); icon maps to R.drawable.ic_nav_<icon>.",
    "nav_tabs": [
