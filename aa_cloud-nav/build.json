  "release": {
    "_doc": "Data-driven publish targets. build.sh oras-push + gh-release read this block; the GHA workflow (1_workflows/src/cicd/ship-cloud-nav.yml) invokes those engine commands. release.auto_update + variants[].update_tag feed libs:updater (the in-app self-updater on Configs → Update).",
    "artifact": {
      "debug": "Cloud-Nav.apk",
      "release": "Cloud-Nav-release.apk"
    },
    "_doc_variants": "Per-ABI build variants — CI runs one matrix job per variant. arm64 is the DEFAULT (engine behaves as before when CLOUDNAV_VARIANT is unset). x86_64 is the Waydroid / desktop-emulator artifact, published to the SAME rolling 'latest' GH release under a distinct filename and to GHCR under tag suffix -x86_64. Engine reads each variant's abis (→ CLOUDNAV_ABIS), artifact_debug, gh_asset, ghcr_tag_suffix. Add an ABI = append a variant + the matrix entry.",
    "variants": [
      {
        "id": "arm64",
        "abis": [
          "arm64-v8a"
        ],
        "supported_abis": [
          "arm64-v8a",
          "armeabi-v7a"
        ],
        "artifact_debug": "Cloud-Nav.apk",
        "gh_asset": "Cloud-Nav.apk",
        "ghcr_tag_suffix": "",
        "update_tag": "latest"
      },
      {
        "id": "x86_64",
        "abis": [
          "x86_64"
        ],
        "supported_abis": [
          "x86_64",
          "x86"
        ],
        "artifact_debug": "Cloud-Nav-x86_64.apk",
        "gh_asset": "Cloud-Nav-x86_64.apk",
        "ghcr_tag_suffix": "-x86_64",
        "update_tag": "latest-x86_64"
      }
    ],
    "auto_update": {
      "_doc": "In-app updater config — read at gradle eval time into libs:updater BuildConfig, used at runtime by the Update tab in Configs. Same registry/namespace/image as release.ghcr. ABI-aware: arm64 pulls 'latest', x86_64 pulls 'latest-x86_64' (release.variants[].update_tag).",
      "enabled": true,
      "tag": "latest",
      "interval_hours": 6,
      "require_unmetered_network": false,
      "require_charging": false,
      "_doc_install": "Declared default for the runtime Auto-update toggle (Configs/About → Permissions). 'silent' → USER_ACTION_NOT_REQUIRED (no install prompt) once 'Install unknown apps' is granted; falls back to a prompt without it. 'prompt' → always USER_ACTION_REQUIRED.",
      "install_mode": "silent"
    },
    "ghcr": {
      "_doc": "ORAS push as an OCI artifact (APK blob, not a container). one :latest + per-sha + per-version tags; per-variant suffix -x86_64 for the x86 artifact.",
      "enabled": true,
      "registry": "ghcr.io",
      "namespace": "diegonmarcos",
      "image": "cloud-nav",
      "media_type": "application/vnd.android.package-archive",
      "tags": [
        "latest",
        "sha-{sha}",
        "v{version_name}"
      ]
    },
    "gh_release": {
      "_doc": "Rolling GH release named 'latest' (shared across the ea_cloud-* apps; each contributes distinctly-named APK assets), overwritten every main push so /releases/latest/download/Cloud-Nav.apk stays stable.",
      "enabled": true,
      "rolling_tag": "latest",
      "asset_name": "Cloud-Nav.apk",
      "draft": false,
      "prerelease": false,
      "generate_release_notes": false
    },
    "phone_install": {
      "default_tag": "latest",
      "target_dir": "~/storage/downloads",
      "asset_name": "Cloud-Nav.apk"
    }
  }
}
