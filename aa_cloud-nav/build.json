      "active": "valhalla_public",
      "providers": [
        {
          "id": "valhalla_public",
          "label": "Valhalla (FOSSGIS)",
          "host": "free-noauth",
          "endpoint": "https://valhalla1.openstreetmap.de/route"
        }
      ]
    },
    "_doc_travel_modes": "Route mode switcher (Routes tab) + the all-modes stats panel. engine=valhalla → real route via `costing`; engine=geodesic → straight-line distance ÷ avg_speed_kmh estimate. estimated=true flags approximations (bus = road approximation, not transit timetables). default_travel_mode = the one selected on open.",
    "default_travel_mode": "walking",
    "travel_modes": [
      { "id": "walking",   "label": "Walk",   "emoji": "🚶", "engine": "valhalla", "costing": "pedestrian", "estimated": false },
      { "id": "bike",      "label": "Bike",   "emoji": "🚲", "engine": "valhalla", "costing": "bicycle",    "estimated": false },
      { "id": "bus",       "label": "Bus",    "emoji": "🚌", "engine": "valhalla", "costing": "bus",        "estimated": true  },
      { "id": "car",       "label": "Car",    "emoji": "🚗", "engine": "valhalla", "costing": "auto",       "estimated": false },
      { "id": "boat",      "label": "Boat",   "emoji": "⛵", "engine": "geodesic", "avg_speed_kmh": 40,     "estimated": true  },
      { "id": "flying",    "label": "Flight", "emoji": "✈️", "engine": "geodesic", "avg_speed_kmh": 800,    "estimated": true  },
      { "id": "swimming",  "label": "Swim",   "emoji": "🏊", "engine": "geodesic", "avg_speed_kmh": 4,      "estimated": true  }
    ],
    "_doc_cockpit_modes": "Navigation-tab vehicle cockpit switcher. Distinct from travel_modes (routing costing) — this drives the live instrument PANEL + map camera on the Navigation tab. Per mode: accent (hex), style (map_styles key), zoom/tilt/follow_bearing (camera), speed_unit (kmh|kn|mph), alt_unit (m|ft), gauges (ordered instrument ids rendered left→right). Gauge ids: speed, heading (compass rose), attitude (artificial horizon), altitude (tape), vspeed, grade, avg, dist, eta, position, track. Add a mode = one entry here (data-driven; no Kotlin change).",
    "default_cockpit_mode": "car",
    "cockpit_modes": [
      { "id": "bike",     "label": "Bike",     "emoji": "🚲", "accent": "#34C759", "style": "light",     "zoom": 17.0, "tilt": 0.0,  "follow_bearing": true,  "speed_unit": "kmh", "alt_unit": "m",  "gauges": [ "speed", "avg", "grade", "heading" ] },
      { "id": "car",      "label": "Car",      "emoji": "🚗", "accent": "#4DA3FF", "style": "dark",      "zoom": 18.0, "tilt": 55.0, "follow_bearing": true,  "speed_unit": "kmh", "alt_unit": "m",  "gauges": [ "speed", "heading", "dist", "eta" ] },
      { "id": "boat",     "label": "Boat",     "emoji": "⛵", "accent": "#00C2C7", "style": "satellite", "zoom": 13.0, "tilt": 0.0,  "follow_bearing": false, "speed_unit": "kn",  "alt_unit": "m",  "gauges": [ "speed", "heading", "dist", "position" ] },
      { "id": "airplane", "label": "Airplane", "emoji": "✈️", "accent": "#FFB020", "style": "satellite", "zoom": 10.0, "tilt": 0.0,  "follow_bearing": false, "speed_unit": "kn",  "alt_unit": "ft", "gauges": [ "attitude", "altitude", "vspeed", "speed" ] }
    ],
    "maps_tracking": {
      "interval_moving_ms": 30000,
      "interval_stopped_ms": 300000,
      "moving_threshold_mps": 2,
      "stops_radius_m": 100,
      "stops_dwell_min": 2
    },
    "_doc_demo_stops": "Tester seed (Configs > Tracker > Load demo data) — a VERY rich 5-year historical trip (1987-1992), FIXED dates (not relative to today) so it can NEVER collide with real tracked data (the user has no real GPS history from that era). Every screen that reads Stops (MapsDailyFragment/MapsStopsFragment/MapsExploredFragment/MytripsDashboardFragment/MytripsStatsFragment) queries ALL-TIME (stopsBetween(0L, now)), not a rolling 'last N years' window — a bounded recent window would hide this deliberately old data. 14 days across 4 continents / 7 countries (Brazil, Argentina, Portugal, France, USA, Japan, UK), with FIVE cities each revisited 2-3x (Rio de Janeiro x3, São Paulo x2, Buenos Aires x2, Lisbon x2, Paris x2) — real material for the Explored tab's visit-history feature. Each stop's start_min/end_min = minutes from that day's UTC midnight. Seeded once (idempotent — Configs button is a no-op after the first tap; the historical range never changes).",
