        {
          "label": "Camera",
          "perm": "android.permission.CAMERA"
        },
        {
          "label": "Microphone",
          "perm": "android.permission.RECORD_AUDIO"
        },
        {
          "label": "Notifications",
          "perm": "android.permission.POST_NOTIFICATIONS"
        },
        {
          "label": "Location (fine)",
          "perm": "android.permission.ACCESS_FINE_LOCATION"
        },
        {
          "label": "Location (coarse)",
          "perm": "android.permission.ACCESS_COARSE_LOCATION"
        },
        {
          "label": "Nearby Devices",
          "perm": "android.permission.BLUETOOTH_SCAN"
        },
        {
          "label": "Bluetooth Connect",
          "perm": "android.permission.BLUETOOTH_CONNECT"
        },
        {
          "label": "Contacts",
          "perm": "android.permission.READ_CONTACTS"
        },
        {
          "label": "Music and Audio",
          "perm": "android.permission.READ_MEDIA_AUDIO"
        },
        {
          "label": "Photos and Videos (img)",
          "perm": "android.permission.READ_MEDIA_IMAGES"
        },
        {
          "label": "Photos and Videos (vid)",
          "perm": "android.permission.READ_MEDIA_VIDEO"
        },
        {
          "label": "SMS",
          "perm": "android.permission.READ_SMS"
        },
        {
          "label": "Phone",
          "perm": "android.permission.READ_PHONE_STATE"
        }
      ],
      "_doc_roles": "Single-holder RoleManager roles surfaced as Special-access rows on Configs/About → Permissions. These are NOT held by the SuperApp (it's a launcher with no dialer / call-screening service) — the holder is the Cloud-Comms phone fork (or Fossify Phone in the interim). The SuperApp cannot grant another app a role programmatically (createRequestRoleIntent only ever targets the calling app), so each row (a) reads the LIVE holder via RoleManager.getRoleHolders / TelecomManager.getDefaultDialerPackage and shows ✓ when the holder is one of `expected_holders`, and (b) the 'Set Default Apps' button deep-links to Settings.ACTION_MANAGE_DEFAULT_APPS_SETTINGS so the user picks Cloud-Comms there. `role` is the literal android.app.role.* constant passed straight to RoleManager. When our own fork ships, add its package to the relevant expected_holders[] — zero code change.",
      "roles": [
        {
          "label": "Default phone app",
          "role": "android.app.role.DIALER",
          "expected_holders": [
            "com.diegonmarcos.comms.dialer",
            "org.fossify.phone"
          ]
        },
        {
          "label": "Spam filter (call screening)",
          "role": "android.app.role.CALL_SCREENING",
          "expected_holders": [
            "com.diegonmarcos.comms.dialer",
            "org.fossify.phone"
          ]
        }
      ]
    }
  },
  "release": {
    "_doc": "Data-driven publish targets. build.sh oras-push + gh-release read this block; the GHA workflow (1_workflows/src/cicd/ship-cloud-nav.yml) invokes those engine commands. No libs:updater in Cloud Nav, so no auto_update/update_tag fields.",
    "artifact": {
      "debug": "Cloud-Nav.apk",
      "release": "Cloud-Nav-release.apk"
    },
    "_doc_variants": "Per-ABI build variants — CI runs one matrix job per variant. arm64 is the DEFAULT (engine behaves as before when CLOUDNAV_VARIANT is unset). x86_64 is the Waydroid / desktop-emulator artifact, published to the SAME rolling 'latest' GH release under a distinct filename and to GHCR under tag suffix -x86_64. Engine reads each variant's abis (→ CLOUDNAV_ABIS), artifact_debug, gh_asset, ghcr_tag_suffix. Add an ABI = append a variant + the matrix entry.",
    "variants": [
      {
        "id": "arm64",
        "abis": [
          "arm64-v8a"
        ],
        "artifact_debug": "Cloud-Nav.apk",
        "gh_asset": "Cloud-Nav.apk",
        "ghcr_tag_suffix": ""
      },
      {
        "id": "x86_64",
        "abis": [
          "x86_64"
        ],
        "artifact_debug": "Cloud-Nav-x86_64.apk",
        "gh_asset": "Cloud-Nav-x86_64.apk",
        "ghcr_tag_suffix": "-x86_64"
      }
    ],
    "ghcr": {
      "_doc": "ORAS push as an OCI artifact (APK blob, not a container). one :latest + per-sha + per-version tags; per-variant suffix -x86_64 for the x86 artifact.",
      "enabled": true,
      "registry": "ghcr.io",
      "namespace": "diegonmarcos",
      "image": "cloud-nav",
      "media_type": "application/vnd.android.package-archive",
      "tags": [
        "latest",
        "sha-{sha}",
        "v{version_name}"
      ]
    },
    "gh_release": {
      "_doc": "Rolling GH release named 'latest' (shared across the ea_cloud-* apps; each contributes distinctly-named APK assets), overwritten every main push so /releases/latest/download/Cloud-Nav.apk stays stable.",
      "enabled": true,
      "rolling_tag": "latest",
      "asset_name": "Cloud-Nav.apk",
      "draft": false,
      "prerelease": false,
      "generate_release_notes": false
    },
    "phone_install": {
      "default_tag": "latest",
      "target_dir": "~/storage/downloads",
      "asset_name": "Cloud-Nav.apk"
    }
  }
}
