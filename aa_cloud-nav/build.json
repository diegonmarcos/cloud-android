    "_doc_search_cache": "On-device cache for forward-search + POI lookups (NOT reverse-geocode, which never expires). New bars/shops appear slowly and the public Nominatim/Overpass endpoints are fair-use, so results for the same query/area are reused for ttl_days. Stored in the maps.db places_cache table keyed fwd:/poi:. Consumed by MapsProviderClient (baked UI_SEARCH_CACHE_TTL_DAYS).",
    "search_cache": {
      "ttl_days": 30
    },
    "_doc_search_choices": "How many forward-search candidates the search bar offers the user to pick from (Routes/Navigation show a chooser instead of auto-picking the first hit).",
    "search_choices": 3,
    "_doc_search_scopes": "Radius-scope islands shown when the Places search bar is focused. radius_km bounds the forward search around the user (0 = worldwide). default_search_scope = the one pre-selected.",
