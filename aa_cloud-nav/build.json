    "profile_default": {
      "name": "Diego Coelho Marcos",
      "email": "me@diegonmarcos.com",
      "initials": "DCM",
      "company": "LEAFY",
      "location": "Berlin/DE",
      "website": "linktree.diegonmarcos.com",
      "titles": "| Product Engineering  💾 | Venture Capital n' Portfolio Management 🎩 | Civil Structural Engineer B.Sc. 🏗️ | Brazilian/Spanish @BERlin.de 🏛️ |",
      "_doc_repos": "Repo URLs + the consolidated cloud-data config reference, surfaced read-only in Configs/About → Profile. Data-driven (no Kotlin hardcoding) — baked via UI_PROFILE_REPOS_B64 / UI_CONSOLIDATED_CONFIG.",
      "repos": [
        {
          "label": "unix",
          "url": "https://github.com/diegonmarcos/unix"
        },
        {
          "label": "cloud",
          "url": "https://github.com/diegonmarcos/cloud"
        },
        {
          "label": "front",
          "url": "https://github.com/diegonmarcos/diegonmarcos.github.io"
        },
        {
          "label": "vault",
          "url": "https://github.com/diegonmarcos/vault"
        }
      ],
      "consolidated_config": "cloud/2_configs/dist/_cloud-data-consolidated.json → baked into the app as data/mesh.json (BuildConfig.MESH_JSON_B64), the full wg-mesh/v1 node + peer + transport snapshot"
    },
