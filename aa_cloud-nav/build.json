{
  "name": "cloud-nav",
  "description": "Diego's Cloud Nav — dedicated maps/navigation/tracker Android app. Single APK, gradle multi-module (app/ Google-Maps-style shell + libs/{core,maps}). MapLibre Native renderer, GPS tracker + Stop detection, multi-stop routing, driving navigation view, place-category browsing, and a timeline of visited places. Lifted out of Cloud SuperApp's libs:maps into its own focused app. Build via Nix devShell, one APK out.",
  "category": "android",
  "build": {
    "type": "gradle",
    "entry": "build.sh"
  },
  "android": {
    "application_id": "com.diegonmarcos.cloudnav",
    "compile_sdk": 35,
    "min_sdk": 26,
    "target_sdk": 34,
    "version_code": 1,
    "version_name": "0.1.0-dev",
    "_doc_abi_filters": "arm64-v8a only — MapLibre Native ships ~15-18MB of .so per ABI. Every Samsung Galaxy from S8 + every modern Pixel is arm64. Add armeabi-v7a/x86_64 here for 32-bit/emulator support; no Kotlin/gradle edits needed.",
    "abi_filters": [
      "arm64-v8a"
    ]
  },
  "signing": {
    "_doc": "ONE shared Cloud-constellation signing key for ALL Android apps (Cloud-Comms hub+forks, Cloud-Nav, Cloud-IDE, Cloud-SuperApp). The SAME key signs every app so cross-app signature-IPC + the in-app fleet updater never hit a signature mismatch. KEY LOCATION (raw credential + sops passwords live ONLY in the vault repo): A0_keys/providers/android/release.jks (OU=Cloud Constellation) + A0_keys/providers/android/signing.secrets.yaml. build.sh::_resolve_signing resolves $VAULT_DIR (default ~/git/vault) + sops-decrypts the passwords, exporting ANDROID_KEYSTORE_FILE/ANDROID_KEYSTORE_PASSWORD/ANDROID_KEY_ALIAS/ANDROID_KEY_PASSWORD which the gradle signingConfig reads. CI does the same via a vault checkout + the SOPS_AGE_KEY secret. THERE IS NO FALLBACK: if the key is unavailable the build FAILS LOUD telling you to use the one shared key — it never generates or substitutes a random/legacy key.",
    "vault_keystore": "A0_keys/providers/android/release.jks",
    "vault_secrets": "A0_keys/providers/android/signing.secrets.yaml"
  },
  "diagnostics": {
    "_doc": "On-device DevControlServer diagnostics → cloud sink + local download. Baked into BuildConfig.LOG_SINK_URL / LOG_SINK_STREAM by app/build.gradle. log_sink_url is our OpenObserve (the Loki-equivalent log store on oci-apps) ingest, reached via the PUBLIC first-party analytics collector so NO credential is embedded in the public APK (the collector relays to openobserve server-side). '{stream}' in the url is replaced with log_sink_stream at runtime. EMPTY url = cloud push disabled (the 'Download logs' action still works fully); set it to the confirmed collector ingest path to enable one-tap 'Send logs to cloud'. Data-driven: change here, every app rebuild picks it up — never hardcode in Kotlin.",
    "log_sink_url": "https://api.diegonmarcos.com/pub/analytics/openobserve",
    "log_sink_stream": "cloud-nav",
    "enabled": true
  },
  "emulator": {
    "_doc": "build.sh emulator boots an arm64 AVD for full-fidelity testing of the arm64-v8a APK. ABI/API must match flake.nix. avd_name created idempotently from system_image.",
    "avd_name": "cloudnav-arm64",
    "system_image": "system-images;android-34;google_apis;arm64-v8a",
    "device": "pixel_6",
    "boot_args": [
      "-no-snapshot-save",
      "-gpu",
      "swiftshader_indirect"
    ]
  },
  "toolchain": {
    "_doc": "Pinned for reproducibility — all derived in flake.nix. Bump here, rebuild devShell.",
    "agp": "8.7.3",
    "gradle": "8.10.2",
    "kotlin": "1.9.24",
    "jdk": "17"
  },
  "modules": {
    "_doc": "Single source of truth for the Gradle module graph. settings.gradle iterates this list. Adding a new feature module = one entry here + mkdir + minimal build.gradle.",
    "app": {
      "type": "application",
      "depends_on": [
        "libs:core",
        "libs:maps",
        "libs:updater"
      ]
    },
    "libs:core": {
      "type": "library"
    },
    "libs:maps": {
      "type": "library"
    },
    "libs:updater": {
      "type": "library"
    }
  },
