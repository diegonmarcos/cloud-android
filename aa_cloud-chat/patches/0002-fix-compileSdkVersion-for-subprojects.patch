From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: cloud-comms-engine <engine@diegonmarcos.com>
Date: Fri, 25 Jul 2026 10:00:00 +0000
Subject: [PATCH] fix: force compileSdkVersion/buildToolsVersion on all subprojects

Some RN library modules (e.g. voximplant_react-native-foreground-service)
hardcode a compileSdkVersion < 30, which breaks compilation with Java 9+
source. Use pluginManager.withPlugin (lazy, no afterEvaluate) to inherit
root values without triggering "Cannot run afterEvaluate when project is
already evaluated" in Gradle 8+.
---
 android/build.gradle | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/android/build.gradle b/android/build.gradle
index d9e7bb120..b3f4d8f27 100644
--- a/android/build.gradle
+++ b/android/build.gradle
@@ -47,3 +47,18 @@ apply plugin: "com.facebook.react.rootproject"
 dependencyLocking {
     lockAllConfigurations()
 }
+
+subprojects {
+    pluginManager.withPlugin("com.android.library") {
+        android {
+            compileSdkVersion rootProject.ext.compileSdkVersion
+            buildToolsVersion rootProject.ext.buildToolsVersion
+        }
+    }
+    pluginManager.withPlugin("com.android.application") {
+        android {
+            compileSdkVersion rootProject.ext.compileSdkVersion
+            buildToolsVersion rootProject.ext.buildToolsVersion
+        }
+    }
+}
